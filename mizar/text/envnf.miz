:: Sigma normal forms of lambda_EnvEps

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, FINSEQ_1,
      RELAT_1, FUNCT_1, ORDINAL1, CARD_1, ARYTM_3, XXREAL_0, NAT_1, TREES_1,
      TREES_2, TREES_3, TREES_4, LANG1, STRUCT_0, DTCONSTR, MCART_1, XTUPLE_0,
      FINSET_1, TDGROUP, FUNCOP_1, ARYTM_1, FUNCT_7, XREAL_0, XCMPLX_0,
      REWRITE1, PBOOLE, ENVSYN, ENVLEN, ENVNF, ENVCC, ENVSIG, ENVBETA;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1,
      TREES_2, TREES_3, TREES_4, DTCONSTR, FUNCOP_1, XREAL_0, PBOOLE,
      REWRITE1, ENVSYN, ENVLEN, ENVCC, ENVSIG, ENVBETA;
 constructors NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1,
      TREES_2, TREES_3, TREES_4, DTCONSTR, PARTFUN1, BINOP_1, SETWISEO,
      XREAL_0, FUNCOP_1, SUBSET_1, CARD_3, FINSEQOP, FINSEQ_4, FINSOP_1,
      PRE_POLY, FUNCT_1, RELAT_1, PBOOLE, REWRITE1, ENVSYN, ENVLEN, ENVCC,
      ENVSIG, ENVBETA;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, XTUPLE_0, VALUED_0, FUNCOP_1, XCMPLX_0,
      XXREAL_0, NUMBERS, MEMBERED, PBOOLE, REWRITE1, ENVSYN, ENVPEAK, ENVSIG;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, DTCONSTR, TREES_3, TREES_4, RELAT_1, FUNCT_1,
      FINSEQ_1, FUNCOP_1, SUBSET_1, REWRITE1, ENVSYN, ENVLEN;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, ZFMISC_1, FINSEQ_1, FINSEQ_2, FINSEQ_3,
      MCART_1, LANG1, ENUMSET1, TREES_1, TREES_3, TREES_4, DTCONSTR, XTUPLE_0,
      FUNCT_1, RELAT_1, FUNCOP_1, NAT_1, XCMPLX_1, SUBSET_1, FUNCT_2, XREAL_1,
      REWRITE1, XXREAL_0, ENVSYN, ENVLEN, ENVSIG, ENVPEAK;
 schemes DTCONSTR, NAT_1, ENVSYN;
begin :: Reducts stay inside the term set

theorem Th1:
  for V being non empty set, M being EnvEpsTerm of V, c being object
  st SigmaRed(V) reduces M,c holds c is EnvEpsTerm of V
proof
  let V be non empty set, M be EnvEpsTerm of V, c be object;
  set G = EnvEpsGram(V);
  assume A1: SigmaRed(V) reduces M,c;
  per cases;
  suppose M = c;
    hence thesis;
  end;
  suppose M <> c;
    then c in field SigmaRed(V) by A1,REWRITE1:18;
    then B1: c in dom SigmaRed(V) \/ rng SigmaRed(V) by RELAT_1:def 6;
    B2: SigmaRed(V) c= [:TS G, TS G:];
    per cases by B1,XBOOLE_0:def 3;
    suppose c in dom SigmaRed(V);
      then consider y being object such that
      C1: [c,y] in SigmaRed(V) by XTUPLE_0:def 12;
      [c,y] in [:TS G, TS G:] by B2,C1;
      hence thesis by ZFMISC_1:87;
    end;
    suppose c in rng SigmaRed(V);
      then consider y being object such that
      C1: [y,c] in SigmaRed(V) by XTUPLE_0:def 13;
      [y,c] in [:TS G, TS G:] by B2,C1;
      hence thesis by ZFMISC_1:87;
    end;
  end;
end;

theorem Th2:
  for V being non empty set, M being EnvEpsTerm of V holds
  ( M is_a_normal_form_wrt SigmaRed(V) iff
    not ex N being EnvEpsTerm of V st [M,N] in SigmaRed(V) )
proof
  let V be non empty set, M be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  hereby
    assume M is_a_normal_form_wrt SigmaRed(V);
    hence not ex N being EnvEpsTerm of V st [M,N] in SigmaRed(V)
      by REWRITE1:def 5;
  end;
  assume A1: not ex N being EnvEpsTerm of V st [M,N] in SigmaRed(V);
  now
    given b being object such that B1: [M,b] in SigmaRed(V);
    SigmaRed(V) c= [:TS G, TS G:];
    then [M,b] in [:TS G, TS G:] by B1;
    then b in TS G by ZFMISC_1:87;
    then reconsider b1 = b as EnvEpsTerm of V;
    [M,b1] in SigmaRed(V) by B1;
    hence contradiction by A1;
  end;
  hence thesis by REWRITE1:def 5;
end;

begin :: The sigma normal form operator

definition
  let V be non empty set, M be EnvEpsTerm of V;
  func snf M -> EnvEpsTerm of V equals
  :Def1:
  nf(M, SigmaRed(V));
  coherence
  proof
    nf(M,SigmaRed(V)) is_a_normal_form_of M, SigmaRed(V) by REWRITE1:54;
    then SigmaRed(V) reduces M, nf(M,SigmaRed(V)) by REWRITE1:def 6;
    hence thesis by Th1;
  end;
end;

theorem Th3:
  for V being non empty set, M being EnvEpsTerm of V holds
  snf M is_a_normal_form_wrt SigmaRed(V) &
  SigmaRed(V) reduces M, snf M
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: nf(M,SigmaRed(V)) is_a_normal_form_of M, SigmaRed(V) by REWRITE1:54;
  thus snf M is_a_normal_form_wrt SigmaRed(V) by A1,Def1,REWRITE1:def 6;
  thus thesis by A1,Def1,REWRITE1:def 6;
end;

theorem Th4:
  for V being non empty set, M,N being EnvEpsTerm of V
  st N is_a_normal_form_wrt SigmaRed(V) & SigmaRed(V) reduces M,N
  holds snf M = N
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  assume A1: N is_a_normal_form_wrt SigmaRed(V) & SigmaRed(V) reduces M,N;
  then A2: N is_a_normal_form_of M, SigmaRed(V) by REWRITE1:def 6;
  A3: snf M is_a_normal_form_wrt SigmaRed(V) &
    SigmaRed(V) reduces M, snf M by Th3;
  then snf M is_a_normal_form_of M, SigmaRed(V) by REWRITE1:def 6;
  hence thesis by A2,REWRITE1:53;
end;

theorem Th5:
  for V being non empty set, M being EnvEpsTerm of V
  st M is_a_normal_form_wrt SigmaRed(V) holds snf M = M
proof
  let V be non empty set, M be EnvEpsTerm of V;
  assume A1: M is_a_normal_form_wrt SigmaRed(V);
  SigmaRed(V) reduces M,M by REWRITE1:12;
  hence thesis by A1,Th4;
end;

theorem Th6:
  for V being non empty set, M,N being EnvEpsTerm of V
  st SigmaRed(V) reduces M,N holds snf M = snf N
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  assume A1: SigmaRed(V) reduces M,N;
  A2: SigmaRed(V) reduces N, snf N by Th3;
  A3: SigmaRed(V) reduces M, snf N by A1,A2,REWRITE1:16;
  snf N is_a_normal_form_wrt SigmaRed(V) by Th3;
  hence thesis by A3,Th4;
end;

theorem Th7:
  for V being non empty set, M,N being EnvEpsTerm of V
  st [M,N] in SigmaRed(V) holds snf M = snf N
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  assume [M,N] in SigmaRed(V);
  then SigmaRed(V) reduces M,N by REWRITE1:15;
  hence thesis by Th6;
end;

theorem Th8:
  for V being non empty set, M being EnvEpsTerm of V holds snf (snf M) = snf M
proof
  let V be non empty set, M be EnvEpsTerm of V;
  snf M is_a_normal_form_wrt SigmaRed(V) by Th3;
  hence thesis by Th5;
end;

begin :: Which terms are sigma normal forms

theorem Th9:
  for V being non empty set, x being Element of V holds
  eVar x is_a_normal_form_wrt SigmaRed(V) &
  eId V is_a_normal_form_wrt SigmaRed(V)
proof
  let V be non empty set, x be Element of V;
  now
    given N being EnvEpsTerm of V such that A1: [eVar x,N] in SigmaRed(V);
    thus contradiction by A1,ENVSIG:27;
  end;
  hence eVar x is_a_normal_form_wrt SigmaRed(V) by Th2;
  now
    given N being EnvEpsTerm of V such that A1: [eId V,N] in SigmaRed(V);
    thus contradiction by A1,ENVSIG:28;
  end;
  hence thesis by Th2;
end;

theorem Th10:
  for V being non empty set, M being EnvEpsTerm of V, x being Element of V
  holds ( eLam(x,M) is_a_normal_form_wrt SigmaRed(V) iff
          M is_a_normal_form_wrt SigmaRed(V) )
proof
  let V be non empty set, M be EnvEpsTerm of V, x be Element of V;
  hereby
    assume A1: eLam(x,M) is_a_normal_form_wrt SigmaRed(V);
    now
      given N being EnvEpsTerm of V such that B1: [M,N] in SigmaRed(V);
      [eLam(x,M), eLam(x,N)] in SigmaRed(V) by B1,ENVSIG:20;
      hence contradiction by A1,Th2;
    end;
    hence M is_a_normal_form_wrt SigmaRed(V) by Th2;
  end;
  assume A1: M is_a_normal_form_wrt SigmaRed(V);
  now
    given W being EnvEpsTerm of V such that
    B1: [eLam(x,M),W] in SigmaRed(V);
    consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    B2: [M2,M3] in SigmaRed(V) & eLam(x,M) = eLam(x2,M2) & W = eLam(x2,M3)
      by B1,ENVSIG:29;
    M = M2 by B2,ENVSYN:11;
    hence contradiction by A1,B2,Th2;
  end;
  hence thesis by Th2;
end;

theorem Th11:
  for V being non empty set, M being EnvEpsTerm of V holds
  ( eEps M is_a_normal_form_wrt SigmaRed(V) iff
    M is_a_normal_form_wrt SigmaRed(V) )
proof
  let V be non empty set, M be EnvEpsTerm of V;
  hereby
    assume A1: eEps M is_a_normal_form_wrt SigmaRed(V);
    now
      given N being EnvEpsTerm of V such that B1: [M,N] in SigmaRed(V);
      [eEps M, eEps N] in SigmaRed(V) by B1,ENVSIG:25;
      hence contradiction by A1,Th2;
    end;
    hence M is_a_normal_form_wrt SigmaRed(V) by Th2;
  end;
  assume A1: M is_a_normal_form_wrt SigmaRed(V);
  now
    given W being EnvEpsTerm of V such that B1: [eEps M,W] in SigmaRed(V);
    consider M2,M3 being EnvEpsTerm of V such that
    B2: [M2,M3] in SigmaRed(V) & eEps M = eEps M2 & W = eEps M3
      by B1,ENVSIG:30;
    M = M2 by B2,ENVSYN:12;
    hence contradiction by A1,B2,Th2;
  end;
  hence thesis by Th2;
end;

theorem Th12:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  ( eApp(M,N) is_a_normal_form_wrt SigmaRed(V) iff
    M is_a_normal_form_wrt SigmaRed(V) &
    N is_a_normal_form_wrt SigmaRed(V) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  hereby
    assume A1: eApp(M,N) is_a_normal_form_wrt SigmaRed(V);
    now
      given K being EnvEpsTerm of V such that B1: [M,K] in SigmaRed(V);
      [eApp(M,N), eApp(K,N)] in SigmaRed(V) by B1,ENVSIG:18;
      hence contradiction by A1,Th2;
    end;
    hence M is_a_normal_form_wrt SigmaRed(V) by Th2;
    now
      given K being EnvEpsTerm of V such that B1: [N,K] in SigmaRed(V);
      [eApp(M,N), eApp(M,K)] in SigmaRed(V) by B1,ENVSIG:19;
      hence contradiction by A1,Th2;
    end;
    hence N is_a_normal_form_wrt SigmaRed(V) by Th2;
  end;
  assume A1: M is_a_normal_form_wrt SigmaRed(V) &
    N is_a_normal_form_wrt SigmaRed(V);
  now
    given W being EnvEpsTerm of V such that B1: [eApp(M,N),W] in SigmaRed(V);
    B2: ( ex P1,Q1,R1 being EnvEpsTerm of V st [P1,Q1] in SigmaRed(V) &
          eApp(M,N) = eApp(P1,R1) & W = eApp(Q1,R1) ) or
        ( ex P1,R1,S1 being EnvEpsTerm of V st [R1,S1] in SigmaRed(V) &
          eApp(M,N) = eApp(P1,R1) & W = eApp(P1,S1) ) by B1,ENVSIG:31;
    per cases by B2;
    suppose ex P1,Q1,R1 being EnvEpsTerm of V st [P1,Q1] in SigmaRed(V) &
        eApp(M,N) = eApp(P1,R1) & W = eApp(Q1,R1);
      then consider P1,Q1,R1 being EnvEpsTerm of V such that
      C1: [P1,Q1] in SigmaRed(V) & eApp(M,N) = eApp(P1,R1) &
        W = eApp(Q1,R1);
      M = P1 by C1,ENVSYN:13;
      hence contradiction by A1,C1,Th2;
    end;
    suppose ex P1,R1,S1 being EnvEpsTerm of V st [R1,S1] in SigmaRed(V) &
        eApp(M,N) = eApp(P1,R1) & W = eApp(P1,S1);
      then consider P1,R1,S1 being EnvEpsTerm of V such that
      C1: [R1,S1] in SigmaRed(V) & eApp(M,N) = eApp(P1,R1) &
        W = eApp(P1,S1);
      N = R1 by C1,ENVSYN:13;
      hence contradiction by A1,C1,Th2;
    end;
  end;
  hence thesis by Th2;
end;

theorem Th13:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
  holds ( eExt(M,x,N) is_a_normal_form_wrt SigmaRed(V) iff
          M is_a_normal_form_wrt SigmaRed(V) &
          N is_a_normal_form_wrt SigmaRed(V) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  hereby
    assume A1: eExt(M,x,N) is_a_normal_form_wrt SigmaRed(V);
    now
      given K being EnvEpsTerm of V such that B1: [M,K] in SigmaRed(V);
      [eExt(M,x,N), eExt(K,x,N)] in SigmaRed(V) by B1,ENVSIG:21;
      hence contradiction by A1,Th2;
    end;
    hence M is_a_normal_form_wrt SigmaRed(V) by Th2;
    now
      given K being EnvEpsTerm of V such that B1: [N,K] in SigmaRed(V);
      [eExt(M,x,N), eExt(M,x,K)] in SigmaRed(V) by B1,ENVSIG:22;
      hence contradiction by A1,Th2;
    end;
    hence N is_a_normal_form_wrt SigmaRed(V) by Th2;
  end;
  assume A1: M is_a_normal_form_wrt SigmaRed(V) &
    N is_a_normal_form_wrt SigmaRed(V);
  now
    given W being EnvEpsTerm of V such that
    B1: [eExt(M,x,N),W] in SigmaRed(V);
    B2: ( ex P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V st
          [P1,Q1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
          W = eExt(Q1,y1,R1) ) or
        ( ex P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V st
          [R1,S1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
          W = eExt(P1,y1,S1) ) by B1,ENVSIG:33;
    per cases by B2;
    suppose ex P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V st
        [P1,Q1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
        W = eExt(Q1,y1,R1);
      then consider P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V
      such that
      C1: [P1,Q1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
        W = eExt(Q1,y1,R1);
      M = P1 by C1,ENVSYN:15;
      hence contradiction by A1,C1,Th2;
    end;
    suppose ex P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V st
        [R1,S1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
        W = eExt(P1,y1,S1);
      then consider P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V
      such that
      C1: [R1,S1] in SigmaRed(V) & eExt(M,x,N) = eExt(P1,y1,R1) &
        W = eExt(P1,y1,S1);
      N = R1 by C1,ENVSYN:15;
      hence contradiction by A1,C1,Th2;
    end;
  end;
  hence thesis by Th2;
end;

theorem Th14:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  ( eComp(M,N) is_a_normal_form_wrt SigmaRed(V) iff
    ( M is_a_normal_form_wrt SigmaRed(V) &
      N is_a_normal_form_wrt SigmaRed(V) & N <> eId V &
      ( ( ex y being Element of V, U being EnvEpsTerm of V st
          M = eLam(y,U) ) or
        ( ( ex y being Element of V st M = eVar y ) &
          not ex P,Q being EnvEpsTerm of V, z being Element of V st
            N = eExt(P,z,Q) ) ) ) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  hereby
    assume A1: eComp(M,N) is_a_normal_form_wrt SigmaRed(V);
    now
      given K being EnvEpsTerm of V such that B1: [M,K] in SigmaRed(V);
      [eComp(M,N), eComp(K,N)] in SigmaRed(V) by B1,ENVSIG:23;
      hence contradiction by A1,Th2;
    end;
    hence M is_a_normal_form_wrt SigmaRed(V) by Th2;
    now
      given K being EnvEpsTerm of V such that B1: [N,K] in SigmaRed(V);
      [eComp(M,N), eComp(M,K)] in SigmaRed(V) by B1,ENVSIG:24;
      hence contradiction by A1,Th2;
    end;
    hence N is_a_normal_form_wrt SigmaRed(V) by Th2;
    now
      assume B1: N = eId V;
      [eComp(M,eId V), M] in SigmaRed(V) by ENVSIG:12;
      hence contradiction by A1,B1,Th2;
    end;
    hence N <> eId V;
    thus ( ex y being Element of V, U being EnvEpsTerm of V st
           M = eLam(y,U) ) or
         ( ( ex y being Element of V st M = eVar y ) &
           not ex P,Q being EnvEpsTerm of V, z being Element of V st
             N = eExt(P,z,Q) )
    proof
      per cases by ENVSYN:17;
      suppose ex v being Element of V st M = eVar v;
        then consider v being Element of V such that C1: M = eVar v;
        now
          given P,Q being EnvEpsTerm of V, z being Element of V such that
          C2: N = eExt(P,z,Q);
          per cases;
          suppose C3: v = z;
            [eComp(eVar v, eExt(P,v,Q)), P] in SigmaRed(V) by ENVSIG:14;
            hence contradiction by A1,C1,C2,C3,Th2;
          end;
          suppose C3: v <> z;
            [eComp(eVar v, eExt(P,z,Q)), eComp(eVar v, Q)] in SigmaRed(V)
              by C3,ENVSIG:15;
            hence contradiction by A1,C1,C2,Th2;
          end;
        end;
        hence thesis by C1;
      end;
      suppose C1: M = eId V;
        [eComp(eId V,N), N] in SigmaRed(V) by ENVSIG:11;
        hence thesis by A1,C1,Th2;
      end;
      suppose ex v being Element of V, A being EnvEpsTerm of V st
          M = eLam(v,A);
        hence thesis;
      end;
      suppose ex A being EnvEpsTerm of V st M = eEps A;
        then consider A being EnvEpsTerm of V such that C1: M = eEps A;
        [eComp(eEps A,N), eEps A] in SigmaRed(V) by ENVSIG:17;
        hence thesis by A1,C1,Th2;
      end;
      suppose ex A,B being EnvEpsTerm of V st M = eApp(A,B);
        then consider A,B being EnvEpsTerm of V such that C1: M = eApp(A,B);
        [eComp(eApp(A,B),N), eApp(eComp(A,N),eComp(B,N))] in SigmaRed(V)
          by ENVSIG:16;
        hence thesis by A1,C1,Th2;
      end;
      suppose ex A,B being EnvEpsTerm of V st M = eComp(A,B);
        then consider A,B being EnvEpsTerm of V such that C1: M = eComp(A,B);
        [eComp(eComp(A,B),N), eComp(A,eComp(B,N))] in SigmaRed(V)
          by ENVSIG:10;
        hence thesis by A1,C1,Th2;
      end;
      suppose ex A,B being EnvEpsTerm of V, v being Element of V st
          M = eExt(A,v,B);
        then consider A,B being EnvEpsTerm of V, v being Element of V
        such that C1: M = eExt(A,v,B);
        [eComp(eExt(A,v,B),N), eExt(eComp(A,N),v,eComp(B,N))] in SigmaRed(V)
          by ENVSIG:13;
        hence thesis by A1,C1,Th2;
      end;
    end;
  end;
  assume that A1: M is_a_normal_form_wrt SigmaRed(V) and
  A2: N is_a_normal_form_wrt SigmaRed(V) and
  A3: N <> eId V and
  A4: ( ex y being Element of V, U being EnvEpsTerm of V st M = eLam(y,U) ) or
      ( ( ex y being Element of V st M = eVar y ) &
        not ex P,Q being EnvEpsTerm of V, z being Element of V st
          N = eExt(P,z,Q) );
  now
    given W being EnvEpsTerm of V such that B1: [eComp(M,N),W] in SigmaRed(V);
    B2:
      ( ex M2,N2,L2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eComp(M2,N2),L2) &
        W = eComp(M2,eComp(N2,L2)) ) or
      ( ex M2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eId V,M2) & W = M2 ) or
      ( ex M2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(M2,eId V) & W = M2 ) or
      ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eComp(M,N) = eComp(eExt(L2,x2,M2),N2) &
        W = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
      ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eComp(M,N) = eComp(eVar x2, eExt(M2,x2,N2)) & W = M2 ) or
      ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st
        x2 <> y2 & eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) &
        W = eComp(eVar x2, N2) ) or
      ( ex M2,N2,L2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eApp(M2,N2),L2) &
        W = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
      ( ex M2,N2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eEps M2,N2) & W = eEps M2 ) or
      ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & W = eComp(M3,N2) ) or
      ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & W = eComp(M2,N3) ) by B1,ENVSIG:32;
    per cases by B2;
    suppose ex M2,N2,L2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eComp(M2,N2),L2) & W = eComp(M2,eComp(N2,L2));
      then consider M2,N2,L2 being EnvEpsTerm of V such that
      C1: eComp(M,N) = eComp(eComp(M2,N2),L2) & W = eComp(M2,eComp(N2,L2));
      C2: M = eComp(M2,N2) by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eId V,M2) & W = M2;
      then consider M2 being EnvEpsTerm of V such that
      C1: eComp(M,N) = eComp(eId V,M2) & W = M2;
      C2: M = eId V by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(M2,eId V) & W = M2;
      then consider M2 being EnvEpsTerm of V such that
      C1: eComp(M,N) = eComp(M2,eId V) & W = M2;
      thus contradiction by A3,C1,ENVSYN:14;
    end;
    suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eComp(M,N) = eComp(eExt(L2,x2,M2),N2) &
        W = eExt(eComp(L2,N2),x2,eComp(M2,N2));
      then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V
      such that
      C1: eComp(M,N) = eComp(eExt(L2,x2,M2),N2) &
        W = eExt(eComp(L2,N2),x2,eComp(M2,N2));
      C2: M = eExt(L2,x2,M2) by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eComp(M,N) = eComp(eVar x2, eExt(M2,x2,N2)) & W = M2;
      then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V
      such that
      C1: eComp(M,N) = eComp(eVar x2, eExt(M2,x2,N2)) & W = M2;
      C2: M = eVar x2 & N = eExt(M2,x2,N2) by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st
        x2 <> y2 & eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) &
        W = eComp(eVar x2, N2);
      then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V
      such that
      C1: x2 <> y2 & eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) &
        W = eComp(eVar x2, N2);
      C2: M = eVar x2 & N = eExt(M2,y2,N2) by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2,N2,L2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eApp(M2,N2),L2) &
        W = eApp(eComp(M2,L2),eComp(N2,L2));
      then consider M2,N2,L2 being EnvEpsTerm of V such that
      C1: eComp(M,N) = eComp(eApp(M2,N2),L2) &
        W = eApp(eComp(M2,L2),eComp(N2,L2));
      C2: M = eApp(M2,N2) by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2,N2 being EnvEpsTerm of V st
        eComp(M,N) = eComp(eEps M2,N2) & W = eEps M2;
      then consider M2,N2 being EnvEpsTerm of V such that
      C1: eComp(M,N) = eComp(eEps M2,N2) & W = eEps M2;
      C2: M = eEps M2 by C1,ENVSYN:14;
      thus contradiction by A4,C2,ENVSYN:20;
    end;
    suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & W = eComp(M3,N2);
      then consider M2,M3,N2 being EnvEpsTerm of V such that
      C1: [M2,M3] in SigmaRed(V) & eComp(M,N) = eComp(M2,N2) &
        W = eComp(M3,N2);
      M = M2 by C1,ENVSYN:14;
      hence contradiction by A1,C1,Th2;
    end;
    suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & W = eComp(M2,N3);
      then consider M2,N2,N3 being EnvEpsTerm of V such that
      C1: [N2,N3] in SigmaRed(V) & eComp(M,N) = eComp(M2,N2) &
        W = eComp(M2,N3);
      N = N2 by C1,ENVSYN:14;
      hence contradiction by A2,C1,Th2;
    end;
  end;
  hence thesis by Th2;
end;

begin :: Computing the normal form constructor by constructor

theorem Th15:
  for V being non empty set, M being EnvEpsTerm of V, x being Element of V
  holds snf (eLam(x,M)) = eLam(x, snf M)
proof
  let V be non empty set, M be EnvEpsTerm of V, x be Element of V;
  A1: SigmaRed(V) reduces M, snf M by Th3;
  A2: SigmaRed(V) reduces eLam(x,M), eLam(x, snf M) by A1,ENVSIG:36;
  snf M is_a_normal_form_wrt SigmaRed(V) by Th3;
  then eLam(x, snf M) is_a_normal_form_wrt SigmaRed(V) by Th10;
  hence thesis by A2,Th4;
end;

theorem Th16:
  for V being non empty set, M being EnvEpsTerm of V
  holds snf (eEps M) = eEps (snf M)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: SigmaRed(V) reduces M, snf M by Th3;
  A2: SigmaRed(V) reduces eEps M, eEps (snf M) by A1,ENVSIG:41;
  snf M is_a_normal_form_wrt SigmaRed(V) by Th3;
  then eEps (snf M) is_a_normal_form_wrt SigmaRed(V) by Th11;
  hence thesis by A2,Th4;
end;

theorem Th17:
  for V being non empty set, M,N being EnvEpsTerm of V
  holds snf (eApp(M,N)) = eApp(snf M, snf N)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  A1: SigmaRed(V) reduces M, snf M & SigmaRed(V) reduces N, snf N by Th3;
  A2: SigmaRed(V) reduces eApp(M,N), eApp(snf M, N) by A1,ENVSIG:34;
  SigmaRed(V) reduces eApp(snf M,N), eApp(snf M, snf N) by A1,ENVSIG:35;
  then A3: SigmaRed(V) reduces eApp(M,N), eApp(snf M, snf N)
    by A2,REWRITE1:16;
  snf M is_a_normal_form_wrt SigmaRed(V) &
    snf N is_a_normal_form_wrt SigmaRed(V) by Th3;
  then eApp(snf M, snf N) is_a_normal_form_wrt SigmaRed(V) by Th12;
  hence thesis by A3,Th4;
end;

theorem Th18:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
  holds snf (eExt(M,x,N)) = eExt(snf M, x, snf N)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  A1: SigmaRed(V) reduces M, snf M & SigmaRed(V) reduces N, snf N by Th3;
  A2: SigmaRed(V) reduces eExt(M,x,N), eExt(snf M, x, N) by A1,ENVSIG:37;
  SigmaRed(V) reduces eExt(snf M,x,N), eExt(snf M, x, snf N)
    by A1,ENVSIG:38;
  then A3: SigmaRed(V) reduces eExt(M,x,N), eExt(snf M, x, snf N)
    by A2,REWRITE1:16;
  snf M is_a_normal_form_wrt SigmaRed(V) &
    snf N is_a_normal_form_wrt SigmaRed(V) by Th3;
  then eExt(snf M, x, snf N) is_a_normal_form_wrt SigmaRed(V) by Th13;
  hence thesis by A3,Th4;
end;

theorem Th19:
  for V being non empty set, M,N being EnvEpsTerm of V
  holds snf (eComp(M,N)) = snf (eComp(snf M, snf N))
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  A1: SigmaRed(V) reduces M, snf M & SigmaRed(V) reduces N, snf N by Th3;
  A2: SigmaRed(V) reduces eComp(M,N), eComp(snf M, N) by A1,ENVSIG:39;
  SigmaRed(V) reduces eComp(snf M,N), eComp(snf M, snf N) by A1,ENVSIG:40;
  then SigmaRed(V) reduces eComp(M,N), eComp(snf M, snf N)
    by A2,REWRITE1:16;
  hence thesis by Th6;
end;
