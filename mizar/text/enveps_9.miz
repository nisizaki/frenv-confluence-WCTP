:: Confluence of beta-sigma reduction for lambda_EnvEps

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, FINSEQ_1,
      RELAT_1, FUNCT_1, ORDINAL1, CARD_1, ARYTM_3, XXREAL_0, NAT_1, TREES_1,
      TREES_2, TREES_3, TREES_4, LANG1, STRUCT_0, DTCONSTR, MCART_1, XTUPLE_0,
      FINSET_1, TDGROUP, FUNCOP_1, ARYTM_1, FUNCT_7, XREAL_0, XCMPLX_0,
      REWRITE1, PBOOLE, ENVEPS_1, ENVEPS_5, ENVEPS_6, ENVEPS_7, ENVEPS_9;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2, TREES_3,
      TREES_4, DTCONSTR, FUNCOP_1, XREAL_0, PBOOLE, REWRITE1, ENVEPS_1,
      ENVEPS_5, ENVEPS_6, ENVEPS_7;
 constructors NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, PARTFUN1, BINOP_1, SETWISEO, XREAL_0,
      FUNCOP_1, SUBSET_1, CARD_3, FINSEQOP, FINSEQ_4, FINSOP_1, PRE_POLY,
      FUNCT_1, RELAT_1, PBOOLE, REWRITE1, ENVEPS_1, ENVEPS_5, ENVEPS_6,
      ENVEPS_7;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, XTUPLE_0, VALUED_0, FUNCOP_1, XCMPLX_0,
      XXREAL_0, NUMBERS, MEMBERED, PBOOLE, REWRITE1, ENVEPS_1, ENVEPS_4;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, DTCONSTR, TREES_3, TREES_4, RELAT_1, FUNCT_1,
      FINSEQ_1, FUNCOP_1, SUBSET_1, REWRITE1, ENVEPS_1;
 theorems TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, RELAT_1, REWRITE1, NAT_1,
      XXREAL_0, FINSEQ_1, FUNCT_1, ENVEPS_1, ENVEPS_5, ENVEPS_6, ENVEPS_7,
      ENVEPS_8;
 schemes NAT_1, ENVEPS_7, ENVEPS_8;

begin :: Parallel reduction on sigma normal forms

reserve V for non empty set;

definition
  let V be non empty set;
  func SnfPar V -> Relation of TS(EnvEpsGram(V)) equals
  :Def1:
  { z where z is Element of [:TS(EnvEpsGram(V)),TS(EnvEpsGram(V)):] :
      ex A,B,S being EnvEpsTerm of V st z = [A,B] &
        A is_a_normal_form_wrt SigmaRed(V) &
        [A,S] in ParRed(V) & B = snf S };
  coherence
  proof
    set G = EnvEpsGram(V);
    set D = [:TS G, TS G:];
    set S0 = { z where z is Element of D :
      ex A,B,S being EnvEpsTerm of V st z = [A,B] &
        A is_a_normal_form_wrt SigmaRed(V) &
        [A,S] in ParRed(V) & B = snf S };
    S0 c= D
    proof
      let u be object;
      assume u in S0;
      then ex z being Element of D st u = z &
        ex A,B,S being EnvEpsTerm of V st z = [A,B] &
          A is_a_normal_form_wrt SigmaRed(V) &
          [A,S] in ParRed(V) & B = snf S;
      hence thesis;
    end;
    hence thesis;
  end;
end;

theorem Th1:
  for A,B being EnvEpsTerm of V holds
  ( [A,B] in SnfPar V iff
    ( A is_a_normal_form_wrt SigmaRed(V) &
      ex S being EnvEpsTerm of V st [A,S] in ParRed(V) & B = snf S ) )
proof
  let A,B be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  hereby
    assume [A,B] in SnfPar V;
    then [A,B] in { z where z is Element of D :
      ex A2,B2,S2 being EnvEpsTerm of V st z = [A2,B2] &
        A2 is_a_normal_form_wrt SigmaRed(V) &
        [A2,S2] in ParRed(V) & B2 = snf S2 } by Def1;
    then consider z being Element of D such that
    B1: [A,B] = z and
    B2: ex A2,B2,S2 being EnvEpsTerm of V st z = [A2,B2] &
      A2 is_a_normal_form_wrt SigmaRed(V) &
      [A2,S2] in ParRed(V) & B2 = snf S2;
    consider A2,B2,S2 being EnvEpsTerm of V such that
    B3: z = [A2,B2] & A2 is_a_normal_form_wrt SigmaRed(V) &
      [A2,S2] in ParRed(V) & B2 = snf S2 by B2;
    B4: A = A2 & B = B2 by B1,B3,XTUPLE_0:1;
    thus A is_a_normal_form_wrt SigmaRed(V) &
      ex S being EnvEpsTerm of V st [A,S] in ParRed(V) & B = snf S by B3,B4;
  end;
  assume C1: A is_a_normal_form_wrt SigmaRed(V);
  given S being EnvEpsTerm of V such that
  C2: [A,S] in ParRed(V) & B = snf S;
  [A,B] in D by ZFMISC_1:87;
  then reconsider z = [A,B] as Element of D;
  ex A2,B2,S2 being EnvEpsTerm of V st z = [A2,B2] &
    A2 is_a_normal_form_wrt SigmaRed(V) &
    [A2,S2] in ParRed(V) & B2 = snf S2 by C1,C2;
  then z in { z2 where z2 is Element of D :
    ex A2,B2,S2 being EnvEpsTerm of V st z2 = [A2,B2] &
      A2 is_a_normal_form_wrt SigmaRed(V) &
      [A2,S2] in ParRed(V) & B2 = snf S2 };
  hence thesis by Def1;
end;

theorem Th2:
  for A being EnvEpsTerm of V st A is_a_normal_form_wrt SigmaRed(V)
  holds [A,A] in SnfPar V
proof
  let A be EnvEpsTerm of V;
  assume A1: A is_a_normal_form_wrt SigmaRed(V);
  A2: [A,A] in ParRed(V) by ENVEPS_7:4;
  A = snf A by A1,ENVEPS_5:5;
  hence thesis by A1,A2,Th1;
end;

registration
  let V be non empty set;
  cluster SnfPar V -> subcommutative;
  coherence
  proof
    set G = EnvEpsGram(V);
    let a,b,c be object;
    assume A1: [a,b] in SnfPar V & [a,c] in SnfPar V;
    SnfPar V c= [:TS G, TS G:];
    then [a,b] in [:TS G, TS G:] & [a,c] in [:TS G, TS G:] by A1;
    then a in TS G & b in TS G & c in TS G by ZFMISC_1:87;
    then reconsider a1 = a, b1 = b, c1 = c as EnvEpsTerm of V;
    A2: [a1,b1] in SnfPar V & [a1,c1] in SnfPar V by A1;
    then consider S1 being EnvEpsTerm of V such that
    A3: [a1,S1] in ParRed(V) & b1 = snf S1 by Th1;
    consider S2 being EnvEpsTerm of V such that
    A4: [a1,S2] in ParRed(V) & c1 = snf S2 by A2,Th1;
    consider W being EnvEpsTerm of V such that
    A5: [S1,W] in ParRed(V) & [S2,W] in ParRed(V) by A3,A4,ENVEPS_7:31;
    consider T1 being EnvEpsTerm of V such that
    A6: [snf S1, T1] in ParRed(V) & snf T1 = snf W by A5,ENVEPS_8:30;
    consider T2 being EnvEpsTerm of V such that
    A7: [snf S2, T2] in ParRed(V) & snf T2 = snf W by A5,ENVEPS_8:30;
    A8: b1 is_a_normal_form_wrt SigmaRed(V) &
      c1 is_a_normal_form_wrt SigmaRed(V) by A3,A4,ENVEPS_5:3;
    A9: [b1, snf W] in SnfPar V by A3,A6,A8,Th1;
    A10: [c1, snf W] in SnfPar V by A4,A7,A8,Th1;
    take snf W;
    thus thesis by A9,A10;
  end;
end;

theorem Th3:
  for V being non empty set holds SnfPar V is confluent;

begin :: From the normal form relation back to beta-sigma reduction

theorem Th4:
  for M,N being EnvEpsTerm of V st SigmaRed(V) reduces M,N
  holds BetaSigmaRed(V) reduces M,N
proof
  let M,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  A1: for a,b being object st [a,b] in SigmaRed(V)
    holds BetaSigmaRed(V) reduces a,b
  proof
    let a,b be object;
    assume B1: [a,b] in SigmaRed(V);
    SigmaRed(V) c= [:TS G, TS G:];
    then [a,b] in [:TS G, TS G:] by B1;
    then a in TS G & b in TS G by ZFMISC_1:87;
    then reconsider a1 = a, b1 = b as EnvEpsTerm of V;
    [a1,b1] in SigmaRed(V) by B1;
    then [a1,b1] in BetaSigmaRed(V) by ENVEPS_6:30;
    hence thesis by REWRITE1:15;
  end;
  for a,b being object st SigmaRed(V) reduces a,b
    holds BetaSigmaRed(V) reduces a,b from ENVEPS_7:sch 1(A1);
  hence thesis;
end;

theorem Th5:
  for M,N being EnvEpsTerm of V st BetaRed(V) reduces M,N
  holds BetaSigmaRed(V) reduces M,N
proof
  let M,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  A1: for a,b being object st [a,b] in BetaRed(V)
    holds BetaSigmaRed(V) reduces a,b
  proof
    let a,b be object;
    assume B1: [a,b] in BetaRed(V);
    BetaRed(V) c= [:TS G, TS G:];
    then [a,b] in [:TS G, TS G:] by B1;
    then a in TS G & b in TS G by ZFMISC_1:87;
    then reconsider a1 = a, b1 = b as EnvEpsTerm of V;
    [a1,b1] in BetaRed(V) by B1;
    then [a1,b1] in BetaSigmaRed(V) by ENVEPS_6:30;
    hence thesis by REWRITE1:15;
  end;
  for a,b being object st BetaRed(V) reduces a,b
    holds BetaSigmaRed(V) reduces a,b from ENVEPS_7:sch 1(A1);
  hence thesis;
end;

theorem Th6:
  for M being EnvEpsTerm of V holds BetaSigmaRed(V) reduces M, snf M
proof
  let M be EnvEpsTerm of V;
  SigmaRed(V) reduces M, snf M by ENVEPS_5:3;
  hence thesis by Th4;
end;

theorem Th7:
  for A,B being EnvEpsTerm of V st [A,B] in SnfPar V
  holds BetaSigmaRed(V) reduces A,B
proof
  let A,B be EnvEpsTerm of V;
  assume [A,B] in SnfPar V;
  then consider S being EnvEpsTerm of V such that
  A1: [A,S] in ParRed(V) & B = snf S by Th1;
  BetaRed(V) reduces A,S by A1,ENVEPS_7:21;
  then A2: BetaSigmaRed(V) reduces A,S by Th5;
  BetaSigmaRed(V) reduces S, snf S by Th6;
  hence thesis by A1,A2,REWRITE1:16;
end;

theorem Th8:
  for A,B being EnvEpsTerm of V st SnfPar V reduces A,B
  holds BetaSigmaRed(V) reduces A,B
proof
  let A,B be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  A1: for a,b being object st [a,b] in SnfPar V
    holds BetaSigmaRed(V) reduces a,b
  proof
    let a,b be object;
    assume B1: [a,b] in SnfPar V;
    SnfPar V c= [:TS G, TS G:];
    then [a,b] in [:TS G, TS G:] by B1;
    then a in TS G & b in TS G by ZFMISC_1:87;
    then reconsider a1 = a, b1 = b as EnvEpsTerm of V;
    [a1,b1] in SnfPar V by B1;
    hence thesis by Th7;
  end;
  for a,b being object st SnfPar V reduces a,b
    holds BetaSigmaRed(V) reduces a,b from ENVEPS_7:sch 1(A1);
  hence thesis;
end;

begin :: Projecting beta-sigma reduction onto normal forms

theorem Th9:
  for M,N being EnvEpsTerm of V st [M,N] in BetaSigmaRed(V)
  holds [snf M, snf N] in SnfPar V
proof
  let M,N be EnvEpsTerm of V;
  assume A1: [M,N] in BetaSigmaRed(V);
  A2: snf M is_a_normal_form_wrt SigmaRed(V) by ENVEPS_5:3;
  per cases by A1,ENVEPS_6:30;
  suppose B1: [M,N] in BetaRed(V);
    BetaRed(V) c= ParRed(V) by ENVEPS_7:20;
    then [M,N] in ParRed(V) by B1,TARSKI:def 3;
    then consider S being EnvEpsTerm of V such that
    B2: [snf M, S] in ParRed(V) & snf S = snf N by ENVEPS_8:30;
    thus thesis by A2,B2,Th1;
  end;
  suppose B1: [M,N] in SigmaRed(V);
    then snf M = snf N by ENVEPS_5:7;
    hence thesis by A2,Th2;
  end;
end;

theorem Th10:
  for M,N being EnvEpsTerm of V st BetaSigmaRed(V) reduces M,N
  holds SnfPar V reduces snf M, snf N
proof
  let M,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  defpred P[object] means ex A being EnvEpsTerm of V st A = $1 &
    SnfPar V reduces snf M, snf A;
  A1: for a,b being object st P[a] & [a,b] in BetaSigmaRed(V) holds P[b]
  proof
    let a,b be object;
    assume that B1: P[a] and B2: [a,b] in BetaSigmaRed(V);
    consider A being EnvEpsTerm of V such that
    B3: A = a & SnfPar V reduces snf M, snf A by B1;
    BetaSigmaRed(V) c= [:TS G, TS G:];
    then [a,b] in [:TS G, TS G:] by B2;
    then b in TS G by ZFMISC_1:87;
    then reconsider b1 = b as EnvEpsTerm of V;
    [A,b1] in BetaSigmaRed(V) by B2,B3;
    then [snf A, snf b1] in SnfPar V by Th9;
    then SnfPar V reduces snf A, snf b1 by REWRITE1:15;
    then SnfPar V reduces snf M, snf b1 by B3,REWRITE1:16;
    hence thesis;
  end;
  A2: for a,b being object st BetaSigmaRed(V) reduces a,b & P[a] holds P[b]
    from ENVEPS_8:sch 1(A1);
  assume A3: BetaSigmaRed(V) reduces M,N;
  SnfPar V reduces snf M, snf M by REWRITE1:12;
  then P[M];
  then P[N] by A2,A3;
  then consider A being EnvEpsTerm of V such that
  A4: A = N & SnfPar V reduces snf M, snf A;
  thus thesis by A4;
end;

begin :: Confluence of beta-sigma reduction

theorem Th11:
  for A being EnvEpsTerm of V, d being object
  for R being Relation of TS(EnvEpsGram(V))
  st R reduces A,d holds d in TS(EnvEpsGram(V))
proof
  let A be EnvEpsTerm of V;
  let d be object;
  let R be Relation of TS(EnvEpsGram(V));
  assume A1: R reduces A,d;
  per cases;
  suppose A = d;
    hence thesis;
  end;
  suppose A <> d;
    then d in field R by A1,REWRITE1:18;
    then A2: d in (dom R) \/ (rng R) by RELAT_1:def 6;
    per cases by A2,XBOOLE_0:def 3;
    suppose d in dom R;
      then consider y being object such that
      B1: [d,y] in R by XTUPLE_0:def 12;
      R c= [:TS(EnvEpsGram(V)), TS(EnvEpsGram(V)):];
      then [d,y] in [:TS(EnvEpsGram(V)), TS(EnvEpsGram(V)):] by B1;
      hence thesis by ZFMISC_1:87;
    end;
    suppose d in rng R;
      then consider y being object such that
      B1: [y,d] in R by XTUPLE_0:def 13;
      R c= [:TS(EnvEpsGram(V)), TS(EnvEpsGram(V)):];
      then [y,d] in [:TS(EnvEpsGram(V)), TS(EnvEpsGram(V)):] by B1;
      hence thesis by ZFMISC_1:87;
    end;
  end;
end;

theorem Th12:
  for M,N1,N2 being EnvEpsTerm of V
  st BetaSigmaRed(V) reduces M,N1 & BetaSigmaRed(V) reduces M,N2
  ex N being EnvEpsTerm of V st
    BetaSigmaRed(V) reduces N1,N & BetaSigmaRed(V) reduces N2,N
proof
  let M,N1,N2 be EnvEpsTerm of V;
  assume A1: BetaSigmaRed(V) reduces M,N1 & BetaSigmaRed(V) reduces M,N2;
  A2: SnfPar V reduces snf M, snf N1 & SnfPar V reduces snf M, snf N2
    by A1,Th10;
  snf N1, snf N2 are_divergent_wrt SnfPar V by A2,REWRITE1:def 8;
  then snf N1, snf N2 are_convergent_wrt SnfPar V by REWRITE1:def 22;
  then consider d being object such that
  A3: SnfPar V reduces snf N1, d & SnfPar V reduces snf N2, d
    by REWRITE1:def 7;
  d in TS(EnvEpsGram(V)) by A3,Th11;
  then reconsider d1 = d as EnvEpsTerm of V;
  A4: SnfPar V reduces snf N1, d1 & SnfPar V reduces snf N2, d1 by A3;
  A5: BetaSigmaRed(V) reduces snf N1, d1 &
    BetaSigmaRed(V) reduces snf N2, d1 by A4,Th8;
  A6: BetaSigmaRed(V) reduces N1, snf N1 &
    BetaSigmaRed(V) reduces N2, snf N2 by Th6;
  take d1;
  thus BetaSigmaRed(V) reduces N1, d1 by A5,A6,REWRITE1:16;
  thus BetaSigmaRed(V) reduces N2, d1 by A5,A6,REWRITE1:16;
end;

theorem Th13:
  for V being non empty set holds BetaSigmaRed(V) is confluent
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  let a,b be object;
  assume a,b are_divergent_wrt BetaSigmaRed(V);
  then consider c being object such that
  A1: BetaSigmaRed(V) reduces c,a & BetaSigmaRed(V) reduces c,b
    by REWRITE1:def 8;
  per cases;
  suppose B0: c in TS G;
    reconsider c1 = c as EnvEpsTerm of V by B0;
    B0a: BetaSigmaRed(V) reduces c1,a & BetaSigmaRed(V) reduces c1,b by A1;
    a in TS G by B0a,Th11;
    then reconsider a1 = a as EnvEpsTerm of V;
    b in TS G by B0a,Th11;
    then reconsider b1 = b as EnvEpsTerm of V;
    B1: BetaSigmaRed(V) reduces c1,a1 & BetaSigmaRed(V) reduces c1,b1 by A1;
    consider N being EnvEpsTerm of V such that
    B2: BetaSigmaRed(V) reduces a1,N & BetaSigmaRed(V) reduces b1,N
      by B1,Th12;
    thus thesis by B2,REWRITE1:def 7;
  end;
  suppose B0: not c in TS G;
    B1: not c in field BetaSigmaRed(V)
    proof
      assume c in field BetaSigmaRed(V);
      then C1: c in (dom BetaSigmaRed(V)) \/ (rng BetaSigmaRed(V))
        by RELAT_1:def 6;
      per cases by C1,XBOOLE_0:def 3;
      suppose c in dom BetaSigmaRed(V);
        then consider y being object such that
        D1: [c,y] in BetaSigmaRed(V) by XTUPLE_0:def 12;
        BetaSigmaRed(V) c= [:TS G, TS G:];
        then [c,y] in [:TS G, TS G:] by D1;
        hence contradiction by B0,ZFMISC_1:87;
      end;
      suppose c in rng BetaSigmaRed(V);
        then consider y being object such that
        D1: [y,c] in BetaSigmaRed(V) by XTUPLE_0:def 13;
        BetaSigmaRed(V) c= [:TS G, TS G:];
        then [y,c] in [:TS G, TS G:] by D1;
        hence contradiction by B0,ZFMISC_1:87;
      end;
    end;
    B2: c = a & c = b by A1,B1,REWRITE1:14;
    BetaSigmaRed(V) reduces a,a by REWRITE1:12;
    hence thesis by B2,REWRITE1:def 7;
  end;
end;
