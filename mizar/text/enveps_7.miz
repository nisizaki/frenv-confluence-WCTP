:: Parallel beta reduction of lambda_EnvEps

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, FINSEQ_1,
      RELAT_1, FUNCT_1, ORDINAL1, CARD_1, ARYTM_3, XXREAL_0, NAT_1, TREES_1,
      TREES_2, TREES_3, TREES_4, LANG1, STRUCT_0, DTCONSTR, MCART_1, XTUPLE_0,
      FINSET_1, TDGROUP, FUNCOP_1, ARYTM_1, FUNCT_7, XREAL_0, XCMPLX_0,
      REWRITE1, PBOOLE, ENVEPS_1, ENVEPS_5, ENVEPS_6, ENVEPS_7;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2, TREES_3,
      TREES_4, DTCONSTR, FUNCOP_1, XREAL_0, PBOOLE, REWRITE1, ENVEPS_1,
      ENVEPS_6;
 constructors NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, PARTFUN1, BINOP_1, SETWISEO, XREAL_0,
      FUNCOP_1, SUBSET_1, CARD_3, FINSEQOP, FINSEQ_4, FINSOP_1, PRE_POLY,
      FUNCT_1, RELAT_1, PBOOLE, REWRITE1, ENVEPS_1, ENVEPS_6;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, XTUPLE_0, VALUED_0, FUNCOP_1, XCMPLX_0,
      XXREAL_0, NUMBERS, MEMBERED, PBOOLE, REWRITE1, ENVEPS_1, ENVEPS_4;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, DTCONSTR, TREES_3, TREES_4, RELAT_1, FUNCT_1,
      FINSEQ_1, FUNCOP_1, SUBSET_1, REWRITE1, ENVEPS_1, ENVEPS_6;
 theorems TARSKI, ZFMISC_1, XTUPLE_0, REWRITE1, NAT_1, FINSEQ_1, FUNCT_1,
      XXREAL_0, ENVEPS_1, ENVEPS_6;
 schemes DTCONSTR, NAT_1, ENVEPS_1, ENVEPS_2;

begin :: Parallel beta reduction

definition
  let V be non empty set;
  let R be Relation of TS(EnvEpsGram(V));
  attr R is par-closed means
  :Def1:
  (for M being EnvEpsTerm of V holds
     [M, M] in R) &
  (for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in R holds
     [eLam(x,M), eLam(x,M1)] in R) &
  (for M,M1 being EnvEpsTerm of V st [M,M1] in R holds
     [eEps M, eEps M1] in R) &
  (for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R holds
     [eApp(M,N), eApp(M1,N1)] in R) &
  (for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V
     st [M,M1] in R & [N,N1] in R holds
     [eExt(M,x,N), eExt(M1,x,N1)] in R) &
  (for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R holds
     [eComp(M,N), eComp(M1,N1)] in R) &
  (for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V
     st [M,M1] in R & [N,N1] in R holds
     [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in R) &
  (for M,M1,N,N1,L,L1 being EnvEpsTerm of V, x being Element of V
     st [M,M1] in R & [N,N1] in R & [L,L1] in R holds
     [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in R) &
  (for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R holds
     [eApp(eEps M,N), eComp(M1,N1)] in R);
end;

registration
  let V be non empty set;
  cluster par-closed for Relation of TS(EnvEpsGram(V));
  existence
  proof
    set G = EnvEpsGram(V);
    A0: [:TS G, TS G:] c= [:TS G, TS G:];
    reconsider R = [:TS G, TS G:] as Relation of TS G by A0;
    take R;
    A1: for a,b being EnvEpsTerm of V holds [a,b] in R by ZFMISC_1:87;
    thus for M being EnvEpsTerm of V holds
      [M, M] in R by A1;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in R
      holds
      [eLam(x,M), eLam(x,M1)] in R by A1;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in R holds
      [eEps M, eEps M1] in R by A1;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R
      holds
      [eApp(M,N), eApp(M1,N1)] in R by A1;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in R & [N,N1] in R holds
      [eExt(M,x,N), eExt(M1,x,N1)] in R by A1;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R
      holds
      [eComp(M,N), eComp(M1,N1)] in R by A1;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in R & [N,N1] in R holds
      [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in R by A1;
    thus for M,M1,N,N1,L,L1 being EnvEpsTerm of V, x being Element of V st
      [M,M1] in R & [N,N1] in R & [L,L1] in R holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in R by A1;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in R & [N,N1] in R
      holds
      [eApp(eEps M,N), eComp(M1,N1)] in R by A1;
  end;
end;

definition
  let V be non empty set;
  func ParRed(V) -> Relation of TS(EnvEpsGram(V)) equals
  :Def2:
  { z where z is Element of [:TS(EnvEpsGram(V)),TS(EnvEpsGram(V)):] :
      for R being Relation of TS(EnvEpsGram(V)) st R is par-closed
        holds z in R };
  coherence
  proof
    set G = EnvEpsGram(V);
    set D = [:TS G, TS G:];
    set S = { z where z is Element of D :
      for R being Relation of TS G st R is par-closed holds z in R };
    S c= D
    proof
      let u be object;
      assume u in S;
      then ex z being Element of D st u = z &
        for R being Relation of TS G st R is par-closed holds z in R;
      hence thesis;
    end;
    hence thesis;
  end;
end;

theorem Th1:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  ( [M,N] in ParRed(V) iff
    for R being Relation of TS(EnvEpsGram(V)) st R is par-closed
      holds [M,N] in R )
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  A1: [M,N] in D by ZFMISC_1:87;
  hereby
    assume [M,N] in ParRed(V);
    then [M,N] in { z where z is Element of D :
      for R being Relation of TS G st R is par-closed holds z in R }
      by Def2;
    then consider z being Element of D such that
    B1: [M,N] = z and
    B2: for R being Relation of TS G st R is par-closed holds z in R;
    thus for R being Relation of TS G st R is par-closed
      holds [M,N] in R by B1,B2;
  end;
  assume C1: for R being Relation of TS G st R is par-closed
    holds [M,N] in R;
  reconsider z = [M,N] as Element of D by A1;
  z in { z2 where z2 is Element of D :
    for R being Relation of TS G st R is par-closed holds z2 in R }
    by C1;
  hence thesis by Def2;
end;

theorem Th2:
  for V being non empty set, R being Relation of TS(EnvEpsGram(V))
  st R is par-closed holds ParRed(V) c= R
proof
  let V be non empty set, R be Relation of TS(EnvEpsGram(V));
  assume A1: R is par-closed;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  now
    let u be object;
    assume u in ParRed(V);
    then u in { z where z is Element of D :
      for Q being Relation of TS G st Q is par-closed holds z in Q }
      by Def2;
    then consider z being Element of D such that
    B1: u = z and
    B2: for Q being Relation of TS G st Q is par-closed holds z in Q;
    thus u in R by A1,B1,B2;
  end;
  hence thesis by TARSKI:def 3;
end;

registration
  let V be non empty set;
  cluster ParRed(V) -> par-closed;
  coherence
  proof
    set G = EnvEpsGram(V);
    thus for M being EnvEpsTerm of V holds
      [M, M] in ParRed(V)
    proof
      let M be EnvEpsTerm of V;
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        thus [M, M] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in
      ParRed(V) holds
      [eLam(x,M), eLam(x,M1)] in ParRed(V)
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R by A0,Th1;
        hence [eLam(x,M), eLam(x,M1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in ParRed(V) holds
      [eEps M, eEps M1] in ParRed(V)
    proof
      let M,M1 be EnvEpsTerm of V;
      assume A0: [M,M1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R by A0,Th1;
        hence [eEps M, eEps M1] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in ParRed(V) & [N,N1]
      in ParRed(V) holds
      [eApp(M,N), eApp(M1,N1)] in ParRed(V)
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R by A0,Th1;
        hence [eApp(M,N), eApp(M1,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in ParRed(V) & [N,N1] in ParRed(V) holds
      [eExt(M,x,N), eExt(M1,x,N1)] in ParRed(V)
    proof
      let M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R by A0,Th1;
        hence [eExt(M,x,N), eExt(M1,x,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in ParRed(V) & [N,N1]
      in ParRed(V) holds
      [eComp(M,N), eComp(M1,N1)] in ParRed(V)
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R by A0,Th1;
        hence [eComp(M,N), eComp(M1,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in ParRed(V) & [N,N1] in ParRed(V) holds
      [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in ParRed(V)
    proof
      let M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R by A0,Th1;
        hence [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1,L,L1 being EnvEpsTerm of V, x being Element of V st
      [M,M1] in ParRed(V) & [N,N1] in ParRed(V) & [L,L1] in ParRed(V) holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in ParRed(V)
    proof
      let M,M1,N,N1,L,L1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V) & [L,L1] in
        ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R & [L,L1] in R by A0,Th1;
        hence [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in R by
          A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in ParRed(V) & [N,N1]
      in ParRed(V) holds
      [eApp(eEps M,N), eComp(M1,N1)] in ParRed(V)
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is par-closed;
        then [M,M1] in R & [N,N1] in R by A0,Th1;
        hence [eApp(eEps M,N), eComp(M1,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
  end;
end;

theorem Th3:
  for V being non empty set, P,Q being EnvEpsTerm of V
  st [P,Q] in ParRed(V) holds
  ( ex M2 being EnvEpsTerm of V st P = M2 & Q = M2 ) or
  ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    ParRed(V) & P = eLam(x2,M2) & Q = eLam(x2,M3) ) or
  ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & P = eEps M2 & Q =
    eEps M3 ) or
  ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3] in
    ParRed(V) & P = eApp(M2,N2) & Q = eApp(M3,N3) ) or
  ( ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    ParRed(V) & [N2,N3] in ParRed(V) & P = eExt(M2,x2,N2) & Q = eExt(M3,x2,N3)
    ) or
  ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3] in
    ParRed(V) & P = eComp(M2,N2) & Q = eComp(M3,N3) ) or
  ( ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    ParRed(V) & [N2,N3] in ParRed(V) & P = eApp(eLam(x2,M2),N2) & Q =
    eComp(M3,eExt(N3,x2,eId V)) ) or
  ( ex M2,M3,N2,N3,L2,L3 being EnvEpsTerm of V, x2 being Element of V st
    [M2,M3] in ParRed(V) & [N2,N3] in ParRed(V) & [L2,L3] in ParRed(V) & P =
    eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M3,eExt(N3,x2,L3)) ) or
  ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3] in
    ParRed(V) & P = eApp(eEps M2,N2) & Q = eComp(M3,N3) )
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  set R = ParRed(V);
  defpred D[object,object] means
    ( ex M2 being EnvEpsTerm of V st $1 = M2 & $2 = M2 ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      ParRed(V) & $1 = eLam(x2,M2) & $2 = eLam(x2,M3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & $1 = eEps M2 &
      $2 = eEps M3 ) or
    ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3]
      in ParRed(V) & $1 = eApp(M2,N2) & $2 = eApp(M3,N3) ) or
    ( ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in ParRed(V) & [N2,N3] in ParRed(V) & $1 = eExt(M2,x2,N2) & $2 =
      eExt(M3,x2,N3) ) or
    ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3]
      in ParRed(V) & $1 = eComp(M2,N2) & $2 = eComp(M3,N3) ) or
    ( ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in ParRed(V) & [N2,N3] in ParRed(V) & $1 = eApp(eLam(x2,M2),N2) & $2 =
      eComp(M3,eExt(N3,x2,eId V)) ) or
    ( ex M2,M3,N2,N3,L2,L3 being EnvEpsTerm of V, x2 being Element of V st
      [M2,M3] in ParRed(V) & [N2,N3] in ParRed(V) & [L2,L3] in ParRed(V) & $1
      = eApp(eComp(eLam(x2,M2),L2),N2) & $2 = eComp(M3,eExt(N3,x2,L3)) ) or
    ( ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & [N2,N3]
      in ParRed(V) & $1 = eApp(eEps M2,N2) & $2 = eComp(M3,N3) );
  set S = { z where z is Element of [:TS G, TS G:] :
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] };
  A1: S c= [:TS G, TS G:]
  proof
    let u be object;
    assume u in S;
    then ex z being Element of [:TS G, TS G:] st u = z &
      ( z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] );
    hence thesis;
  end;
  reconsider S1 = S as Relation of TS G by A1;
  A2: for a,b being EnvEpsTerm of V holds
    ( [a,b] in S1 iff ( [a,b] in R & D[a,b] ) )
  proof
    let a,b be EnvEpsTerm of V;
    hereby
      assume [a,b] in S1;
      then consider z being Element of [:TS G, TS G:] such that
      B1: [a,b] = z and
      B2: z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q];
      consider P,Q being EnvEpsTerm of V such that
      B3: z = [P,Q] & D[P,Q] by B2;
      a = P & b = Q by B1,B3,XTUPLE_0:1;
      hence [a,b] in R & D[a,b] by B1,B2,B3;
    end;
    assume C1: [a,b] in R & D[a,b];
    C2: [a,b] in [:TS G, TS G:] by ZFMISC_1:87;
    then reconsider z = [a,b] as Element of [:TS G, TS G:];
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] by C1;
    hence thesis;
  end;
  A3: S1 is par-closed
  proof
    thus for M being EnvEpsTerm of V holds
      [M, M] in S1
    proof
      let M be EnvEpsTerm of V;
      G2: [M, M] in R by Def1;
      G3: ex M2 being EnvEpsTerm of V st M = M2 & M = M2
      proof
        take M;
        thus thesis;
      end;
      G4: D[M, M] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in S1
      holds
      [eLam(x,M), eLam(x,M1)] in S1
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1;
      G1: [M,M1] in R by G0,A2;
      G2: [eLam(x,M), eLam(x,M1)] in R by G1,Def1;
      G3: ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
        ParRed(V) & eLam(x,M) = eLam(x2,M2) & eLam(x,M1) = eLam(x2,M3)
      proof
        take M,M1,x;
        thus thesis by G1;
      end;
      G4: D[eLam(x,M), eLam(x,M1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in S1 holds
      [eEps M, eEps M1] in S1
    proof
      let M,M1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      G1: [M,M1] in R by G0,A2;
      G2: [eEps M, eEps M1] in R by G1,Def1;
      G3: ex M2,M3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) & eEps M =
        eEps M2 & eEps M1 = eEps M3
      proof
        take M,M1;
        thus thesis by G1;
      end;
      G4: D[eEps M, eEps M1] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in S1 & [N,N1] in S1
      holds
      [eApp(M,N), eApp(M1,N1)] in S1
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1;
      G1: [M,M1] in R & [N,N1] in R by G0,A2;
      G2: [eApp(M,N), eApp(M1,N1)] in R by G1,Def1;
      G3: ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) &
        [N2,N3] in ParRed(V) & eApp(M,N) = eApp(M2,N2) & eApp(M1,N1) =
        eApp(M3,N3)
      proof
        take M,M1,N,N1;
        thus thesis by G1;
      end;
      G4: D[eApp(M,N), eApp(M1,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in S1 & [N,N1] in S1 holds
      [eExt(M,x,N), eExt(M1,x,N1)] in S1
    proof
      let M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1;
      G1: [M,M1] in R & [N,N1] in R by G0,A2;
      G2: [eExt(M,x,N), eExt(M1,x,N1)] in R by G1,Def1;
      G3: ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st
        [M2,M3] in ParRed(V) & [N2,N3] in ParRed(V) & eExt(M,x,N) =
        eExt(M2,x2,N2) & eExt(M1,x,N1) = eExt(M3,x2,N3)
      proof
        take M,M1,N,N1,x;
        thus thesis by G1;
      end;
      G4: D[eExt(M,x,N), eExt(M1,x,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in S1 & [N,N1] in S1
      holds
      [eComp(M,N), eComp(M1,N1)] in S1
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1;
      G1: [M,M1] in R & [N,N1] in R by G0,A2;
      G2: [eComp(M,N), eComp(M1,N1)] in R by G1,Def1;
      G3: ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) &
        [N2,N3] in ParRed(V) & eComp(M,N) = eComp(M2,N2) & eComp(M1,N1) =
        eComp(M3,N3)
      proof
        take M,M1,N,N1;
        thus thesis by G1;
      end;
      G4: D[eComp(M,N), eComp(M1,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V, x being Element of V st [M,M1]
      in S1 & [N,N1] in S1 holds
      [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in S1
    proof
      let M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1;
      G1: [M,M1] in R & [N,N1] in R by G0,A2;
      G2: [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in R by G1,Def1;
      G3: ex M2,M3,N2,N3 being EnvEpsTerm of V, x2 being Element of V st
        [M2,M3] in ParRed(V) & [N2,N3] in ParRed(V) & eApp(eLam(x,M),N) =
        eApp(eLam(x2,M2),N2) & eComp(M1,eExt(N1,x,eId V)) =
        eComp(M3,eExt(N3,x2,eId V))
      proof
        take M,M1,N,N1,x;
        thus thesis by G1;
      end;
      G4: D[eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1,L,L1 being EnvEpsTerm of V, x being Element of V st
      [M,M1] in S1 & [N,N1] in S1 & [L,L1] in S1 holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in S1
    proof
      let M,M1,N,N1,L,L1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1 & [L,L1] in S1;
      G1: [M,M1] in R & [N,N1] in R & [L,L1] in R by G0,A2;
      G2: [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in R by
        G1,Def1;
      G3: ex M2,M3,N2,N3,L2,L3 being EnvEpsTerm of V, x2 being Element of V st
        [M2,M3] in ParRed(V) & [N2,N3] in ParRed(V) & [L2,L3] in ParRed(V) &
        eApp(eComp(eLam(x,M),L),N) = eApp(eComp(eLam(x2,M2),L2),N2) &
        eComp(M1,eExt(N1,x,L1)) = eComp(M3,eExt(N3,x2,L3))
      proof
        take M,M1,N,N1,L,L1,x;
        thus thesis by G1;
      end;
      G4: D[eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in S1 & [N,N1] in S1
      holds
      [eApp(eEps M,N), eComp(M1,N1)] in S1
    proof
      let M,M1,N,N1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1 & [N,N1] in S1;
      G1: [M,M1] in R & [N,N1] in R by G0,A2;
      G2: [eApp(eEps M,N), eComp(M1,N1)] in R by G1,Def1;
      G3: ex M2,M3,N2,N3 being EnvEpsTerm of V st [M2,M3] in ParRed(V) &
        [N2,N3] in ParRed(V) & eApp(eEps M,N) = eApp(eEps M2,N2) &
        eComp(M1,N1) = eComp(M3,N3)
      proof
        take M,M1,N,N1;
        thus thesis by G1;
      end;
      G4: D[eApp(eEps M,N), eComp(M1,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
  end;
  A4: R c= S1 by A3,Th2;
  let P,Q be EnvEpsTerm of V;
  assume [P,Q] in R;
  then [P,Q] in S1 by A4;
  hence thesis by A2;
end;

theorem Th4:
  for V being non empty set, M being EnvEpsTerm of V holds
  [M, M] in ParRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  thus thesis by Def1;
end;

theorem Th5:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of V
    st [M,M1] in ParRed(V) holds
  [eLam(x,M), eLam(x,M1)] in ParRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th6:
  for V being non empty set, M,M1 being EnvEpsTerm of V st [M,M1] in ParRed(V)
    holds
  [eEps M, eEps M1] in ParRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  assume A0: [M,M1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th7:
  for V being non empty set, M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in
    ParRed(V) & [N,N1] in ParRed(V) holds
  [eApp(M,N), eApp(M1,N1)] in ParRed(V)
proof
  let V be non empty set, M,M1,N,N1 be EnvEpsTerm of V;
  assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th8:
  for V being non empty set, M,M1,N,N1 being EnvEpsTerm of V, x being Element
    of V st [M,M1] in ParRed(V) & [N,N1] in ParRed(V) holds
  [eExt(M,x,N), eExt(M1,x,N1)] in ParRed(V)
proof
  let V be non empty set, M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th9:
  for V being non empty set, M,M1,N,N1 being EnvEpsTerm of V st [M,M1] in
    ParRed(V) & [N,N1] in ParRed(V) holds
  [eComp(M,N), eComp(M1,N1)] in ParRed(V)
proof
  let V be non empty set, M,M1,N,N1 be EnvEpsTerm of V;
  assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th10:
  for V being non empty set, M,M1,N,N1 being EnvEpsTerm of V, x being Element
    of V st [M,M1] in ParRed(V) & [N,N1] in ParRed(V) holds
  [eApp(eLam(x,M),N), eComp(M1,eExt(N1,x,eId V))] in ParRed(V)
proof
  let V be non empty set, M,M1,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V);
  thus thesis by A0,Def1;
end;

theorem Th11:
  for V being non empty set, M,M1,N,N1,L,L1 being EnvEpsTerm of V, x being
    Element of V st [M,M1] in ParRed(V) & [N,N1] in ParRed(V) & [L,L1] in
    ParRed(V) holds
  [eApp(eComp(eLam(x,M),L),N), eComp(M1,eExt(N1,x,L1))] in ParRed(V)
proof
  let V be non empty set, M,M1,N,N1,L,L1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in ParRed(V) & [N,N1] in ParRed(V) & [L,L1] in ParRed(V);
  thus thesis by A0,Def1;
