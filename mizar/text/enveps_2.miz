begin :: Transporting a reduction along a congruence

scheme
  RedCong { R() -> Relation, F(object) -> object }:
  for a,b being object st R() reduces a,b holds R() reduces F(a),F(b)
provided
AA: for a,b being object st [a,b] in R() holds [F(a),F(b)] in R()
proof
  defpred Q[Nat] means for p being RedSequence of R() st len p = $1+1
    holds R() reduces F(p.1), F(p.(len p));
  B0: Q[0]
  proof
    let p be RedSequence of R();
    assume len p = 0+1;
    hence thesis by REWRITE1:12;
  end;
  B1: for n being Nat st Q[n] holds Q[n+1]
  proof
    let n be Nat;
    assume C0: Q[n];
    let p be RedSequence of R();
    assume C1: len p = n+1+1;
    C2: n+1 <= len p by C1,NAT_1:11;
    reconsider q = p|(Seg (n+1)) as FinSequence by FINSEQ_1:15;
    C3: len q = n+1 & dom q = Seg (n+1) by C2,FINSEQ_1:17;
    C4: for i being Nat st i in dom q holds q.i = p.i
    proof
      let i be Nat;
      assume i in dom q;
      hence thesis by FUNCT_1:47;
    end;
    C5: q is RedSequence of R()
    proof
      thus len q > 0 by C3;
      let i be Nat;
      assume D1: i in dom q & i+1 in dom q;
      D2: q.i = p.i & q.(i+1) = p.(i+1) by C4,D1;
      D3: dom p = Seg (len p) by FINSEQ_1:def 3;
      i <= n+1 & i+1 <= n+1 by C3,D1,FINSEQ_1:1;
      then D4: i <= len p & i+1 <= len p by C2,XXREAL_0:2;
      1 <= i & 1 <= i+1 by C3,D1,FINSEQ_1:1;
      then i in dom p & i+1 in dom p by D3,D4,FINSEQ_1:1;
      hence thesis by D2,REWRITE1:def 2;
    end;
    reconsider r = q as RedSequence of R() by C5;
    E0: len r = n+1 & dom r = Seg (n+1) by C3;
    E1: R() reduces F(r.1), F(r.(len r)) by C0,E0;
    E0a: 1 <= n+1 & n+1 <= n+1+1 by NAT_1:11;
    E2: 1 in dom q & n+1 in dom q by C3,E0a,FINSEQ_1:1;
    then E3: q.1 = p.1 & q.(n+1) = p.(n+1) by C4;
    F1: dom p = Seg (len p) by FINSEQ_1:def 3;
    F2: 1 <= n+1+1 by NAT_1:11;
    n+1 in dom p & n+1+1 in dom p by C1,E0a,F1,F2,FINSEQ_1:1;
    then [p.(n+1), p.(n+1+1)] in R() by REWRITE1:def 2;
    then [F(p.(n+1)), F(p.(n+1+1))] in R() by AA;
    then R() reduces F(p.(n+1)), F(p.(n+1+1)) by REWRITE1:15;
    hence thesis by C1,E0,E1,E3,REWRITE1:16;
  end;
  G1: for n being Nat holds Q[n] from NAT_1:sch 2(B0,B1);
  let a,b be object;
  assume R() reduces a,b;
  then consider p being RedSequence of R() such that
  H1: p.1 = a & p.(len p) = b by REWRITE1:def 3;
  len p > 0 by REWRITE1:def 2;
  then consider n being Nat such that H2: len p = n+1 by NAT_1:6;
  thus thesis by G1,H1,H2;
end;

begin :: Multi-step congruence rules

theorem Th1:
  for V being non empty set, M,M1,N being EnvEpsTerm of V
  st SigmaRed(V) reduces M,M1
  holds SigmaRed(V) reduces eApp(M,N), eApp(M1,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = SigmaRed(V);
  deffunc F(object) = eApp(In($1,TS G), N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(a1,N), eApp(b1,N)] in R by ENVEPS_1:def 13;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from RedCong(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th2:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V
  st SigmaRed(V) reduces N,N1
  holds SigmaRed(V) reduces eApp(M,N), eApp(M,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = SigmaRed(V);
  deffunc F(object) = eApp(M, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(M,a1), eApp(M,b1)] in R by ENVEPS_1:def 13;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from RedCong(A1);
  assume A3: R reduces N,N1;
  A4: In(N,TS G) = N & In(N1,TS G) = N1;
  thus thesis by A2,A3,A4;
end;

theorem Th3:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x0 being Element of V
  st SigmaRed(V) reduces M,M1
  holds SigmaRed(V) reduces eLam(x0,M), eLam(x0,M1)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = SigmaRed(V);
  deffunc F(object) = eLam(x0, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eLam(x0,a1), eLam(x0,b1)] in R by ENVEPS_1:def 13;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from RedCong(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th4:
  for V being non empty set, M,M1,N being EnvEpsTerm of V,
    x0 being Element of V
  st SigmaRed(V) reduces M,M1
  holds SigmaRed(V) reduces eExt(M,x0,N), eExt(M1,x0,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = SigmaRed(V);
  deffunc F(object) = eExt(In($1,TS G), x0, N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
