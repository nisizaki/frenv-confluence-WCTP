begin :: Inversion of the sigma reduction

theorem Th9:
  for V being non empty set, P,Q being EnvEpsTerm of V
  st [P,Q] in SigmaRed(V) holds
  ( ex M2,N2,L2 being EnvEpsTerm of V st P = eComp(eComp(M2,N2),L2) & Q =
    eComp(M2,eComp(N2,L2)) ) or
  ( ex M2 being EnvEpsTerm of V st P = eComp(eId V,M2) & Q = M2 ) or
  ( ex M2 being EnvEpsTerm of V st P = eComp(M2,eId V) & Q = M2 ) or
  ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st P =
    eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st P = eComp(eVar
    x2, eExt(M2,x2,N2)) & Q = M2 ) or
  ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 & P =
    eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
  ( ex M2,N2,L2 being EnvEpsTerm of V st P = eComp(eApp(M2,N2),L2) & Q =
    eApp(eComp(M2,L2),eComp(N2,L2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V st P = eComp(eEps M2,N2) & Q = eEps M2 ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & P =
    eApp(M2,N2) & Q = eApp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & P =
    eApp(M2,N2) & Q = eApp(M2,N3) ) or
  ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    SigmaRed(V) & P = eLam(x2,M2) & Q = eLam(x2,M3) ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    SigmaRed(V) & P = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
    SigmaRed(V) & P = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & P =
    eComp(M2,N2) & Q = eComp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & P =
    eComp(M2,N2) & Q = eComp(M2,N3) ) or
  ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & P = eEps M2 & Q
    = eEps M3 )
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  set R = SigmaRed(V);
  defpred D[object,object] means
    ( ex M2,N2,L2 being EnvEpsTerm of V st $1 = eComp(eComp(M2,N2),L2) & $2 =
      eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st $1 = eComp(eId V,M2) & $2 = M2 ) or
    ( ex M2 being EnvEpsTerm of V st $1 = eComp(M2,eId V) & $2 = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st $1 =
      eComp(eExt(L2,x2,M2),N2) & $2 = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st $1 = eComp(eVar
      x2, eExt(M2,x2,N2)) & $2 = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      $1 = eComp(eVar x2, eExt(M2,y2,N2)) & $2 = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st $1 = eComp(eApp(M2,N2),L2) & $2 =
      eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st $1 = eComp(eEps M2,N2) & $2 = eEps M2
      ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & $1 =
      eApp(M2,N2) & $2 = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & $1 =
      eApp(M2,N2) & $2 = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & $1 = eLam(x2,M2) & $2 = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & $1 = eExt(M2,x2,N2) & $2 = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & $1 = eExt(M2,x2,N2) & $2 = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & $1 =
      eComp(M2,N2) & $2 = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & $1 =
      eComp(M2,N2) & $2 = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & $1 = eEps M2
      & $2 = eEps M3 );
  set S = { z where z is Element of [:TS G, TS G:] :
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] };
  A1: S c= [:TS G, TS G:]
  proof
    let u be object;
    assume u in S;
    then ex z being Element of [:TS G, TS G:] st u = z &
      ( z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] );
    hence thesis;
  end;
  reconsider S1 = S as Relation of TS G by A1;
  A2: for a,b being EnvEpsTerm of V holds
    ( [a,b] in S1 iff ( [a,b] in R & D[a,b] ) )
  proof
    let a,b be EnvEpsTerm of V;
    hereby
      assume [a,b] in S1;
      then consider z being Element of [:TS G, TS G:] such that
      B1: [a,b] = z and
      B2: z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q];
      consider P,Q being EnvEpsTerm of V such that
      B3: z = [P,Q] & D[P,Q] by B2;
      a = P & b = Q by B1,B3,XTUPLE_0:1;
      hence [a,b] in R & D[a,b] by B1,B2,B3;
    end;
    assume C1: [a,b] in R & D[a,b];
    C2: [a,b] in [:TS G, TS G:] by ZFMISC_1:87;
    then reconsider z = [a,b] as Element of [:TS G, TS G:];
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] by C1;
    hence thesis;
  end;
  A3: S1 is sigma-closed
  proof
    thus for M,N,L being EnvEpsTerm of V holds
      [eComp(eComp(M,N),L), eComp(M,eComp(N,L))] in S1
    proof
      let M,N,L be EnvEpsTerm of V;
      G2: [eComp(eComp(M,N),L), eComp(M,eComp(N,L))] in R by ENVEPS_1:def 13;
      G3: ex M2,N2,L2 being EnvEpsTerm of V st eComp(eComp(M,N),L) =
        eComp(eComp(M2,N2),L2) & eComp(M,eComp(N,L)) = eComp(M2,eComp(N2,L2))
      proof
        take M,N,L;
        thus thesis;
      end;
      G4: D[eComp(eComp(M,N),L), eComp(M,eComp(N,L))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M being EnvEpsTerm of V holds
      [eComp(eId V,M), M] in S1
    proof
      let M be EnvEpsTerm of V;
      G2: [eComp(eId V,M), M] in R by ENVEPS_1:def 13;
      G3: ex M2 being EnvEpsTerm of V st eComp(eId V,M) = eComp(eId V,M2) & M
        = M2
      proof
        take M;
        thus thesis;
      end;
      G4: D[eComp(eId V,M), M] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M being EnvEpsTerm of V holds
      [eComp(M,eId V), M] in S1
    proof
      let M be EnvEpsTerm of V;
      G2: [eComp(M,eId V), M] in R by ENVEPS_1:def 13;
      G3: ex M2 being EnvEpsTerm of V st eComp(M,eId V) = eComp(M2,eId V) & M
        = M2
      proof
        take M;
        thus thesis;
      end;
      G4: D[eComp(M,eId V), M] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for L,M,N being EnvEpsTerm of V, x being Element of V holds
      [eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] in S1
    proof
      let L,M,N be EnvEpsTerm of V, x be Element of V;
      G2: [eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] in R by
        ENVEPS_1:def 13;
      G3: ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eComp(eExt(L,x,M),N) = eComp(eExt(L2,x2,M2),N2) &
        eExt(eComp(L,N),x,eComp(M,N)) = eExt(eComp(L2,N2),x2,eComp(M2,N2))
      proof
        take L,M,N,x;
        thus thesis;
      end;
      G4: D[eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N being EnvEpsTerm of V, x being Element of V holds
      [eComp(eVar x, eExt(M,x,N)), M] in S1
    proof
      let M,N be EnvEpsTerm of V, x be Element of V;
      G2: [eComp(eVar x, eExt(M,x,N)), M] in R by ENVEPS_1:def 13;
      G3: ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(eVar
        x, eExt(M,x,N)) = eComp(eVar x2, eExt(M2,x2,N2)) & M = M2
      proof
        take M,N,x;
        thus thesis;
      end;
      G4: D[eComp(eVar x, eExt(M,x,N)), M] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N being EnvEpsTerm of V, x,y being Element of V st x <> y holds
      [eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] in S1
    proof
      let M,N be EnvEpsTerm of V, x,y be Element of V;
      assume G0: x <> y;
      G2: [eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] in R by
        G0,ENVEPS_1:def 13;
      G3: ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
        & eComp(eVar x, eExt(M,y,N)) = eComp(eVar x2, eExt(M2,y2,N2)) &
        eComp(eVar x, N) = eComp(eVar x2, N2)
      proof
        take M,N,x,y;
        thus thesis by G0;
      end;
      G4: D[eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,L being EnvEpsTerm of V holds
      [eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] in S1
    proof
      let M,N,L be EnvEpsTerm of V;
      G2: [eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] in R by
        ENVEPS_1:def 13;
      G3: ex M2,N2,L2 being EnvEpsTerm of V st eComp(eApp(M,N),L) =
        eComp(eApp(M2,N2),L2) & eApp(eComp(M,L),eComp(N,L)) =
        eApp(eComp(M2,L2),eComp(N2,L2))
      proof
        take M,N,L;
        thus thesis;
      end;
      G4: D[eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N being EnvEpsTerm of V holds
      [eComp(eEps M,N), eEps M] in S1
    proof
      let M,N be EnvEpsTerm of V;
      G2: [eComp(eEps M,N), eEps M] in R by ENVEPS_1:def 13;
      G3: ex M2,N2 being EnvEpsTerm of V st eComp(eEps M,N) = eComp(eEps
        M2,N2) & eEps M = eEps M2
      proof
        take M,N;
        thus thesis;
      end;
      G4: D[eComp(eEps M,N), eEps M] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in S1 holds
      [eApp(M,N), eApp(M1,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eApp(M,N), eApp(M1,N)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
        eApp(M,N) = eApp(M2,N2) & eApp(M1,N) = eApp(M3,N2)
      proof
        take M,M1,N;
        thus thesis by G1;
      end;
      G4: D[eApp(M,N), eApp(M1,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in S1 holds
      [eApp(M,N), eApp(M,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eApp(M,N), eApp(M,N1)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
        eApp(M,N) = eApp(M2,N2) & eApp(M,N1) = eApp(M2,N3)
      proof
        take M,N,N1;
        thus thesis by G1;
      end;
      G4: D[eApp(M,N), eApp(M,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in S1
      holds
      [eLam(x,M), eLam(x,M1)] in S1
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eLam(x,M), eLam(x,M1)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
        SigmaRed(V) & eLam(x,M) = eLam(x2,M2) & eLam(x,M1) = eLam(x2,M3)
      proof
        take M,M1,x;
        thus thesis by G1;
      end;
      G4: D[eLam(x,M), eLam(x,M1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V, x being Element of V st [M,M1] in
      S1 holds
      [eExt(M,x,N), eExt(M1,x,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eExt(M,x,N), eExt(M1,x,N)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
        in SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & eExt(M1,x,N) =
        eExt(M3,x2,N2)
      proof
        take M,M1,N,x;
        thus thesis by G1;
      end;
      G4: D[eExt(M,x,N), eExt(M1,x,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V, x being Element of V st [N,N1] in
      S1 holds
      [eExt(M,x,N), eExt(M,x,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eExt(M,x,N), eExt(M,x,N1)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
        in SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & eExt(M,x,N1) =
        eExt(M2,x2,N3)
      proof
        take M,N,N1,x;
        thus thesis by G1;
      end;
      G4: D[eExt(M,x,N), eExt(M,x,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in S1 holds
      [eComp(M,N), eComp(M1,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eComp(M,N), eComp(M1,N)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & eComp(M1,N) = eComp(M3,N2)
      proof
        take M,M1,N;
        thus thesis by G1;
      end;
      G4: D[eComp(M,N), eComp(M1,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in S1 holds
      [eComp(M,N), eComp(M,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eComp(M,N), eComp(M,N1)] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
        eComp(M,N) = eComp(M2,N2) & eComp(M,N1) = eComp(M2,N3)
      proof
        take M,N,N1;
        thus thesis by G1;
      end;
      G4: D[eComp(M,N), eComp(M,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in S1 holds
      [eEps M, eEps M1] in S1
    proof
      let M,M1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eEps M, eEps M1] in R by G1,ENVEPS_1:def 13;
      G3: ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M =
        eEps M2 & eEps M1 = eEps M3
      proof
        take M,M1;
        thus thesis by G1;
      end;
      G4: D[eEps M, eEps M1] by G3;
      thus thesis by A2,G2,G4;
    end;
  end;
  A4: R c= S1 by A3,ENVEPS_1:33;
  let P,Q be EnvEpsTerm of V;
  assume [P,Q] in R;
  then [P,Q] in S1 by A4;
  hence thesis by A2;
end;

begin :: The sixteen rules as one-step reductions

theorem Th10:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [eComp(eComp(M,N),L), eComp(M,eComp(N,L))] in SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th11:
  for V being non empty set, M being EnvEpsTerm of V holds
  [eComp(eId V,M), M] in SigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th12:
  for V being non empty set, M being EnvEpsTerm of V holds
  [eComp(M,eId V), M] in SigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th13:
  for V being non empty set, L,M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] in SigmaRed(V)
proof
  let V be non empty set, L,M,N be EnvEpsTerm of V, x be Element of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th14:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eComp(eVar x, eExt(M,x,N)), M] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th15:
  for V being non empty set, M,N being EnvEpsTerm of V, x,y being Element of V
    st x <> y holds
  [eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x,y be Element of V;
  assume A0: x <> y;
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th16:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] in SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th17:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  [eComp(eEps M,N), eEps M] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  thus thesis by ENVEPS_1:def 13;
end;

theorem Th18:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [eApp(M,N), eApp(M1,N)] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume A0: [M,M1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th19:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    SigmaRed(V) holds
  [eApp(M,N), eApp(M,N1)] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume A0: [N,N1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th20:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of V
    st [M,M1] in SigmaRed(V) holds
  [eLam(x,M), eLam(x,M1)] in SigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th21:
  for V being non empty set, M,M1,N being EnvEpsTerm of V, x being Element of
    V st [M,M1] in SigmaRed(V) holds
  [eExt(M,x,N), eExt(M1,x,N)] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x be Element of V;
  assume A0: [M,M1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th22:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V, x being Element of
    V st [N,N1] in SigmaRed(V) holds
  [eExt(M,x,N), eExt(M,x,N1)] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume A0: [N,N1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th23:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [eComp(M,N), eComp(M1,N)] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume A0: [M,M1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th24:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    SigmaRed(V) holds
  [eComp(M,N), eComp(M,N1)] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume A0: [N,N1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;

theorem Th25:
  for V being non empty set, M,M1 being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [eEps M, eEps M1] in SigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  assume A0: [M,M1] in SigmaRed(V);
  thus thesis by A0,ENVEPS_1:def 13;
end;
begin :: Joining two reductions

theorem Th26:
  for V being non empty set, M,N,L being EnvEpsTerm of V
  st SigmaRed(V) reduces M,L & SigmaRed(V) reduces N,L
  holds M,N are_convergent_wrt SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  assume A1: SigmaRed(V) reduces M,L & SigmaRed(V) reduces N,L;
  take L;
  thus thesis by A1;
end;

theorem Th27:
  for V being non empty set, M,N being EnvEpsTerm of V
  st [M,N] in SigmaRed(V) holds SigmaRed(V) reduces M,N by REWRITE1:15;

theorem Th28:
  for V being non empty set, M being EnvEpsTerm of V
  holds SigmaRed(V) reduces M,M by REWRITE1:12;
