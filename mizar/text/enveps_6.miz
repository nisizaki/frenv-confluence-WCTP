begin :: Multi-step congruence for the beta reduction

theorem Th15:
  for V being non empty set, M,M1,N being EnvEpsTerm of V
  st BetaRed(V) reduces M,M1
  holds BetaRed(V) reduces eApp(M,N), eApp(M1,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eApp(In($1,TS G), N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(a1,N), eApp(b1,N)] in R by Th7;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th16:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V
  st BetaRed(V) reduces N,N1
  holds BetaRed(V) reduces eApp(M,N), eApp(M,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eApp(M, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(M,a1), eApp(M,b1)] in R by Th8;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces N,N1;
  A4: In(N,TS G) = N & In(N1,TS G) = N1;
  thus thesis by A2,A3,A4;
end;

theorem Th17:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x0 being Element of V
  st BetaRed(V) reduces M,M1
  holds BetaRed(V) reduces eLam(x0,M), eLam(x0,M1)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eLam(x0, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eLam(x0,a1), eLam(x0,b1)] in R by Th9;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th18:
  for V being non empty set, M,M1,N being EnvEpsTerm of V, x0 being Element of
    V
  st BetaRed(V) reduces M,M1
  holds BetaRed(V) reduces eExt(M,x0,N), eExt(M1,x0,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eExt(In($1,TS G), x0, N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eExt(a1,x0,N), eExt(b1,x0,N)] in R by Th10;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th19:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V, x0 being Element of
    V
  st BetaRed(V) reduces N,N1
  holds BetaRed(V) reduces eExt(M,x0,N), eExt(M,x0,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eExt(M, x0, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eExt(M,x0,a1), eExt(M,x0,b1)] in R by Th11;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces N,N1;
  A4: In(N,TS G) = N & In(N1,TS G) = N1;
  thus thesis by A2,A3,A4;
end;

theorem Th20:
  for V being non empty set, M,M1,N being EnvEpsTerm of V
  st BetaRed(V) reduces M,M1
  holds BetaRed(V) reduces eComp(M,N), eComp(M1,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eComp(In($1,TS G), N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eComp(a1,N), eComp(b1,N)] in R by Th12;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th21:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V
  st BetaRed(V) reduces N,N1
  holds BetaRed(V) reduces eComp(M,N), eComp(M,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eComp(M, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eComp(M,a1), eComp(M,b1)] in R by Th13;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces N,N1;
  A4: In(N,TS G) = N & In(N1,TS G) = N1;
  thus thesis by A2,A3,A4;
end;

theorem Th22:
  for V being non empty set, M,M1 being EnvEpsTerm of V
  st BetaRed(V) reduces M,M1
  holds BetaRed(V) reduces eEps M, eEps M1
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  deffunc F(object) = eEps (In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eEps a1, eEps b1] in R by Th14;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

begin :: Beta inversion by the head constructor

theorem Th23:
  for V being non empty set, x being Element of V, Q being EnvEpsTerm of V
  holds not [eVar x, Q] in BetaRed(V)
proof
  let V be non empty set, x be Element of V, Q be EnvEpsTerm of V;
  assume A1: [eVar x, Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eVar x = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eVar x =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eVar x =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x = eEps
      M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eVar x = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eVar x = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eVar x = eApp(eEps M2,N2) & Q =
      eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eVar x = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x
      = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eVar x = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eVar x
      = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eVar x = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x
      = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eVar x = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eVar x
      = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eVar x = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eVar x =
      eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eVar x = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th24:
  for V being non empty set, Q being EnvEpsTerm of V
  holds not [eId V, Q] in BetaRed(V)
proof
  let V be non empty set, Q be EnvEpsTerm of V;
  assume A1: [eId V, Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eId V = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V = eEps
      M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eId V = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eId V = eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eId V = eApp(eEps M2,N2) & Q =
      eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eId V = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eId V = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eId V = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eId V = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eId V = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eId V =
      eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eId V = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th25:
  for V being non empty set, M being EnvEpsTerm of V, x being Element of V, Q
    being EnvEpsTerm of V
  st [eLam(x,M), Q] in BetaRed(V) holds
  ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    BetaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3) )
proof
  let V be non empty set, M be EnvEpsTerm of V, x be Element of V, Q be
    EnvEpsTerm of V;
  assume A1: [eLam(x,M), Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eLam(x,M) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eLam(x,M) =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eLam(x,M) =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eLam(x,M) =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eLam(x,M) =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eLam(x,M) =
      eEps M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eLam(x,M) = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st
      eLam(x,M) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eLam(x,M) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eLam(x,M) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eLam(x,M) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eLam(x,M) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eLam(x,M) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eLam(x,M) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3);
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eLam(x,M) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eLam(x,M) = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eLam(x,M) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eLam(x,M) = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eLam(x,M)
      = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eLam(x,M) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th26:
  for V being non empty set, M being EnvEpsTerm of V, Q being EnvEpsTerm of V
  st [eEps M, Q] in BetaRed(V) holds
  ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M = eEps M2
    & Q = eEps M3 )
proof
  let V be non empty set, M be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eEps M, Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eEps M = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eEps M =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eEps M =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M = eEps
      M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eEps M = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eEps M = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eEps M = eApp(eEps M2,N2) & Q =
      eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eEps M = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M
      = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eEps M = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eEps M
      = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eEps M = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M
      = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eEps M = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eEps M
      = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eEps M = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M =
      eEps M2 & Q = eEps M3;
    hence thesis;
  end;
end;

theorem Th27:
  for V being non empty set, M,N being EnvEpsTerm of V, Q being EnvEpsTerm of
    V
  st [eApp(M,N), Q] in BetaRed(V) holds
  ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
    eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
  ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
    eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V st eApp(M,N) = eApp(eEps M2,N2) & Q =
    eComp(M2,N2) ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eApp(M,N) =
    eApp(M2,N2) & Q = eApp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eApp(M,N) =
    eApp(M2,N2) & Q = eApp(M2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eApp(M,N), Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eApp(M,N) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eApp(M,N) =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eApp(M,N) =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eApp(M,N) =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eApp(M,N) =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eApp(M,N) =
      eEps M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    hence thesis;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st
      eApp(M,N) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    hence thesis;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eApp(M,N) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2);
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eApp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eApp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    hence thesis;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eApp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eApp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eApp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eApp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eApp(M,N)
      = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eApp(M,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th28:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V,
    Q being EnvEpsTerm of V
  st [eExt(M,x,N), Q] in BetaRed(V) holds
  ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
    BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V, Q be
    EnvEpsTerm of V;
  assume A1: [eExt(M,x,N), Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N)
      = eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eExt(M,x,N) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eExt(M,x,N)
      = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eExt(M,x,N)
      = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eExt(M,x,N)
      = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eExt(M,x,N)
      = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eExt(M,x,N) =
      eEps M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N)
      = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eExt(M,x,N) = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st
      eExt(M,x,N) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eExt(M,x,N) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eExt(M,x,N) = eApp(eEps M2,N2) & Q
      = eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eExt(M,x,N) = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eExt(M,x,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th29:
  for V being non empty set, M,N being EnvEpsTerm of V, Q being EnvEpsTerm of
    V
  st [eComp(M,N), Q] in BetaRed(V) holds
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eComp(M,N) =
    eComp(M2,N2) & Q = eComp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eComp(M,N) =
    eComp(M2,N2) & Q = eComp(M2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eComp(M,N), Q] in BetaRed(V);
  A2:
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
      eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
      eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eComp(M,N) = eApp(eEps M2,N2) & Q =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eComp(M,N)
      = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eComp(M,N)
      = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eComp(M,N)
      = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & eComp(M,N)
      = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eComp(M,N) =
      eEps M2 & Q = eEps M3 )
    by A1,Th3;
  per cases by A2;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N)
      = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eComp(M,N) = eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st
      eComp(M,N) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eComp(M,N) = eApp(eComp(eLam(x2,M2),L2),N2) & Q =
      eComp(M2,eExt(N2,x2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eComp(M,N) = eApp(eEps M2,N2) & Q
      = eComp(M2,N2);
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eComp(M,N) = eApp(eEps M2,N2) & Q = eComp(M2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eComp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eComp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eComp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in BetaRed(V) & eComp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in BetaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in BetaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
      eComp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
      eComp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    hence thesis;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eComp(M,N)
      = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in BetaRed(V) & eComp(M,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

begin :: The full beta/sigma reduction

definition
  let V be non empty set;
  func BetaSigmaRed(V) -> Relation of TS(EnvEpsGram(V)) equals
  :Def3:
  BetaRed(V) \/ SigmaRed(V);
  coherence
  proof
    set G = EnvEpsGram(V);
    A1: BetaRed(V) c= [:TS G, TS G:];
    SigmaRed(V) c= [:TS G, TS G:];
    hence thesis by A1,XBOOLE_1:8;
  end;
end;

theorem Th30:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  ( [M,N] in BetaSigmaRed(V) iff
    [M,N] in BetaRed(V) or [M,N] in SigmaRed(V) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  BetaSigmaRed(V) = BetaRed(V) \/ SigmaRed(V) by Def3;
  hence thesis by XBOOLE_0:def 3;
end;

theorem Th31:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in BetaRed(V) by Th4;
  hence thesis by Th30;
end;

theorem Th32:
  for V being non empty set, M,N,L being EnvEpsTerm of V, x being Element of V
    holds
  [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V, x be Element of V;
  [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in BetaRed(V) by Th5;
  hence thesis by Th30;
end;

theorem Th33:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  [eApp(eEps M,N), eComp(M,N)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  [eApp(eEps M,N), eComp(M,N)] in BetaRed(V) by Th6;
  hence thesis by Th30;
end;

theorem Th34:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [eComp(eComp(M,N),L), eComp(M,eComp(N,L))] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  [eComp(eComp(M,N),L), eComp(M,eComp(N,L))] in SigmaRed(V) by ENVEPS_2:10;
  hence thesis by Th30;
end;

theorem Th35:
  for V being non empty set, M being EnvEpsTerm of V holds
  [eComp(eId V,M), M] in BetaSigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  [eComp(eId V,M), M] in SigmaRed(V) by ENVEPS_2:11;
  hence thesis by Th30;
end;

theorem Th36:
  for V being non empty set, M being EnvEpsTerm of V holds
  [eComp(M,eId V), M] in BetaSigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  [eComp(M,eId V), M] in SigmaRed(V) by ENVEPS_2:12;
  hence thesis by Th30;
end;

theorem Th37:
  for V being non empty set, L,M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] in BetaSigmaRed(V)
proof
  let V be non empty set, L,M,N be EnvEpsTerm of V, x be Element of V;
  [eComp(eExt(L,x,M),N), eExt(eComp(L,N),x,eComp(M,N))] in SigmaRed(V) by
    ENVEPS_2:13;
  hence thesis by Th30;
end;

theorem Th38:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eComp(eVar x, eExt(M,x,N)), M] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  [eComp(eVar x, eExt(M,x,N)), M] in SigmaRed(V) by ENVEPS_2:14;
  hence thesis by Th30;
end;

theorem Th39:
  for V being non empty set, M,N being EnvEpsTerm of V, x,y being Element of V
    st x <> y holds
  [eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x,y be Element of V;
  assume A0: x <> y;
  [eComp(eVar x, eExt(M,y,N)), eComp(eVar x, N)] in SigmaRed(V) by
    A0,ENVEPS_2:15;
  hence thesis by Th30;
end;

theorem Th40:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  [eComp(eApp(M,N),L), eApp(eComp(M,L),eComp(N,L))] in SigmaRed(V) by
    ENVEPS_2:16;
  hence thesis by Th30;
end;

theorem Th41:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  [eComp(eEps M,N), eEps M] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  [eComp(eEps M,N), eEps M] in SigmaRed(V) by ENVEPS_2:17;
  hence thesis by Th30;
end;

theorem Th42:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    BetaSigmaRed(V) holds
  [eApp(M,N), eApp(M1,N)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume [M,M1] in BetaSigmaRed(V);
  then A0: [M,M1] in BetaRed(V) or [M,M1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [M,M1] in BetaRed(V);
    [eApp(M,N), eApp(M1,N)] in BetaRed(V) by A1,Th7;
    hence thesis by Th30;
  end;
  suppose A1: [M,M1] in SigmaRed(V);
    [eApp(M,N), eApp(M1,N)] in SigmaRed(V) by A1,ENVEPS_2:18;
    hence thesis by Th30;
  end;
end;

theorem Th43:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    BetaSigmaRed(V) holds
  [eApp(M,N), eApp(M,N1)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume [N,N1] in BetaSigmaRed(V);
  then A0: [N,N1] in BetaRed(V) or [N,N1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [N,N1] in BetaRed(V);
    [eApp(M,N), eApp(M,N1)] in BetaRed(V) by A1,Th8;
    hence thesis by Th30;
  end;
  suppose A1: [N,N1] in SigmaRed(V);
    [eApp(M,N), eApp(M,N1)] in SigmaRed(V) by A1,ENVEPS_2:19;
    hence thesis by Th30;
  end;
end;

theorem Th44:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of V
    st [M,M1] in BetaSigmaRed(V) holds
  [eLam(x,M), eLam(x,M1)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume [M,M1] in BetaSigmaRed(V);
  then A0: [M,M1] in BetaRed(V) or [M,M1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [M,M1] in BetaRed(V);
    [eLam(x,M), eLam(x,M1)] in BetaRed(V) by A1,Th9;
    hence thesis by Th30;
  end;
  suppose A1: [M,M1] in SigmaRed(V);
    [eLam(x,M), eLam(x,M1)] in SigmaRed(V) by A1,ENVEPS_2:20;
    hence thesis by Th30;
  end;
end;

theorem Th45:
  for V being non empty set, M,M1,N being EnvEpsTerm of V, x being Element of
    V st [M,M1] in BetaSigmaRed(V) holds
  [eExt(M,x,N), eExt(M1,x,N)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x be Element of V;
  assume [M,M1] in BetaSigmaRed(V);
  then A0: [M,M1] in BetaRed(V) or [M,M1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [M,M1] in BetaRed(V);
    [eExt(M,x,N), eExt(M1,x,N)] in BetaRed(V) by A1,Th10;
    hence thesis by Th30;
  end;
  suppose A1: [M,M1] in SigmaRed(V);
    [eExt(M,x,N), eExt(M1,x,N)] in SigmaRed(V) by A1,ENVEPS_2:21;
    hence thesis by Th30;
  end;
end;

theorem Th46:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V, x being Element of
    V st [N,N1] in BetaSigmaRed(V) holds
  [eExt(M,x,N), eExt(M,x,N1)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume [N,N1] in BetaSigmaRed(V);
  then A0: [N,N1] in BetaRed(V) or [N,N1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [N,N1] in BetaRed(V);
    [eExt(M,x,N), eExt(M,x,N1)] in BetaRed(V) by A1,Th11;
    hence thesis by Th30;
  end;
  suppose A1: [N,N1] in SigmaRed(V);
    [eExt(M,x,N), eExt(M,x,N1)] in SigmaRed(V) by A1,ENVEPS_2:22;
    hence thesis by Th30;
  end;
end;

theorem Th47:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    BetaSigmaRed(V) holds
  [eComp(M,N), eComp(M1,N)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume [M,M1] in BetaSigmaRed(V);
  then A0: [M,M1] in BetaRed(V) or [M,M1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [M,M1] in BetaRed(V);
    [eComp(M,N), eComp(M1,N)] in BetaRed(V) by A1,Th12;
    hence thesis by Th30;
  end;
  suppose A1: [M,M1] in SigmaRed(V);
    [eComp(M,N), eComp(M1,N)] in SigmaRed(V) by A1,ENVEPS_2:23;
    hence thesis by Th30;
  end;
end;

theorem Th48:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    BetaSigmaRed(V) holds
  [eComp(M,N), eComp(M,N1)] in BetaSigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume [N,N1] in BetaSigmaRed(V);
  then A0: [N,N1] in BetaRed(V) or [N,N1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [N,N1] in BetaRed(V);
    [eComp(M,N), eComp(M,N1)] in BetaRed(V) by A1,Th13;
    hence thesis by Th30;
  end;
  suppose A1: [N,N1] in SigmaRed(V);
    [eComp(M,N), eComp(M,N1)] in SigmaRed(V) by A1,ENVEPS_2:24;
    hence thesis by Th30;
  end;
end;

theorem Th49:
  for V being non empty set, M,M1 being EnvEpsTerm of V st [M,M1] in
    BetaSigmaRed(V) holds
  [eEps M, eEps M1] in BetaSigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  assume [M,M1] in BetaSigmaRed(V);
  then A0: [M,M1] in BetaRed(V) or [M,M1] in SigmaRed(V) by Th30;
  per cases by A0;
  suppose A1: [M,M1] in BetaRed(V);
    [eEps M, eEps M1] in BetaRed(V) by A1,Th14;
    hence thesis by Th30;
  end;
  suppose A1: [M,M1] in SigmaRed(V);
    [eEps M, eEps M1] in SigmaRed(V) by A1,ENVEPS_2:25;
    hence thesis by Th30;
  end;
end;

begin :: Multi-step congruence for the beta/sigma reduction

theorem Th50:
  for V being non empty set, M,M1,N being EnvEpsTerm of V
  st BetaSigmaRed(V) reduces M,M1
  holds BetaSigmaRed(V) reduces eApp(M,N), eApp(M1,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaSigmaRed(V);
  deffunc F(object) = eApp(In($1,TS G), N);
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(a1,N), eApp(b1,N)] in R by Th42;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

theorem Th51:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V
  st BetaSigmaRed(V) reduces N,N1
  holds BetaSigmaRed(V) reduces eApp(M,N), eApp(M,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set R = BetaSigmaRed(V);
  deffunc F(object) = eApp(M, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eApp(M,a1), eApp(M,b1)] in R by Th43;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces N,N1;
  A4: In(N,TS G) = N & In(N1,TS G) = N1;
  thus thesis by A2,A3,A4;
end;

theorem Th52:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x0 being Element of V
  st BetaSigmaRed(V) reduces M,M1
  holds BetaSigmaRed(V) reduces eLam(x0,M), eLam(x0,M1)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x0 be Element of V;
  set G = EnvEpsGram(V);
  set R = BetaSigmaRed(V);
  deffunc F(object) = eLam(x0, In($1,TS G));
  A1: for u,v being object st [u,v] in R holds [F(u),F(v)] in R
  proof
    let u,v be object;
    assume B1: [u,v] in R;
    R c= [:TS G,TS G:];
    then [u,v] in [:TS G,TS G:] by B1;
    then u in TS G & v in TS G by ZFMISC_1:87;
    then reconsider a1 = u, b1 = v as EnvEpsTerm of V;
    B2: In(u,TS G) = a1 & In(v,TS G) = b1;
    [a1,b1] in R by B1;
    then [eLam(x0,a1), eLam(x0,b1)] in R by Th44;
    hence thesis by B2;
  end;
  A2: for u,v being object st R reduces u,v holds R reduces F(u),F(v)
    from ENVEPS_2:sch 1(A1);
  assume A3: R reduces M,M1;
  A4: In(M,TS G) = M & In(M1,TS G) = M1;
  thus thesis by A2,A3,A4;
end;

