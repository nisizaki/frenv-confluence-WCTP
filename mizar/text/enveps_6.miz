      FUNCT_1, RELAT_1, FUNCOP_1, NAT_1, XCMPLX_1, SUBSET_1, FUNCT_2, XREAL_1,
      REWRITE1, XXREAL_0, ENVEPS_1, ENVEPS_2, ENVEPS_3, ENVEPS_4, ENVEPS_5;
 schemes DTCONSTR, NAT_1, ENVEPS_1, ENVEPS_2;

begin :: The beta reduction of lambda_EnvEps

definition
  let V be non empty set;
  let R be Relation of TS(EnvEpsGram(V));
  attr R is beta-closed means
  :Def1:
  (for M,N being EnvEpsTerm of V, x being Element of V holds
     [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in R) &
  (for M,N,L being EnvEpsTerm of V, x being Element of V holds
     [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in R) &
  (for M,N being EnvEpsTerm of V holds
     [eApp(eEps M,N), eComp(M,N)] in R) &
  (for M,M1,N being EnvEpsTerm of V st [M,M1] in R holds
     [eApp(M,N), eApp(M1,N)] in R) &
  (for M,N,N1 being EnvEpsTerm of V st [N,N1] in R holds
     [eApp(M,N), eApp(M,N1)] in R) &
  (for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in R holds
     [eLam(x,M), eLam(x,M1)] in R) &
  (for M,M1,N being EnvEpsTerm of V, x being Element of V st [M,M1] in R holds
     [eExt(M,x,N), eExt(M1,x,N)] in R) &
  (for M,N,N1 being EnvEpsTerm of V, x being Element of V st [N,N1] in R holds
     [eExt(M,x,N), eExt(M,x,N1)] in R) &
  (for M,M1,N being EnvEpsTerm of V st [M,M1] in R holds
     [eComp(M,N), eComp(M1,N)] in R) &
  (for M,N,N1 being EnvEpsTerm of V st [N,N1] in R holds
     [eComp(M,N), eComp(M,N1)] in R) &
  (for M,M1 being EnvEpsTerm of V st [M,M1] in R holds
     [eEps M, eEps M1] in R);
end;

registration
  let V be non empty set;
  cluster beta-closed for Relation of TS(EnvEpsGram(V));
  existence
  proof
    set G = EnvEpsGram(V);
    A0: [:TS G, TS G:] c= [:TS G, TS G:];
    reconsider R = [:TS G, TS G:] as Relation of TS G by A0;
    take R;
    A1: for a,b being EnvEpsTerm of V holds [a,b] in R by ZFMISC_1:87;
    thus for M,N being EnvEpsTerm of V, x being Element of V holds
      [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in R by A1;
    thus for M,N,L being EnvEpsTerm of V, x being Element of V holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in R by A1;
    thus for M,N being EnvEpsTerm of V holds
      [eApp(eEps M,N), eComp(M,N)] in R by A1;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in R holds
      [eApp(M,N), eApp(M1,N)] in R by A1;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in R holds
      [eApp(M,N), eApp(M,N1)] in R by A1;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in R
      holds
      [eLam(x,M), eLam(x,M1)] in R by A1;
    thus for M,M1,N being EnvEpsTerm of V, x being Element of V st [M,M1] in R
      holds
      [eExt(M,x,N), eExt(M1,x,N)] in R by A1;
    thus for M,N,N1 being EnvEpsTerm of V, x being Element of V st [N,N1] in R
      holds
      [eExt(M,x,N), eExt(M,x,N1)] in R by A1;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in R holds
      [eComp(M,N), eComp(M1,N)] in R by A1;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in R holds
      [eComp(M,N), eComp(M,N1)] in R by A1;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in R holds
      [eEps M, eEps M1] in R by A1;
  end;
end;

definition
  let V be non empty set;
  func BetaRed(V) -> Relation of TS(EnvEpsGram(V)) equals
  :Def2:
  { z where z is Element of [:TS(EnvEpsGram(V)),TS(EnvEpsGram(V)):] :
      for R being Relation of TS(EnvEpsGram(V)) st R is beta-closed
        holds z in R };
  coherence
  proof
    set G = EnvEpsGram(V);
    set D = [:TS G, TS G:];
    set S = { z where z is Element of D :
      for R being Relation of TS G st R is beta-closed holds z in R };
    S c= D
    proof
      let u be object;
      assume u in S;
      then ex z being Element of D st u = z &
        for R being Relation of TS G st R is beta-closed holds z in R;
      hence thesis;
    end;
    hence thesis;
  end;
end;

theorem Th1:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  ( [M,N] in BetaRed(V) iff
    for R being Relation of TS(EnvEpsGram(V)) st R is beta-closed
      holds [M,N] in R )
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  A1: [M,N] in D by ZFMISC_1:87;
  hereby
    assume [M,N] in BetaRed(V);
    then [M,N] in { z where z is Element of D :
      for R being Relation of TS G st R is beta-closed holds z in R }
      by Def2;
    then consider z being Element of D such that
    B1: [M,N] = z and
    B2: for R being Relation of TS G st R is beta-closed holds z in R;
    thus for R being Relation of TS G st R is beta-closed
      holds [M,N] in R by B1,B2;
  end;
  assume C1: for R being Relation of TS G st R is beta-closed
    holds [M,N] in R;
  reconsider z = [M,N] as Element of D by A1;
  z in { z2 where z2 is Element of D :
    for R being Relation of TS G st R is beta-closed holds z2 in R }
    by C1;
  hence thesis by Def2;
end;

theorem Th2:
  for V being non empty set, R being Relation of TS(EnvEpsGram(V))
  st R is beta-closed holds BetaRed(V) c= R
proof
  let V be non empty set, R be Relation of TS(EnvEpsGram(V));
  assume A1: R is beta-closed;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  now
    let u be object;
    assume u in BetaRed(V);
    then u in { z where z is Element of D :
      for Q being Relation of TS G st Q is beta-closed holds z in Q }
      by Def2;
    then consider z being Element of D such that
    B1: u = z and
    B2: for Q being Relation of TS G st Q is beta-closed holds z in Q;
    thus u in R by A1,B1,B2;
  end;
  hence thesis by TARSKI:def 3;
end;

registration
  let V be non empty set;
  cluster BetaRed(V) -> beta-closed;
  coherence
  proof
    set G = EnvEpsGram(V);
    thus for M,N being EnvEpsTerm of V, x being Element of V holds
      [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in BetaRed(V)
    proof
      let M,N be EnvEpsTerm of V, x be Element of V;
      now
        let R be Relation of TS G;
        assume R is beta-closed;
        hence [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in R by Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,N,L being EnvEpsTerm of V, x being Element of V holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in BetaRed(V)
    proof
      let M,N,L be EnvEpsTerm of V, x be Element of V;
      now
        let R be Relation of TS G;
        assume R is beta-closed;
        hence [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in R by Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,N being EnvEpsTerm of V holds
      [eApp(eEps M,N), eComp(M,N)] in BetaRed(V)
    proof
      let M,N be EnvEpsTerm of V;
      now
        let R be Relation of TS G;
        assume R is beta-closed;
        hence [eApp(eEps M,N), eComp(M,N)] in R by Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in BetaRed(V) holds
      [eApp(M,N), eApp(M1,N)] in BetaRed(V)
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume A0: [M,M1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [M,M1] in R by A0,Th1;
        hence [eApp(M,N), eApp(M1,N)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in BetaRed(V) holds
      [eApp(M,N), eApp(M,N1)] in BetaRed(V)
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume A0: [N,N1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [N,N1] in R by A0,Th1;
        hence [eApp(M,N), eApp(M,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in
      BetaRed(V) holds
      [eLam(x,M), eLam(x,M1)] in BetaRed(V)
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [M,M1] in R by A0,Th1;
        hence [eLam(x,M), eLam(x,M1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N being EnvEpsTerm of V, x being Element of V st [M,M1] in
      BetaRed(V) holds
      [eExt(M,x,N), eExt(M1,x,N)] in BetaRed(V)
    proof
      let M,M1,N be EnvEpsTerm of V, x be Element of V;
      assume A0: [M,M1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [M,M1] in R by A0,Th1;
        hence [eExt(M,x,N), eExt(M1,x,N)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,N,N1 being EnvEpsTerm of V, x being Element of V st [N,N1] in
      BetaRed(V) holds
      [eExt(M,x,N), eExt(M,x,N1)] in BetaRed(V)
    proof
      let M,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume A0: [N,N1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [N,N1] in R by A0,Th1;
        hence [eExt(M,x,N), eExt(M,x,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in BetaRed(V) holds
      [eComp(M,N), eComp(M1,N)] in BetaRed(V)
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume A0: [M,M1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [M,M1] in R by A0,Th1;
        hence [eComp(M,N), eComp(M1,N)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in BetaRed(V) holds
      [eComp(M,N), eComp(M,N1)] in BetaRed(V)
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume A0: [N,N1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [N,N1] in R by A0,Th1;
        hence [eComp(M,N), eComp(M,N1)] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in BetaRed(V) holds
      [eEps M, eEps M1] in BetaRed(V)
    proof
      let M,M1 be EnvEpsTerm of V;
      assume A0: [M,M1] in BetaRed(V);
      now
        let R be Relation of TS G;
        assume A1: R is beta-closed;
        then [M,M1] in R by A0,Th1;
        hence [eEps M, eEps M1] in R by A1,Def1;
      end;
      hence thesis by Th1;
    end;
  end;
end;

theorem Th3:
  for V being non empty set, P,Q being EnvEpsTerm of V
  st [P,Q] in BetaRed(V) holds
  ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st P =
    eApp(eLam(x2,M2),N2) & Q = eComp(M2,eExt(N2,x2,eId V)) ) or
  ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st P =
    eApp(eComp(eLam(x2,M2),L2),N2) & Q = eComp(M2,eExt(N2,x2,L2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V st P = eApp(eEps M2,N2) & Q = eComp(M2,N2)
    ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & P =
    eApp(M2,N2) & Q = eApp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & P =
    eApp(M2,N2) & Q = eApp(M2,N3) ) or
  ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    BetaRed(V) & P = eLam(x2,M2) & Q = eLam(x2,M3) ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    BetaRed(V) & P = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
    BetaRed(V) & P = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & P =
    eComp(M2,N2) & Q = eComp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & P =
    eComp(M2,N2) & Q = eComp(M2,N3) ) or
  ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & P = eEps M2 & Q
    = eEps M3 )
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  set R = BetaRed(V);
  defpred D[object,object] means
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st $1 =
      eApp(eLam(x2,M2),N2) & $2 = eComp(M2,eExt(N2,x2,eId V)) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st $1 =
      eApp(eComp(eLam(x2,M2),L2),N2) & $2 = eComp(M2,eExt(N2,x2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st $1 = eApp(eEps M2,N2) & $2 =
      eComp(M2,N2) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & $1 =
      eApp(M2,N2) & $2 = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & $1 =
      eApp(M2,N2) & $2 = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & $1 = eLam(x2,M2) & $2 = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      BetaRed(V) & $1 = eExt(M2,x2,N2) & $2 = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      BetaRed(V) & $1 = eExt(M2,x2,N2) & $2 = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & $1 =
      eComp(M2,N2) & $2 = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) & $1 =
      eComp(M2,N2) & $2 = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & $1 = eEps M2 &
      $2 = eEps M3 );
  set S = { z where z is Element of [:TS G, TS G:] :
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] };
  A1: S c= [:TS G, TS G:]
  proof
    let u be object;
    assume u in S;
    then ex z being Element of [:TS G, TS G:] st u = z &
      ( z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] );
    hence thesis;
  end;
  reconsider S1 = S as Relation of TS G by A1;
  A2: for a,b being EnvEpsTerm of V holds
    ( [a,b] in S1 iff ( [a,b] in R & D[a,b] ) )
  proof
    let a,b be EnvEpsTerm of V;
    hereby
      assume [a,b] in S1;
      then consider z being Element of [:TS G, TS G:] such that
      B1: [a,b] = z and
      B2: z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q];
      consider P,Q being EnvEpsTerm of V such that
      B3: z = [P,Q] & D[P,Q] by B2;
      a = P & b = Q by B1,B3,XTUPLE_0:1;
      hence [a,b] in R & D[a,b] by B1,B2,B3;
    end;
    assume C1: [a,b] in R & D[a,b];
    C2: [a,b] in [:TS G, TS G:] by ZFMISC_1:87;
    then reconsider z = [a,b] as Element of [:TS G, TS G:];
    z in R & ex P,Q being EnvEpsTerm of V st z = [P,Q] & D[P,Q] by C1;
    hence thesis;
  end;
  A3: S1 is beta-closed
  proof
    thus for M,N being EnvEpsTerm of V, x being Element of V holds
      [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in S1
    proof
      let M,N be EnvEpsTerm of V, x be Element of V;
      G2: [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in R by Def1;
      G3: ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st
        eApp(eLam(x,M),N) = eApp(eLam(x2,M2),N2) & eComp(M,eExt(N,x,eId V)) =
        eComp(M2,eExt(N2,x2,eId V))
      proof
        take M,N,x;
        thus thesis;
      end;
      G4: D[eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,L being EnvEpsTerm of V, x being Element of V holds
      [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in S1
    proof
      let M,N,L be EnvEpsTerm of V, x be Element of V;
      G2: [eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] in R by Def1;
      G3: ex M2,N2,L2 being EnvEpsTerm of V, x2 being Element of V st
        eApp(eComp(eLam(x,M),L),N) = eApp(eComp(eLam(x2,M2),L2),N2) &
        eComp(M,eExt(N,x,L)) = eComp(M2,eExt(N2,x2,L2))
      proof
        take M,N,L,x;
        thus thesis;
      end;
      G4: D[eApp(eComp(eLam(x,M),L),N), eComp(M,eExt(N,x,L))] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N being EnvEpsTerm of V holds
      [eApp(eEps M,N), eComp(M,N)] in S1
    proof
      let M,N be EnvEpsTerm of V;
      G2: [eApp(eEps M,N), eComp(M,N)] in R by Def1;
      G3: ex M2,N2 being EnvEpsTerm of V st eApp(eEps M,N) = eApp(eEps M2,N2)
        & eComp(M,N) = eComp(M2,N2)
      proof
        take M,N;
        thus thesis;
      end;
      G4: D[eApp(eEps M,N), eComp(M,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in S1 holds
      [eApp(M,N), eApp(M1,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eApp(M,N), eApp(M1,N)] in R by G1,Def1;
      G3: ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
        eApp(M,N) = eApp(M2,N2) & eApp(M1,N) = eApp(M3,N2)
      proof
        take M,M1,N;
        thus thesis by G1;
      end;
      G4: D[eApp(M,N), eApp(M1,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in S1 holds
      [eApp(M,N), eApp(M,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eApp(M,N), eApp(M,N1)] in R by G1,Def1;
      G3: ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
        eApp(M,N) = eApp(M2,N2) & eApp(M,N1) = eApp(M2,N3)
      proof
        take M,N,N1;
        thus thesis by G1;
      end;
      G4: D[eApp(M,N), eApp(M,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V st [M,M1] in S1
      holds
      [eLam(x,M), eLam(x,M1)] in S1
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eLam(x,M), eLam(x,M1)] in R by G1,Def1;
      G3: ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
        BetaRed(V) & eLam(x,M) = eLam(x2,M2) & eLam(x,M1) = eLam(x2,M3)
      proof
        take M,M1,x;
        thus thesis by G1;
      end;
      G4: D[eLam(x,M), eLam(x,M1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V, x being Element of V st [M,M1] in
      S1 holds
      [eExt(M,x,N), eExt(M1,x,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V, x be Element of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eExt(M,x,N), eExt(M1,x,N)] in R by G1,Def1;
      G3: ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
        in BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & eExt(M1,x,N) =
        eExt(M3,x2,N2)
      proof
        take M,M1,N,x;
        thus thesis by G1;
      end;
      G4: D[eExt(M,x,N), eExt(M1,x,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V, x being Element of V st [N,N1] in
      S1 holds
      [eExt(M,x,N), eExt(M,x,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eExt(M,x,N), eExt(M,x,N1)] in R by G1,Def1;
      G3: ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
        in BetaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & eExt(M,x,N1) =
        eExt(M2,x2,N3)
      proof
        take M,N,N1,x;
        thus thesis by G1;
      end;
      G4: D[eExt(M,x,N), eExt(M,x,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in S1 holds
      [eComp(M,N), eComp(M1,N)] in S1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eComp(M,N), eComp(M1,N)] in R by G1,Def1;
      G3: ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) &
        eComp(M,N) = eComp(M2,N2) & eComp(M1,N) = eComp(M3,N2)
      proof
        take M,M1,N;
        thus thesis by G1;
      end;
      G4: D[eComp(M,N), eComp(M1,N)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in S1 holds
      [eComp(M,N), eComp(M,N1)] in S1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume G0: [N,N1] in S1;
      then G1: [N,N1] in R by A2;
      G2: [eComp(M,N), eComp(M,N1)] in R by G1,Def1;
      G3: ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in BetaRed(V) &
        eComp(M,N) = eComp(M2,N2) & eComp(M,N1) = eComp(M2,N3)
      proof
        take M,N,N1;
        thus thesis by G1;
      end;
      G4: D[eComp(M,N), eComp(M,N1)] by G3;
      thus thesis by A2,G2,G4;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in S1 holds
      [eEps M, eEps M1] in S1
    proof
      let M,M1 be EnvEpsTerm of V;
      assume G0: [M,M1] in S1;
      then G1: [M,M1] in R by A2;
      G2: [eEps M, eEps M1] in R by G1,Def1;
      G3: ex M2,M3 being EnvEpsTerm of V st [M2,M3] in BetaRed(V) & eEps M =
        eEps M2 & eEps M1 = eEps M3
      proof
        take M,M1;
        thus thesis by G1;
      end;
      G4: D[eEps M, eEps M1] by G3;
      thus thesis by A2,G2,G4;
    end;
  end;
  A4: R c= S1 by A3,Th2;
  let P,Q be EnvEpsTerm of V;
  assume [P,Q] in R;
  then [P,Q] in S1 by A4;
  hence thesis by A2;
end;

theorem Th4:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [eApp(eLam(x,M),N), eComp(M,eExt(N,x,eId V))] in BetaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  thus thesis by Def1;
end;

