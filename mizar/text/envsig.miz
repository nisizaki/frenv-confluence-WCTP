:: The sigma reduction of lambda_EnvEps

::  The eight computation rules are given once, as the relation SigmaRoot(V);
::  the reduction itself is their compatible closure.  Everything else in this
::  article -- the sixteen named rules, the inversion lemma, inversion by head
::  constructor, the multi-step congruences -- follows from ENVCC, where the
::  general theory of the compatible closure is developed.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, FINSEQ_1,
      RELAT_1, FUNCT_1, ORDINAL1, CARD_1, ARYTM_3, XXREAL_0, NAT_1, TREES_1,
      TREES_2, TREES_3, TREES_4, LANG1, STRUCT_0, DTCONSTR, MCART_1, XTUPLE_0,
      FINSET_1, TDGROUP, FUNCOP_1, ARYTM_1, FUNCT_7, XREAL_0, XCMPLX_0,
      REWRITE1, PBOOLE, ENVSYN, ENVLEN, ENVCC, ENVSIG;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2, TREES_3,
      TREES_4, DTCONSTR, FUNCOP_1, XREAL_0, PBOOLE, REWRITE1, ENVSYN, ENVLEN,
      ENVCC;
 constructors NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, PARTFUN1, BINOP_1, SETWISEO, XREAL_0,
      FUNCOP_1, SUBSET_1, CARD_3, FINSEQOP, FINSEQ_4, FINSOP_1, PRE_POLY,
      FUNCT_1, RELAT_1, PBOOLE, REWRITE1, ENVSYN, ENVLEN, ENVCC;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, XTUPLE_0, VALUED_0, FUNCOP_1, XCMPLX_0,
      XXREAL_0, NUMBERS, MEMBERED, PBOOLE, REWRITE1, ENVSYN;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, SUBSET_1, REWRITE1, ENVSYN, ENVCC;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, ZFMISC_1, XTUPLE_0, RELAT_1, REWRITE1,
      NAT_1, XXREAL_0, XREAL_1, ENVSYN, ENVLEN, ENVCC;
 schemes NAT_1, ENVSYN;

begin :: The eight computation rules

reserve V for non empty set;

definition
  let V be non empty set;
  func SigmaRoot(V) -> EnvEpsRel of V equals
  :Def1:
  { z where z is Element of [:TS(EnvEpsGram(V)),TS(EnvEpsGram(V)):] :
      ex P,S being EnvEpsTerm of V st z = [P,S] &
      (
        ( ex A,B,C being EnvEpsTerm of V st
            P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
        ( ex A being EnvEpsTerm of V st
            P = (eId V) (o) A & S = A ) or
        ( ex A being EnvEpsTerm of V st
            P = A (o) (eId V) & S = A ) or
        ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
            P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
        ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
            P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
        ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
            x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
            ) or
        ( ex A,B,C being EnvEpsTerm of V st
            P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
        ( ex A,B being EnvEpsTerm of V st
            P = (eEps A) (o) B & S = eEps A ) ) };
  coherence
  proof
    set G = EnvEpsGram(V);
    set D = [:TS G, TS G:];
    set S0 = { z where z is Element of D :
      ex P,S being EnvEpsTerm of V st z = [P,S] &
      (
        ( ex A,B,C being EnvEpsTerm of V st
            P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
        ( ex A being EnvEpsTerm of V st
            P = (eId V) (o) A & S = A ) or
        ( ex A being EnvEpsTerm of V st
            P = A (o) (eId V) & S = A ) or
        ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
            P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
        ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
            P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
        ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
            x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
            ) or
        ( ex A,B,C being EnvEpsTerm of V st
            P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
        ( ex A,B being EnvEpsTerm of V st
            P = (eEps A) (o) B & S = eEps A ) ) };
    S0 c= D
    proof
      let u be object;
      assume u in S0;
      then ex z being Element of D st u = z &
        ex P,S being EnvEpsTerm of V st z = [P,S] &
        (
          ( ex A,B,C being EnvEpsTerm of V st
              P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
          ( ex A being EnvEpsTerm of V st
              P = (eId V) (o) A & S = A ) or
          ( ex A being EnvEpsTerm of V st
              P = A (o) (eId V) & S = A ) or
          ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
              P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
          ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
              P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
          ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
              x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
              B ) or
          ( ex A,B,C being EnvEpsTerm of V st
              P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
          ( ex A,B being EnvEpsTerm of V st
              P = (eEps A) (o) B & S = eEps A ) );
      hence thesis;
    end;
    hence thesis;
  end;
end;

theorem Th1:
  for V being non empty set, P,S being EnvEpsTerm of V holds
  ( [P,S] in SigmaRoot(V) iff
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        P = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        P = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        P = (eEps A) (o) B & S = eEps A ) )
proof
  let V be non empty set, P,S be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  A0: [P,S] in D by ZFMISC_1:87;
  hereby
    assume [P,S] in SigmaRoot(V);
    then [P,S] in { z where z is Element of D :
      ex P2,S2 being EnvEpsTerm of V st z = [P2,S2] &
      (
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (o) B) (o) C & S2 = A (o) (B (o) C) ) or
        ( ex A being EnvEpsTerm of V st
            P2 = (eId V) (o) A & S2 = A ) or
        ( ex A being EnvEpsTerm of V st
            P2 = A (o) (eId V) & S2 = A ) or
        ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = eExt(C,x0,A) (o) B & S2 = eExt(C (o) B, x0, A (o) B) ) or
        ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = (eVar x0) (o) eExt(A,x0,B) & S2 = A ) or
        ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
            x0 <> y0 & P2 = (eVar x0) (o) eExt(A,y0,B) & S2 = (eVar x0) (o)
            B ) or
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (@) B) (o) C & S2 = (A (o) C) (@) (B (o) C) ) or
        ( ex A,B being EnvEpsTerm of V st
            P2 = (eEps A) (o) B & S2 = eEps A ) ) } by Def1;
    then consider z being Element of D such that
    B1: [P,S] = z and
    B2:
      ex P2,S2 being EnvEpsTerm of V st z = [P2,S2] &
      (
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (o) B) (o) C & S2 = A (o) (B (o) C) ) or
        ( ex A being EnvEpsTerm of V st
            P2 = (eId V) (o) A & S2 = A ) or
        ( ex A being EnvEpsTerm of V st
            P2 = A (o) (eId V) & S2 = A ) or
        ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = eExt(C,x0,A) (o) B & S2 = eExt(C (o) B, x0, A (o) B) ) or
        ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = (eVar x0) (o) eExt(A,x0,B) & S2 = A ) or
        ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
            x0 <> y0 & P2 = (eVar x0) (o) eExt(A,y0,B) & S2 = (eVar x0) (o)
            B ) or
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (@) B) (o) C & S2 = (A (o) C) (@) (B (o) C) ) or
        ( ex A,B being EnvEpsTerm of V st
            P2 = (eEps A) (o) B & S2 = eEps A ) );
    consider P2,S2 being EnvEpsTerm of V such that
    B3: z = [P2,S2] &
    (
      ( ex A,B,C being EnvEpsTerm of V st
          P2 = (A (o) B) (o) C & S2 = A (o) (B (o) C) ) or
      ( ex A being EnvEpsTerm of V st
          P2 = (eId V) (o) A & S2 = A ) or
      ( ex A being EnvEpsTerm of V st
          P2 = A (o) (eId V) & S2 = A ) or
      ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
          P2 = eExt(C,x0,A) (o) B & S2 = eExt(C (o) B, x0, A (o) B) ) or
      ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
          P2 = (eVar x0) (o) eExt(A,x0,B) & S2 = A ) or
      ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
          x0 <> y0 & P2 = (eVar x0) (o) eExt(A,y0,B) & S2 = (eVar x0) (o) B
          ) or
      ( ex A,B,C being EnvEpsTerm of V st
          P2 = (A (@) B) (o) C & S2 = (A (o) C) (@) (B (o) C) ) or
      ( ex A,B being EnvEpsTerm of V st
          P2 = (eEps A) (o) B & S2 = eEps A ) ) by B2;
    B4: P = P2 & S = S2 by B1,B3,XTUPLE_0:1;
    thus
      ( ex A,B,C being EnvEpsTerm of V st
          P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
      ( ex A being EnvEpsTerm of V st
          P = (eId V) (o) A & S = A ) or
      ( ex A being EnvEpsTerm of V st
          P = A (o) (eId V) & S = A ) or
      ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
          P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
      ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
          P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
      ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
          x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B ) or
      ( ex A,B,C being EnvEpsTerm of V st
          P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
      ( ex A,B being EnvEpsTerm of V st
          P = (eEps A) (o) B & S = eEps A ) by B3,B4;
  end;
  assume C1:
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        P = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        P = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        P = (eEps A) (o) B & S = eEps A );
  reconsider z = [P,S] as Element of D by A0;
  C2:
    ex P2,S2 being EnvEpsTerm of V st z = [P2,S2] &
    (
      ( ex A,B,C being EnvEpsTerm of V st
          P2 = (A (o) B) (o) C & S2 = A (o) (B (o) C) ) or
      ( ex A being EnvEpsTerm of V st
          P2 = (eId V) (o) A & S2 = A ) or
      ( ex A being EnvEpsTerm of V st
          P2 = A (o) (eId V) & S2 = A ) or
      ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
          P2 = eExt(C,x0,A) (o) B & S2 = eExt(C (o) B, x0, A (o) B) ) or
      ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
          P2 = (eVar x0) (o) eExt(A,x0,B) & S2 = A ) or
      ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
          x0 <> y0 & P2 = (eVar x0) (o) eExt(A,y0,B) & S2 = (eVar x0) (o) B
          ) or
      ( ex A,B,C being EnvEpsTerm of V st
          P2 = (A (@) B) (o) C & S2 = (A (o) C) (@) (B (o) C) ) or
      ( ex A,B being EnvEpsTerm of V st
          P2 = (eEps A) (o) B & S2 = eEps A ) ) by C1;
  z in { z2 where z2 is Element of D :
      ex P2,S2 being EnvEpsTerm of V st z2 = [P2,S2] &
      (
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (o) B) (o) C & S2 = A (o) (B (o) C) ) or
        ( ex A being EnvEpsTerm of V st
            P2 = (eId V) (o) A & S2 = A ) or
        ( ex A being EnvEpsTerm of V st
            P2 = A (o) (eId V) & S2 = A ) or
        ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = eExt(C,x0,A) (o) B & S2 = eExt(C (o) B, x0, A (o) B) ) or
        ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
            P2 = (eVar x0) (o) eExt(A,x0,B) & S2 = A ) or
        ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
            x0 <> y0 & P2 = (eVar x0) (o) eExt(A,y0,B) & S2 = (eVar x0) (o)
            B ) or
        ( ex A,B,C being EnvEpsTerm of V st
            P2 = (A (@) B) (o) C & S2 = (A (o) C) (@) (B (o) C) ) or
        ( ex A,B being EnvEpsTerm of V st
            P2 = (eEps A) (o) B & S2 = eEps A ) ) } by C2;
  hence thesis by Def1;
end;

:: assoc
theorem Th2:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [(M (o) N) (o) L, M (o) (N (o) L)] in SigmaRoot(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  A1: ( ex A,B,C being EnvEpsTerm of V st
      (M (o) N) (o) L = (A (o) B) (o) C & M (o) (N (o) L) = A (o) (B (o) C)
      )
  proof
    take M,N,L;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: idL
theorem Th3:
  for V being non empty set, M being EnvEpsTerm of V holds
  [(eId V) (o) M, M] in SigmaRoot(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: ( ex A being EnvEpsTerm of V st
      (eId V) (o) M = (eId V) (o) A & M = A )
  proof
    take M;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: idR
theorem Th4:
  for V being non empty set, M being EnvEpsTerm of V holds
  [M (o) (eId V), M] in SigmaRoot(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: ( ex A being EnvEpsTerm of V st
      M (o) (eId V) = A (o) (eId V) & M = A )
  proof
    take M;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: dExt
theorem Th5:
  for V being non empty set, L,M,N being EnvEpsTerm of V, x being Element of
    V holds
  [eExt(L,x,M) (o) N, eExt(L (o) N, x, M (o) N)] in SigmaRoot(V)
proof
  let V be non empty set, L,M,N be EnvEpsTerm of V, x be Element of V;
  A1: ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
      eExt(L,x,M) (o) N = eExt(C,x0,A) (o) B & eExt(L (o) N, x, M (o) N) =
      eExt(C (o) B, x0, A (o) B) )
  proof
    take L,M,N,x;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: varRef
theorem Th6:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [(eVar x) (o) eExt(M,x,N), M] in SigmaRoot(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  A1: ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
      (eVar x) (o) eExt(M,x,N) = (eVar x0) (o) eExt(A,x0,B) & M = A )
  proof
    take M,N,x;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: varSkip
theorem Th7:
  for V being non empty set, M,N being EnvEpsTerm of V, x,y being Element of
    V st x <> y holds
  [(eVar x) (o) eExt(M,y,N), (eVar x) (o) N] in SigmaRoot(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x,y be Element of V;
  assume A0: x <> y;
  A1: ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
      x0 <> y0 & (eVar x) (o) eExt(M,y,N) = (eVar x0) (o) eExt(A,y0,B) &
      (eVar x) (o) N = (eVar x0) (o) B )
  proof
    take M,N,x,y;
    thus thesis by A0;
  end;
  thus thesis by A1,Th1;
end;

:: dApp
theorem Th8:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [(M (@) N) (o) L, (M (o) L) (@) (N (o) L)] in SigmaRoot(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  A1: ( ex A,B,C being EnvEpsTerm of V st
      (M (@) N) (o) L = (A (@) B) (o) C & (M (o) L) (@) (N (o) L) = (A (o)
      C) (@) (B (o) C) )
  proof
    take M,N,L;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

:: epsEps
theorem Th9:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  [(eEps M) (o) N, eEps M] in SigmaRoot(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  A1: ( ex A,B being EnvEpsTerm of V st
      (eEps M) (o) N = (eEps A) (o) B & eEps M = eEps A )
  proof
    take M,N;
    thus thesis;
  end;
  thus thesis by A1,Th1;
end;

begin :: The sigma reduction

definition
  let V be non empty set;
  func SigmaRed(V) -> EnvEpsRel of V equals
  :Def2:
  CC SigmaRoot(V);
  coherence;
end;

begin :: The sixteen rules

:: assoc
theorem Th10:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [(M (o) N) (o) L, M (o) (N (o) L)] in SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  A1: [(M (o) N) (o) L, M (o) (N (o) L)] in SigmaRoot(V) by Th2;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: idL
theorem Th11:
  for V being non empty set, M being EnvEpsTerm of V holds
  [(eId V) (o) M, M] in SigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: [(eId V) (o) M, M] in SigmaRoot(V) by Th3;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: idR
theorem Th12:
  for V being non empty set, M being EnvEpsTerm of V holds
  [M (o) (eId V), M] in SigmaRed(V)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  A1: [M (o) (eId V), M] in SigmaRoot(V) by Th4;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: dExt
theorem Th13:
  for V being non empty set, L,M,N being EnvEpsTerm of V, x being Element of
    V holds
  [eExt(L,x,M) (o) N, eExt(L (o) N, x, M (o) N)] in SigmaRed(V)
proof
  let V be non empty set, L,M,N be EnvEpsTerm of V, x be Element of V;
  A1: [eExt(L,x,M) (o) N, eExt(L (o) N, x, M (o) N)] in SigmaRoot(V) by Th5;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: varRef
theorem Th14:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V
    holds
  [(eVar x) (o) eExt(M,x,N), M] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  A1: [(eVar x) (o) eExt(M,x,N), M] in SigmaRoot(V) by Th6;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: varSkip
theorem Th15:
  for V being non empty set, M,N being EnvEpsTerm of V, x,y being Element of
    V st x <> y holds
  [(eVar x) (o) eExt(M,y,N), (eVar x) (o) N] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x,y be Element of V;
  assume A0: x <> y;
  A1: [(eVar x) (o) eExt(M,y,N), (eVar x) (o) N] in SigmaRoot(V) by A0,Th7;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: dApp
theorem Th16:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  [(M (@) N) (o) L, (M (o) L) (@) (N (o) L)] in SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  A1: [(M (@) N) (o) L, (M (o) L) (@) (N (o) L)] in SigmaRoot(V) by Th8;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

:: epsEps
theorem Th17:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  [(eEps M) (o) N, eEps M] in SigmaRed(V)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  A1: [(eEps M) (o) N, eEps M] in SigmaRoot(V) by Th9;
  SigmaRoot(V) c= CC SigmaRoot(V) by ENVCC:4;
  hence thesis by A1,Def2;
end;

theorem Th18:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [M (@) N, M1 (@) N] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume [M,M1] in SigmaRed(V);
  then [M,M1] in CC SigmaRoot(V) by Def2;
  then [M (@) N, M1 (@) N] in CC SigmaRoot(V) by ENVCC:5;
  hence thesis by Def2;
end;

theorem Th19:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    SigmaRed(V) holds
  [M (@) N, M (@) N1] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume [N,N1] in SigmaRed(V);
  then [N,N1] in CC SigmaRoot(V) by Def2;
  then [M (@) N, M (@) N1] in CC SigmaRoot(V) by ENVCC:6;
  hence thesis by Def2;
end;

theorem Th20:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of
    V st [M,M1] in SigmaRed(V) holds
  [eLam(x,M), eLam(x,M1)] in SigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume [M,M1] in SigmaRed(V);
  then [M,M1] in CC SigmaRoot(V) by Def2;
  then [eLam(x,M), eLam(x,M1)] in CC SigmaRoot(V) by ENVCC:7;
  hence thesis by Def2;
end;

theorem Th21:
  for V being non empty set, M,M1,N being EnvEpsTerm of V, x being Element
    of V st [M,M1] in SigmaRed(V) holds
  [eExt(M,x,N), eExt(M1,x,N)] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x be Element of V;
  assume [M,M1] in SigmaRed(V);
  then [M,M1] in CC SigmaRoot(V) by Def2;
  then [eExt(M,x,N), eExt(M1,x,N)] in CC SigmaRoot(V) by ENVCC:8;
  hence thesis by Def2;
end;

theorem Th22:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V, x being Element
    of V st [N,N1] in SigmaRed(V) holds
  [eExt(M,x,N), eExt(M,x,N1)] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume [N,N1] in SigmaRed(V);
  then [N,N1] in CC SigmaRoot(V) by Def2;
  then [eExt(M,x,N), eExt(M,x,N1)] in CC SigmaRoot(V) by ENVCC:9;
  hence thesis by Def2;
end;

theorem Th23:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [M (o) N, M1 (o) N] in SigmaRed(V)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume [M,M1] in SigmaRed(V);
  then [M,M1] in CC SigmaRoot(V) by Def2;
  then [M (o) N, M1 (o) N] in CC SigmaRoot(V) by ENVCC:10;
  hence thesis by Def2;
end;

theorem Th24:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st [N,N1] in
    SigmaRed(V) holds
  [M (o) N, M (o) N1] in SigmaRed(V)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume [N,N1] in SigmaRed(V);
  then [N,N1] in CC SigmaRoot(V) by Def2;
  then [M (o) N, M (o) N1] in CC SigmaRoot(V) by ENVCC:11;
  hence thesis by Def2;
end;

theorem Th25:
  for V being non empty set, M,M1 being EnvEpsTerm of V st [M,M1] in
    SigmaRed(V) holds
  [eEps M, eEps M1] in SigmaRed(V)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  assume [M,M1] in SigmaRed(V);
  then [M,M1] in CC SigmaRoot(V) by Def2;
  then [eEps M, eEps M1] in CC SigmaRoot(V) by ENVCC:12;
  hence thesis by Def2;
end;

begin :: Inversion

theorem Th26:
  for V being non empty set, P,S being EnvEpsTerm of V
  st [P,S] in SigmaRed(V) holds
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        P = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        P = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        P = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        P = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        P = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        P = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        P = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        P = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        P = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        P = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        P = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        P = eEps A & S = eEps A1 )
proof
  let V be non empty set, P,S be EnvEpsTerm of V;
  assume [P,S] in SigmaRed(V);
  then A1: [P,S] in CC SigmaRoot(V) by Def2;
  A2: [P,S] in SigmaRoot(V) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) & P = A
      (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in CC SigmaRoot(V) & P = A
      (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in CC
      SigmaRoot(V) & P = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in CC
      SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in CC
      SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) & P = A
      (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in CC SigmaRoot(V) & P = A
      (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) & P = eEps
      A & S = eEps A1 ) by A1,ENVCC:13;
  per cases by A2;
  suppose [P,S] in SigmaRoot(V);
    hence thesis by Th1;
  end;
  suppose B1: ex A,A1,B being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) &
    P = A (@) B & S = A1 (@) B;
    then consider A,A1,B being EnvEpsTerm of V such that
    B2: [A,A1] in CC SigmaRoot(V) & P = A (@) B & S = A1 (@) B;
    B3: [A,A1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) & P = A
      (@) B & S = A1 (@) B )
    proof
      take A,A1,B;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,B,B1 being EnvEpsTerm of V st [B,B1] in CC SigmaRoot(V) &
    P = A (@) B & S = A (@) B1;
    then consider A,B,B1 being EnvEpsTerm of V such that
    B2: [B,B1] in CC SigmaRoot(V) & P = A (@) B & S = A (@) B1;
    B3: [B,B1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) & P = A
      (@) B & S = A (@) B1 )
    proof
      take A,B,B1;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1]
    in CC SigmaRoot(V) & P = eLam(x0,A) & S = eLam(x0,A1);
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    B2: [A,A1] in CC SigmaRoot(V) & P = eLam(x0,A) & S = eLam(x0,A1);
    B3: [A,A1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
      SigmaRed(V) & P = eLam(x0,A) & S = eLam(x0,A1) )
    proof
      take A,A1,x0;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st
    [A,A1] in CC SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A1,x0,B);
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    B2: [A,A1] in CC SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A1,x0,B);
    B3: [A,A1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1]
      in SigmaRed(V) & P = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    proof
      take A,A1,B,x0;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st
    [B,B1] in CC SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A,x0,B1);
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    B2: [B,B1] in CC SigmaRoot(V) & P = eExt(A,x0,B) & S = eExt(A,x0,B1);
    B3: [B,B1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1]
      in SigmaRed(V) & P = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    proof
      take A,B,B1,x0;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,A1,B being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) &
    P = A (o) B & S = A1 (o) B;
    then consider A,A1,B being EnvEpsTerm of V such that
    B2: [A,A1] in CC SigmaRoot(V) & P = A (o) B & S = A1 (o) B;
    B3: [A,A1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) & P = A
      (o) B & S = A1 (o) B )
    proof
      take A,A1,B;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,B,B1 being EnvEpsTerm of V st [B,B1] in CC SigmaRoot(V) &
    P = A (o) B & S = A (o) B1;
    then consider A,B,B1 being EnvEpsTerm of V such that
    B2: [B,B1] in CC SigmaRoot(V) & P = A (o) B & S = A (o) B1;
    B3: [B,B1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) & P = A
      (o) B & S = A (o) B1 )
    proof
      take A,B,B1;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
  suppose B1: ex A,A1 being EnvEpsTerm of V st [A,A1] in CC SigmaRoot(V) & P
    = eEps A & S = eEps A1;
    then consider A,A1 being EnvEpsTerm of V such that
    B2: [A,A1] in CC SigmaRoot(V) & P = eEps A & S = eEps A1;
    B3: [A,A1] in SigmaRed(V) by B2,Def2;
    B4: ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) & P = eEps
      A & S = eEps A1 )
    proof
      take A,A1;
      thus thesis by B2,B3;
    end;
    thus thesis by B4;
  end;
end;

begin :: Inversion by the head constructor

theorem Th27:
  for V being non empty set, x being Element of V, S being EnvEpsTerm of V
    holds
  not [eVar x,S] in SigmaRed(V)
proof
  let V be non empty set, x be Element of V, S be EnvEpsTerm of V;
  assume [eVar x,S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        eVar x = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        eVar x = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        eVar x = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eVar x = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eVar x = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eVar x = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        ) or
    ( ex A,B,C being EnvEpsTerm of V st
        eVar x = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        eVar x = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eVar x = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eVar x = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eVar x = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eVar x = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eVar x = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eVar x = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eVar x = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eVar x = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eVar x = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eVar x = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eVar x = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eVar x = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: eVar x = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eVar x = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: eVar x = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eVar x = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & eVar x = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
      B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eVar x = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eVar x = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        eVar x = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: eVar x = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eVar x = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eVar x = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eVar x = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eVar x = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eVar x = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eVar x = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eVar x = eExt(A,x0,B) & S = eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eVar x = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & eVar x = eExt(A,x0,B) & S = eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eVar x = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eVar x = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eVar x = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eVar x = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eVar x = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

theorem Th28:
  for V being non empty set, S being EnvEpsTerm of V holds
  not [eId V,S] in SigmaRed(V)
proof
  let V be non empty set, S be EnvEpsTerm of V;
  assume [eId V,S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        eId V = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        eId V = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        eId V = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eId V = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eId V = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eId V = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        ) or
    ( ex A,B,C being EnvEpsTerm of V st
        eId V = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        eId V = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eId V = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eId V = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eId V = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eId V = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eId V = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eId V = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eId V = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eId V = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eId V = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eId V = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eId V = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eId V = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: eId V = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eId V = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: eId V = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eId V = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & eId V = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eId V = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eId V = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        eId V = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: eId V = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eId V = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eId V = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eId V = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eId V = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eId V = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eId V = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eId V = eExt(A,x0,B) & S = eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eId V = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & eId V = eExt(A,x0,B) & S = eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eId V = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eId V = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eId V = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eId V = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eId V = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

theorem Th29:
  for V being non empty set, M being EnvEpsTerm of V, x being Element of V,
    S being EnvEpsTerm of V st [eLam(x,M),S] in SigmaRed(V) holds
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eLam(x,M) = eLam(x0,A) & S = eLam(x0,A1) )
proof
  let V be non empty set, M be EnvEpsTerm of V, x be Element of V, S be
    EnvEpsTerm of V;
  assume [eLam(x,M),S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        eLam(x,M) = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        eLam(x,M) = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        eLam(x,M) = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eLam(x,M) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eLam(x,M) = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eLam(x,M) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
        (o) B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        eLam(x,M) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        eLam(x,M) = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eLam(x,M) = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eLam(x,M) = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eLam(x,M) = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eLam(x,M) = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eLam(x,M) = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eLam(x,M) = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eLam(x,M) = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eLam(x,M) = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eLam(x,M) = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eLam(x,M) = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eLam(x,M) = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eLam(x,M) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: eLam(x,M) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eLam(x,M) = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: eLam(x,M) = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eLam(x,M) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
        (o) B )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & eLam(x,M) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
      (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eLam(x,M) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eLam(x,M) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        eLam(x,M) = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: eLam(x,M) = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eLam(x,M) = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eLam(x,M) = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eLam(x,M) = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose B1:
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eLam(x,M) = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    thus thesis by B1;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eLam(x,M) = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eLam(x,M) = eExt(A,x0,B) & S =
      eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eLam(x,M) = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & eLam(x,M) = eExt(A,x0,B) & S =
      eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eLam(x,M) = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eLam(x,M) = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eLam(x,M) = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eLam(x,M) = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eLam(x,M) = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

theorem Th30:
  for V being non empty set, M being EnvEpsTerm of V, S being EnvEpsTerm of
    V st [eEps M,S] in SigmaRed(V) holds
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = eEps A & S = eEps A1 )
proof
  let V be non empty set, M be EnvEpsTerm of V, S be EnvEpsTerm of V;
  assume [eEps M,S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        eEps M = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        eEps M = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        eEps M = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eEps M = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eEps M = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eEps M = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        ) or
    ( ex A,B,C being EnvEpsTerm of V st
        eEps M = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        eEps M = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eEps M = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eEps M = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eEps M = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eEps M = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eEps M = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eEps M = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eEps M = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eEps M = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eEps M = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eEps M = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eEps M = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eEps M = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: eEps M = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eEps M = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: eEps M = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eEps M = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o) B
        )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & eEps M = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
      B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eEps M = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eEps M = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        eEps M = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: eEps M = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eEps M = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eEps M = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eEps M = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eEps M = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eEps M = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eEps M = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eEps M = eExt(A,x0,B) & S = eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eEps M = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & eEps M = eExt(A,x0,B) & S = eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eEps M = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eEps M = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eEps M = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose B1:
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eEps M = eEps A & S = eEps A1 )
    ;
    thus thesis by B1;
  end;
end;

theorem Th31:
  for V being non empty set, M,N being EnvEpsTerm of V, S being EnvEpsTerm
    of V st [M (@) N,S] in SigmaRed(V) holds
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A (@) B1 )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, S be EnvEpsTerm of V;
  assume [M (@) N,S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        M (@) N = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        M (@) N = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        M (@) N = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        M (@) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        M (@) N = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & M (@) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
        B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        M (@) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        M (@) N = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (@) N = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (@) N = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        M (@) N = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (@) N = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        M (@) N = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: M (@) N = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        M (@) N = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: M (@) N = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        M (@) N = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: M (@) N = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        M (@) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: M (@) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        M (@) N = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: M (@) N = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & M (@) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
        B )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & M (@) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
      B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        M (@) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: M (@) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        M (@) N = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: M (@) N = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose B1:
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A1 (@) B )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (@) N = A (@) B & S = A (@) B1 )
    ;
    thus thesis by B1;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (@) N = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & M (@) N = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (@) N = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & M (@) N = eExt(A,x0,B) & S = eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        M (@) N = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & M (@) N = eExt(A,x0,B) & S = eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & M (@) N = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (@) N = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & M (@) N = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (@) N = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & M (@) N = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

theorem Th32:
  for V being non empty set, M,N being EnvEpsTerm of V, S being EnvEpsTerm
    of V st [M (o) N,S] in SigmaRed(V) holds
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        M (o) N = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        M (o) N = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & M (o) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
        B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        M (o) N = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A (o) B1 )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, S be EnvEpsTerm of V;
  assume [M (o) N,S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        M (o) N = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        M (o) N = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & M (o) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
        B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        M (o) N = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (o) N = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (o) N = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (o) N = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        M (o) N = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose B1:
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A being EnvEpsTerm of V st
        M (o) N = (eId V) (o) A & S = A )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A being EnvEpsTerm of V st
        M (o) N = A (o) (eId V) & S = A )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        M (o) N = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & M (o) N = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0) (o)
        B )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B,C being EnvEpsTerm of V st
        M (o) N = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B being EnvEpsTerm of V st
        M (o) N = (eEps A) (o) B & S = eEps A )
    ;
    thus thesis by B1;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & M (o) N = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (o) N = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & M (o) N = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (o) N = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & M (o) N = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        M (o) N = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    then consider A,A1,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & M (o) N = eExt(A,x0,B) & S = eExt(A1,x0,B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        M (o) N = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    then consider A,B,B1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [B,B1] in SigmaRed(V) & M (o) N = eExt(A,x0,B) & S = eExt(A,x0,B1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose B1:
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A1 (o) B )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        M (o) N = A (o) B & S = A (o) B1 )
    ;
    thus thesis by B1;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        M (o) N = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & M (o) N = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

theorem Th33:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of
    V, S being EnvEpsTerm of V st [eExt(M,x,N),S] in SigmaRed(V) holds
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A,x0,B1) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V, S be
    EnvEpsTerm of V;
  assume [eExt(M,x,N),S] in SigmaRed(V);
  then A1:
    ( ex A,B,C being EnvEpsTerm of V st
        eExt(M,x,N) = (A (o) B) (o) C & S = A (o) (B (o) C) ) or
    ( ex A being EnvEpsTerm of V st
        eExt(M,x,N) = (eId V) (o) A & S = A ) or
    ( ex A being EnvEpsTerm of V st
        eExt(M,x,N) = A (o) (eId V) & S = A ) or
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eExt(M,x,N) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) ) or
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eExt(M,x,N) = (eVar x0) (o) eExt(A,x0,B) & S = A ) or
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eExt(M,x,N) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
        (o) B ) or
    ( ex A,B,C being EnvEpsTerm of V st
        eExt(M,x,N) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) ) or
    ( ex A,B being EnvEpsTerm of V st
        eExt(M,x,N) = (eEps A) (o) B & S = eEps A ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = A (@) B & S = A1 (@) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eExt(M,x,N) = A (@) B & S = A (@) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eExt(M,x,N) = eLam(x0,A) & S = eLam(x0,A1) ) or
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A1,x0,B) ) or
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A,x0,B1) ) or
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = A (o) B & S = A1 (o) B ) or
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eExt(M,x,N) = A (o) B & S = A (o) B1 ) or
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = eEps A & S = eEps A1 ) by Th26;
  per cases by A1;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eExt(M,x,N) = (A (o) B) (o) C & S = A (o) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = (A (o) B) (o) C & S = A (o) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eExt(M,x,N) = (eId V) (o) A & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = (eId V) (o) A & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A being EnvEpsTerm of V st
        eExt(M,x,N) = A (o) (eId V) & S = A )
    ;
    then consider A being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = A (o) (eId V) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
        eExt(M,x,N) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B) )
    ;
    then consider C,A,B being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: eExt(M,x,N) = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0 being Element of V st
        eExt(M,x,N) = (eVar x0) (o) eExt(A,x0,B) & S = A )
    ;
    then consider A,B being EnvEpsTerm of V, x0 being Element of V such that
    E1: eExt(M,x,N) = (eVar x0) (o) eExt(A,x0,B) & S = A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
        x0 <> y0 & eExt(M,x,N) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
        (o) B )
    ;
    then consider A,B being EnvEpsTerm of V, x0,y0 being Element of V such
      that
    E1: x0 <> y0 & eExt(M,x,N) = (eVar x0) (o) eExt(A,y0,B) & S = (eVar x0)
      (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,C being EnvEpsTerm of V st
        eExt(M,x,N) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C) )
    ;
    then consider A,B,C being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B being EnvEpsTerm of V st
        eExt(M,x,N) = (eEps A) (o) B & S = eEps A )
    ;
    then consider A,B being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = (eEps A) (o) B & S = eEps A;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = A (@) B & S = A1 (@) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eExt(M,x,N) = A (@) B & S = A1 (@) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eExt(M,x,N) = A (@) B & S = A (@) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eExt(M,x,N) = A (@) B & S = A (@) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eExt(M,x,N) = eLam(x0,A) & S = eLam(x0,A1) )
    ;
    then consider A,A1 being EnvEpsTerm of V, x0 being Element of V such
      that
    E1: [A,A1] in SigmaRed(V) & eExt(M,x,N) = eLam(x0,A) & S = eLam(x0,A1);
    thus thesis by E1,ENVSYN:20;
  end;
  suppose B1:
    ( ex A,A1,B being EnvEpsTerm of V, x0 being Element of V st [A,A1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A1,x0,B) )
    ;
    thus thesis by B1;
  end;
  suppose B1:
    ( ex A,B,B1 being EnvEpsTerm of V, x0 being Element of V st [B,B1] in
    SigmaRed(V) &
        eExt(M,x,N) = eExt(A,x0,B) & S = eExt(A,x0,B1) )
    ;
    thus thesis by B1;
  end;
  suppose
    ( ex A,A1,B being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = A (o) B & S = A1 (o) B )
    ;
    then consider A,A1,B being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eExt(M,x,N) = A (o) B & S = A1 (o) B;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,B,B1 being EnvEpsTerm of V st [B,B1] in SigmaRed(V) &
        eExt(M,x,N) = A (o) B & S = A (o) B1 )
    ;
    then consider A,B,B1 being EnvEpsTerm of V such that
    E1: [B,B1] in SigmaRed(V) & eExt(M,x,N) = A (o) B & S = A (o) B1;
    thus thesis by E1,ENVSYN:20;
  end;
  suppose
    ( ex A,A1 being EnvEpsTerm of V st [A,A1] in SigmaRed(V) &
        eExt(M,x,N) = eEps A & S = eEps A1 )
    ;
    then consider A,A1 being EnvEpsTerm of V such that
    E1: [A,A1] in SigmaRed(V) & eExt(M,x,N) = eEps A & S = eEps A1;
    thus thesis by E1,ENVSYN:20;
  end;
end;

begin :: Multi-step congruence

theorem Th34:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st SigmaRed(V)
    reduces M,M1 holds
  SigmaRed(V) reduces M (@) N, M1 (@) N
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume SigmaRed(V) reduces M,M1;
  then CC SigmaRoot(V) reduces M,M1 by Def2;
  then CC SigmaRoot(V) reduces M (@) N, M1 (@) N by ENVCC:23;
  hence thesis by Def2;
end;

theorem Th35:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st SigmaRed(V)
    reduces N,N1 holds
  SigmaRed(V) reduces M (@) N, M (@) N1
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume SigmaRed(V) reduces N,N1;
  then CC SigmaRoot(V) reduces N,N1 by Def2;
  then CC SigmaRoot(V) reduces M (@) N, M (@) N1 by ENVCC:24;
  hence thesis by Def2;
end;

theorem Th36:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of
    V st SigmaRed(V) reduces M,M1 holds
  SigmaRed(V) reduces eLam(x,M), eLam(x,M1)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume SigmaRed(V) reduces M,M1;
  then CC SigmaRoot(V) reduces M,M1 by Def2;
  then CC SigmaRoot(V) reduces eLam(x,M), eLam(x,M1) by ENVCC:25;
  hence thesis by Def2;
end;

theorem Th37:
  for V being non empty set, M,M1,N being EnvEpsTerm of V, x being Element
    of V st SigmaRed(V) reduces M,M1 holds
  SigmaRed(V) reduces eExt(M,x,N), eExt(M1,x,N)
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V, x be Element of V;
  assume SigmaRed(V) reduces M,M1;
  then CC SigmaRoot(V) reduces M,M1 by Def2;
  then CC SigmaRoot(V) reduces eExt(M,x,N), eExt(M1,x,N) by ENVCC:26;
  hence thesis by Def2;
end;

theorem Th38:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V, x being Element
    of V st SigmaRed(V) reduces N,N1 holds
  SigmaRed(V) reduces eExt(M,x,N), eExt(M,x,N1)
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V, x be Element of V;
  assume SigmaRed(V) reduces N,N1;
  then CC SigmaRoot(V) reduces N,N1 by Def2;
  then CC SigmaRoot(V) reduces eExt(M,x,N), eExt(M,x,N1) by ENVCC:27;
  hence thesis by Def2;
end;

theorem Th39:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st SigmaRed(V)
    reduces M,M1 holds
  SigmaRed(V) reduces M (o) N, M1 (o) N
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume SigmaRed(V) reduces M,M1;
  then CC SigmaRoot(V) reduces M,M1 by Def2;
  then CC SigmaRoot(V) reduces M (o) N, M1 (o) N by ENVCC:28;
  hence thesis by Def2;
end;

theorem Th40:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st SigmaRed(V)
    reduces N,N1 holds
  SigmaRed(V) reduces M (o) N, M (o) N1
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume SigmaRed(V) reduces N,N1;
  then CC SigmaRoot(V) reduces N,N1 by Def2;
  then CC SigmaRoot(V) reduces M (o) N, M (o) N1 by ENVCC:29;
  hence thesis by Def2;
end;

theorem Th41:
  for V being non empty set, M,M1 being EnvEpsTerm of V st SigmaRed(V)
    reduces M,M1 holds
  SigmaRed(V) reduces eEps M, eEps M1
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V;
  assume SigmaRed(V) reduces M,M1;
  then CC SigmaRoot(V) reduces M,M1 by Def2;
  then CC SigmaRoot(V) reduces eEps M, eEps M1 by ENVCC:30;
  hence thesis by Def2;
end;


begin :: Each computation rule strictly decreases the length

theorem Th42:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  elen (M (o) (N (o) L)) < elen ((M (o) N) (o) L)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  D1: elen ((M (o) N) (o) L) = elen (M (o) N) * (elen L + 1) by ENVLEN:6
    .= (elen M * (elen N + 1)) * (elen L + 1) by ENVLEN:6;
  D2: elen (M (o) (N (o) L)) = elen M * (elen (N (o) L) + 1) by ENVLEN:6
    .= elen M * ((elen N * (elen L + 1)) + 1) by ENVLEN:6;
  D3: 0 < elen M & 0 < elen L by ENVLEN:7;
  elen M * ((elen N * (elen L + 1)) + 1) <
    (elen M * (elen N + 1)) * (elen L + 1) by D3,ENVLEN:9;
  hence thesis by D1,D2;
end;

theorem Th43:
  for V being non empty set, M being EnvEpsTerm of V holds
  elen M < elen ((eId V) (o) M)
proof
  let V be non empty set, M be EnvEpsTerm of V;
  D1: elen ((eId V) (o) M) = elen (eId V) * (elen M + 1) by ENVLEN:6
    .= 1 * (elen M + 1) by ENVLEN:1;
  elen M < elen M + 1 by ENVLEN:12;
  hence thesis by D1;
end;

theorem Th44:
  for V being non empty set, M being EnvEpsTerm of V holds
  elen M < elen (M (o) (eId V))
proof
  let V be non empty set, M be EnvEpsTerm of V;
  D1: elen (M (o) (eId V)) = elen M * (elen (eId V) + 1) by ENVLEN:6
    .= elen M * (1 + 1) by ENVLEN:1;
  D2: 0 < elen M by ENVLEN:7;
  elen M < 2 * elen M by D2,ENVLEN:13;
  hence thesis by D1;
end;

theorem Th45:
  for V being non empty set, L,M,N being EnvEpsTerm of V,
      x being Element of V holds
  elen (eExt(L (o) N, x, M (o) N)) < elen (eExt(L,x,M) (o) N)
proof
  let V be non empty set, L,M,N be EnvEpsTerm of V, x be Element of V;
  D1: elen (eExt(L,x,M) (o) N) = elen (eExt(L,x,M)) * (elen N + 1) by ENVLEN:6
    .= (elen L + elen M + 1) * (elen N + 1) by ENVLEN:5;
  D2: elen (eExt(L (o) N, x, M (o) N))
    = elen (L (o) N) + elen (M (o) N) + 1 by ENVLEN:5
    .= elen L * (elen N + 1) + elen (M (o) N) + 1 by ENVLEN:6
    .= elen L * (elen N + 1) + elen M * (elen N + 1) + 1 by ENVLEN:6;
  D3: 0 < elen N by ENVLEN:7;
  elen L * (elen N + 1) + elen M * (elen N + 1) + 1 <
    (elen L + elen M + 1) * (elen N + 1) by D3,ENVLEN:10;
  hence thesis by D1,D2;
end;

theorem Th46:
  for V being non empty set, M,N being EnvEpsTerm of V,
      x being Element of V holds
  elen M < elen ((eVar x) (o) eExt(M,x,N))
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V;
  D1: elen ((eVar x) (o) eExt(M,x,N))
    = elen (eVar x) * (elen (eExt(M,x,N)) + 1) by ENVLEN:6
    .= 1 * (elen (eExt(M,x,N)) + 1) by ENVLEN:1
    .= 1 * ((elen M + elen N + 1) + 1) by ENVLEN:5;
  D2: 0 < elen N + 2;
  elen M < elen M + (elen N + 2) by D2,ENVLEN:12;
  hence thesis by D1;
end;

theorem Th47:
  for V being non empty set, M,N being EnvEpsTerm of V,
      x,y being Element of V holds
  elen ((eVar x) (o) N) < elen ((eVar x) (o) eExt(M,y,N))
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x,y be Element of V;
  D1: elen ((eVar x) (o) eExt(M,y,N))
    = elen (eVar x) * (elen (eExt(M,y,N)) + 1) by ENVLEN:6
    .= 1 * (elen (eExt(M,y,N)) + 1) by ENVLEN:1
    .= 1 * ((elen M + elen N + 1) + 1) by ENVLEN:5;
  D2: elen ((eVar x) (o) N) = elen (eVar x) * (elen N + 1) by ENVLEN:6
    .= 1 * (elen N + 1) by ENVLEN:1;
  D3: 0 < elen M + 1;
  1 * (elen N + 1) < 1 * (elen N + 1) + (elen M + 1) by D3,ENVLEN:12;
  hence thesis by D1,D2;
end;

theorem Th48:
  for V being non empty set, M,N,L being EnvEpsTerm of V holds
  elen ((M (o) L) (@) (N (o) L)) < elen ((M (@) N) (o) L)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  D1: elen ((M (@) N) (o) L) = elen (M (@) N) * (elen L + 1) by ENVLEN:6
    .= (elen M + elen N + 1) * (elen L + 1) by ENVLEN:4;
  D2: elen ((M (o) L) (@) (N (o) L))
    = elen (M (o) L) + elen (N (o) L) + 1 by ENVLEN:4
    .= elen M * (elen L + 1) + elen (N (o) L) + 1 by ENVLEN:6
    .= elen M * (elen L + 1) + elen N * (elen L + 1) + 1 by ENVLEN:6;
  D3: 0 < elen L by ENVLEN:7;
  elen M * (elen L + 1) + elen N * (elen L + 1) + 1 <
    (elen M + elen N + 1) * (elen L + 1) by D3,ENVLEN:10;
  hence thesis by D1,D2;
end;

theorem Th49:
  for V being non empty set, M,N being EnvEpsTerm of V holds
  elen (eEps M) < elen ((eEps M) (o) N)
proof
  let V be non empty set, M,N be EnvEpsTerm of V;
  D1: elen ((eEps M) (o) N) = elen (eEps M) * (elen N + 1) by ENVLEN:6
    .= (2 * elen M) * (elen N + 1) by ENVLEN:3;
  D2: elen (eEps M) = 2 * elen M by ENVLEN:3;
  D3: 0 < elen M & 0 < elen N by ENVLEN:7;
  2 * elen M < (2 * elen M) * (elen N + 1) by D3,ENVLEN:11;
  hence thesis by D1,D2;
end;

begin :: The sigma reduction decreases the length, and terminates

theorem Th50:
  for V being non empty set, M,N being EnvEpsTerm of V
  st [M,N] in SigmaRed(V) holds elen N < elen M
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  set D = [:TS G, TS G:];
  defpred Q[object] means
    ex A,B being EnvEpsTerm of V st $1 = [A,B] & elen B < elen A;
  set DR = { z where z is Element of D : Q[z] };
  A1: DR c= D
  proof
    let u be object;
    assume u in DR;
    then ex z being Element of D st u = z & Q[z];
    hence thesis;
  end;
  reconsider DR1 = DR as EnvEpsRel of V by A1;
  A2: for A,B being EnvEpsTerm of V holds
    ( [A,B] in DR1 iff elen B < elen A )
  proof
    let A,B be EnvEpsTerm of V;
    hereby
      assume [A,B] in DR1;
      then consider z being Element of D such that
      B1: [A,B] = z and B2: Q[z];
      consider A2a,B2a being EnvEpsTerm of V such that
      B3: z = [A2a,B2a] & elen B2a < elen A2a by B2;
      A = A2a & B = B2a by B1,B3,XTUPLE_0:1;
      hence elen B < elen A by B3;
    end;
    assume C1: elen B < elen A;
    C2: [A,B] in D by ZFMISC_1:87;
    then reconsider z = [A,B] as Element of D;
    Q[z] by C1;
    hence thesis;
  end;
  A3: DR1 is_cc_over SigmaRoot(V)
  proof
    thus SigmaRoot(V) c= DR1
    proof
      now
        let u be object;
        assume E0: u in SigmaRoot(V);
        SigmaRoot(V) c= D;
        then u in D by E0;
        then consider a,b being object such that
        E1: a in TS G & b in TS G & u = [a,b] by ZFMISC_1:84;
        reconsider P = a, S = b as EnvEpsTerm of V by E1;
        E2: [P,S] in SigmaRoot(V) by E0,E1;
        E3: elen S < elen P
        proof
          per cases by E2,Th1;
          suppose ex A,B,C being EnvEpsTerm of V st
              P = (A (o) B) (o) C & S = A (o) (B (o) C);
            then consider A,B,C being EnvEpsTerm of V such that
            F1: P = (A (o) B) (o) C & S = A (o) (B (o) C);
            thus thesis by F1,Th42;
          end;
          suppose ex A being EnvEpsTerm of V st
              P = (eId V) (o) A & S = A;
            then consider A being EnvEpsTerm of V such that
            F1: P = (eId V) (o) A & S = A;
            thus thesis by F1,Th43;
          end;
          suppose ex A being EnvEpsTerm of V st
              P = A (o) (eId V) & S = A;
            then consider A being EnvEpsTerm of V such that
            F1: P = A (o) (eId V) & S = A;
            thus thesis by F1,Th44;
          end;
          suppose ex C,A,B being EnvEpsTerm of V, x0 being Element of V st
              P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
            then consider C,A,B being EnvEpsTerm of V,
            x0 being Element of V such that
            F1: P = eExt(C,x0,A) (o) B & S = eExt(C (o) B, x0, A (o) B);
            thus thesis by F1,Th45;
          end;
          suppose ex A,B being EnvEpsTerm of V, x0 being Element of V st
              P = (eVar x0) (o) eExt(A,x0,B) & S = A;
            then consider A,B being EnvEpsTerm of V, x0 being Element of V
            such that
            F1: P = (eVar x0) (o) eExt(A,x0,B) & S = A;
            thus thesis by F1,Th46;
          end;
          suppose ex A,B being EnvEpsTerm of V, x0,y0 being Element of V st
              x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) &
              S = (eVar x0) (o) B;
            then consider A,B being EnvEpsTerm of V,
            x0,y0 being Element of V such that
            F1: x0 <> y0 & P = (eVar x0) (o) eExt(A,y0,B) &
              S = (eVar x0) (o) B;
            thus thesis by F1,Th47;
          end;
          suppose ex A,B,C being EnvEpsTerm of V st
              P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
            then consider A,B,C being EnvEpsTerm of V such that
            F1: P = (A (@) B) (o) C & S = (A (o) C) (@) (B (o) C);
            thus thesis by F1,Th48;
          end;
          suppose ex A,B being EnvEpsTerm of V st
              P = (eEps A) (o) B & S = eEps A;
            then consider A,B being EnvEpsTerm of V such that
            F1: P = (eEps A) (o) B & S = eEps A;
            thus thesis by F1,Th49;
          end;
        end;
        [P,S] in DR1 by A2,E3;
        hence u in DR1 by E1;
      end;
      hence thesis by TARSKI:def 3;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in DR1 holds
      [M (@) N, M1 (@) N] in DR1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume [M,M1] in DR1;
      then D0: elen M1 < elen M by A2;
      D1: elen (M (@) N) = elen M + elen N + 1 by ENVLEN:4;
      D2: elen (M1 (@) N) = elen M1 + elen N + 1 by ENVLEN:4;
      elen M1 + (elen N + 1) < elen M + (elen N + 1) by D0,XREAL_1:8;
      hence thesis by A2,D1,D2;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in DR1 holds
      [M (@) N, M (@) N1] in DR1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume [N,N1] in DR1;
      then D0: elen N1 < elen N by A2;
      D1: elen (M (@) N) = elen M + elen N + 1 by ENVLEN:4;
      D2: elen (M (@) N1) = elen M + elen N1 + 1 by ENVLEN:4;
      elen N1 + (elen M + 1) < elen N + (elen M + 1) by D0,XREAL_1:8;
      hence thesis by A2,D1,D2;
    end;
    thus for M,M1 being EnvEpsTerm of V, x being Element of V
      st [M,M1] in DR1 holds [eLam(x,M), eLam(x,M1)] in DR1
    proof
      let M,M1 be EnvEpsTerm of V, x be Element of V;
      assume [M,M1] in DR1;
      then D0: elen M1 < elen M by A2;
      D1: elen (eLam(x,M)) = 2 * elen M by ENVLEN:2;
      D2: elen (eLam(x,M1)) = 2 * elen M1 by ENVLEN:2;
      2 * elen M1 < 2 * elen M by D0,ENVLEN:14;
      hence thesis by A2,D1,D2;
    end;
    thus for M,M1,N being EnvEpsTerm of V, x being Element of V
      st [M,M1] in DR1 holds [eExt(M,x,N), eExt(M1,x,N)] in DR1
    proof
      let M,M1,N be EnvEpsTerm of V, x be Element of V;
      assume [M,M1] in DR1;
      then D0: elen M1 < elen M by A2;
      D1: elen (eExt(M,x,N)) = elen M + elen N + 1 by ENVLEN:5;
      D2: elen (eExt(M1,x,N)) = elen M1 + elen N + 1 by ENVLEN:5;
      elen M1 + (elen N + 1) < elen M + (elen N + 1) by D0,XREAL_1:8;
      hence thesis by A2,D1,D2;
    end;
    thus for M,N,N1 being EnvEpsTerm of V, x being Element of V
      st [N,N1] in DR1 holds [eExt(M,x,N), eExt(M,x,N1)] in DR1
    proof
      let M,N,N1 be EnvEpsTerm of V, x be Element of V;
      assume [N,N1] in DR1;
      then D0: elen N1 < elen N by A2;
      D1: elen (eExt(M,x,N)) = elen M + elen N + 1 by ENVLEN:5;
      D2: elen (eExt(M,x,N1)) = elen M + elen N1 + 1 by ENVLEN:5;
      elen N1 + (elen M + 1) < elen N + (elen M + 1) by D0,XREAL_1:8;
      hence thesis by A2,D1,D2;
    end;
    thus for M,M1,N being EnvEpsTerm of V st [M,M1] in DR1 holds
      [M (o) N, M1 (o) N] in DR1
    proof
      let M,M1,N be EnvEpsTerm of V;
      assume [M,M1] in DR1;
      then D0: elen M1 < elen M by A2;
      D1: elen (M (o) N) = elen M * (elen N + 1) by ENVLEN:6;
      D2: elen (M1 (o) N) = elen M1 * (elen N + 1) by ENVLEN:6;
      D3: 0 < elen N + 1;
      elen M1 * (elen N + 1) < elen M * (elen N + 1) by D0,D3,XREAL_1:68;
      hence thesis by A2,D1,D2;
    end;
    thus for M,N,N1 being EnvEpsTerm of V st [N,N1] in DR1 holds
      [M (o) N, M (o) N1] in DR1
    proof
      let M,N,N1 be EnvEpsTerm of V;
      assume [N,N1] in DR1;
      then D0: elen N1 < elen N by A2;
      D1: elen (M (o) N) = elen M * (elen N + 1) by ENVLEN:6;
      D2: elen (M (o) N1) = elen M * (elen N1 + 1) by ENVLEN:6;
      D3: 0 < elen M by ENVLEN:7;
      D4: elen N1 + 1 < elen N + 1 by D0,XREAL_1:8;
      elen M * (elen N1 + 1) < elen M * (elen N + 1) by D3,D4,ENVLEN:15;
      hence thesis by A2,D1,D2;
    end;
    thus for M,M1 being EnvEpsTerm of V st [M,M1] in DR1 holds
      [eEps M, eEps M1] in DR1
    proof
      let M,M1 be EnvEpsTerm of V;
      assume [M,M1] in DR1;
      then D0: elen M1 < elen M by A2;
      D1: elen (eEps M) = 2 * elen M by ENVLEN:3;
      D2: elen (eEps M1) = 2 * elen M1 by ENVLEN:3;
      2 * elen M1 < 2 * elen M by D0,ENVLEN:14;
      hence thesis by A2,D1,D2;
    end;
  end;
  A4: CC SigmaRoot(V) c= DR1 by A3,ENVCC:2;
  let M,N be EnvEpsTerm of V;
  assume [M,N] in SigmaRed(V);
  then [M,N] in CC SigmaRoot(V) by Def2;
  then [M,N] in DR1 by A4;
  hence thesis by A2;
end;

registration
  let V be non empty set;
  cluster SigmaRed(V) -> strongly-normalizing;
  coherence
  proof
    set G = EnvEpsGram(V);
    A0: SigmaRed(V) c= [:TS G, TS G:];
    let f be ManySortedSet of NAT;
    assume not ex i being Nat st not [f.i,f.(i+1)] in SigmaRed(V);
    then A1: for i being Nat holds [f.i,f.(i+1)] in SigmaRed(V);
    A2: for i being Nat holds f.i in TS G
    proof
      let i be Nat;
      [f.i,f.(i+1)] in SigmaRed(V) by A1;
      then [f.i,f.(i+1)] in [:TS G, TS G:] by A0;
      hence thesis by ZFMISC_1:87;
    end;
    defpred P[Nat] means
      ex i being Nat, A being EnvEpsTerm of V st A = f.i & $1 = elen A;
    B0: f.0 in TS G by A2;
    then reconsider A0a = f.0 as EnvEpsTerm of V;
    B1: ex k being Nat st P[k]
    proof
      take elen A0a;
      take 0;
      take A0a;
      thus thesis;
    end;
    consider k being Nat such that
    B2: P[k] and B3: for n being Nat st P[n] holds k <= n from NAT_1:sch 5(B1);
    consider i0 being Nat, A being EnvEpsTerm of V such that
    B4: A = f.i0 & k = elen A by B2;
    f.(i0+1) in TS G by A2;
    then reconsider B = f.(i0+1) as EnvEpsTerm of V;
    C1: [A,B] in SigmaRed(V) by A1,B4;
    C2: elen B < elen A by C1,Th50;
    P[elen B] by B4;
    then k <= elen B by B3;
    hence contradiction by B4,C2;
  end;
end;

theorem Th51:
  for V being non empty set holds SigmaRed(V) is strongly-normalizing;

begin :: Convergence

theorem Th52:
  for V being non empty set, M,N,L being EnvEpsTerm of V
  st SigmaRed(V) reduces M,L & SigmaRed(V) reduces N,L
  holds M,N are_convergent_wrt SigmaRed(V)
proof
  let V be non empty set, M,N,L be EnvEpsTerm of V;
  assume A1: SigmaRed(V) reduces M,L & SigmaRed(V) reduces N,L;
  take L;
  thus thesis by A1;
end;

theorem Th53:
  for V being non empty set, M,N being EnvEpsTerm of V
  st [M,N] in SigmaRed(V) holds SigmaRed(V) reduces M,N by REWRITE1:15;

theorem Th54:
  for V being non empty set, M being EnvEpsTerm of V
  holds SigmaRed(V) reduces M,M by REWRITE1:12;

theorem Th55:
  for V being non empty set, A,B being EnvEpsTerm of V
  st A,B are_convergent_wrt SigmaRed(V)
  ex L being EnvEpsTerm of V st
    SigmaRed(V) reduces A,L & SigmaRed(V) reduces B,L
proof
  let V be non empty set, A,B be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  assume A,B are_convergent_wrt SigmaRed(V);
  then consider c being object such that
  A1: SigmaRed(V) reduces A,c & SigmaRed(V) reduces B,c by REWRITE1:def 7;
  per cases;
  suppose A = c;
    then reconsider L = c as EnvEpsTerm of V;
    take L;
    thus thesis by A1;
  end;
  suppose A <> c;
    then c in field SigmaRed(V) by A1,REWRITE1:18;
    then B1: c in dom SigmaRed(V) \/ rng SigmaRed(V) by RELAT_1:def 6;
    B2: SigmaRed(V) c= [:TS G, TS G:];
    per cases by B1,XBOOLE_0:def 3;
    suppose c in dom SigmaRed(V);
      then consider y being object such that
      C1: [c,y] in SigmaRed(V) by XTUPLE_0:def 12;
      [c,y] in [:TS G, TS G:] by B2,C1;
      then c in TS G by ZFMISC_1:87;
      then reconsider L = c as EnvEpsTerm of V;
      take L;
      thus thesis by A1;
    end;
    suppose c in rng SigmaRed(V);
      then consider y being object such that
      C1: [y,c] in SigmaRed(V) by XTUPLE_0:def 13;
      [y,c] in [:TS G, TS G:] by B2,C1;
      then c in TS G by ZFMISC_1:87;
      then reconsider L = c as EnvEpsTerm of V;
      take L;
      thus thesis by A1;
    end;
  end;
end;

theorem Th56:
  for V being non empty set, A,B,C being EnvEpsTerm of V
  st SigmaRed(V) reduces A,B & [B,C] in SigmaRed(V)
  holds SigmaRed(V) reduces A,C
proof
  let V be non empty set, A,B,C be EnvEpsTerm of V;
  assume A1: SigmaRed(V) reduces A,B & [B,C] in SigmaRed(V);
  then SigmaRed(V) reduces B,C by REWRITE1:15;
  hence thesis by A1,REWRITE1:16;
end;
