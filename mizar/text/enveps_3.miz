:: Peak analysis for the sigma reduction of lambda_EnvEps

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, FINSEQ_1,
      RELAT_1, FUNCT_1, ORDINAL1, CARD_1, ARYTM_3, XXREAL_0, NAT_1, TREES_1,
      TREES_2, TREES_3, TREES_4, LANG1, STRUCT_0, DTCONSTR, MCART_1, XTUPLE_0,
      FINSET_1, TDGROUP, FUNCOP_1, ARYTM_1, FUNCT_7, XREAL_0, XCMPLX_0,
      REWRITE1, PBOOLE, ENVEPS_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2, TREES_3,
      TREES_4, DTCONSTR, FUNCOP_1, XREAL_0, PBOOLE, REWRITE1, ENVEPS_1;
 constructors NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, MCART_1, XTUPLE_0, DOMAIN_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, PARTFUN1, BINOP_1, SETWISEO, XREAL_0,
      FUNCOP_1, SUBSET_1, CARD_3, FINSEQOP, FINSEQ_4, FINSOP_1, PRE_POLY,
      FUNCT_1, RELAT_1, PBOOLE, REWRITE1, ENVEPS_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, STRUCT_0, LANG1, TREES_1, TREES_2,
      TREES_3, TREES_4, DTCONSTR, XTUPLE_0, VALUED_0, FUNCOP_1, XCMPLX_0,
      XXREAL_0, NUMBERS, MEMBERED, PBOOLE, REWRITE1, ENVEPS_1;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, DTCONSTR, TREES_3, TREES_4, RELAT_1, FUNCT_1,
      FINSEQ_1, FUNCOP_1, SUBSET_1, REWRITE1, ENVEPS_1;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, ZFMISC_1, FINSEQ_1, FINSEQ_2, FINSEQ_3,
      MCART_1, LANG1, ENUMSET1, TREES_1, TREES_3, TREES_4, DTCONSTR, XTUPLE_0,
      FUNCT_1, RELAT_1, FUNCOP_1, NAT_1, XCMPLX_1, SUBSET_1, FUNCT_2, XREAL_1,
      REWRITE1, XXREAL_0, ENVEPS_1, ENVEPS_2;
 schemes DTCONSTR, NAT_1, ENVEPS_1, ENVEPS_2;

begin :: A term witness for convergence

theorem Th1:
  for V being non empty set, A,B being EnvEpsTerm of V
  st A,B are_convergent_wrt SigmaRed(V)
  ex L being EnvEpsTerm of V st
    SigmaRed(V) reduces A,L & SigmaRed(V) reduces B,L
proof
  let V be non empty set, A,B be EnvEpsTerm of V;
  set G = EnvEpsGram(V);
  assume A,B are_convergent_wrt SigmaRed(V);
  then consider c being object such that
  A1: SigmaRed(V) reduces A,c & SigmaRed(V) reduces B,c by REWRITE1:def 7;
  per cases;
  suppose A = c;
    then reconsider L = c as EnvEpsTerm of V;
    take L;
    thus thesis by A1;
  end;
  suppose A <> c;
    then c in field SigmaRed(V) by A1,REWRITE1:18;
    then B1: c in dom SigmaRed(V) \/ rng SigmaRed(V) by RELAT_1:def 6;
    B2: SigmaRed(V) c= [:TS G, TS G:];
    per cases by B1,XBOOLE_0:def 3;
    suppose c in dom SigmaRed(V);
      then consider y being object such that
      C1: [c,y] in SigmaRed(V) by XTUPLE_0:def 12;
      [c,y] in [:TS G, TS G:] by B2,C1;
      then c in TS G by ZFMISC_1:87;
      then reconsider L = c as EnvEpsTerm of V;
      take L;
      thus thesis by A1;
    end;
    suppose c in rng SigmaRed(V);
      then consider y being object such that
      C1: [y,c] in SigmaRed(V) by XTUPLE_0:def 13;
      [y,c] in [:TS G, TS G:] by B2,C1;
      then c in TS G by ZFMISC_1:87;
      then reconsider L = c as EnvEpsTerm of V;
      take L;
      thus thesis by A1;
    end;
  end;
end;

begin :: Inversion by the head constructor

theorem Th2:
  for V being non empty set, x being Element of V, Q being EnvEpsTerm of V
  holds not [eVar x, Q] in SigmaRed(V)
proof
  let V be non empty set, x be Element of V, Q be EnvEpsTerm of V;
  assume A1: [eVar x, Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eVar x = eComp(eComp(M2,N2),L2) & Q
      = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eVar x = eComp(eId V,M2) & Q = M2 ) or
    ( ex M2 being EnvEpsTerm of V st eVar x = eComp(M2,eId V) & Q = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eVar x = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eVar x = eComp(eApp(M2,N2),L2) & Q
      = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eVar x = eComp(eEps M2,N2) & Q = eEps
      M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eVar x =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eVar x =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x = eEps
      M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eVar x = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eVar x = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eVar x = eComp(eId V,M2) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eVar x = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eVar x = eComp(M2,eId V) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eVar x = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eVar x = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eVar x =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eVar x = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eVar x = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eVar x = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar
      x2, N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eVar x = eComp(eApp(M2,N2),L2)
      & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eVar x = eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eVar x = eComp(eEps M2,N2) & Q =
      eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eVar x = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x
      = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eVar x = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eVar x
      = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eVar x = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eVar x = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eVar x = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x
      = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eVar x = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eVar x
      = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eVar x = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eVar x =
      eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eVar x = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th3:
  for V being non empty set, Q being EnvEpsTerm of V
  holds not [eId V, Q] in SigmaRed(V)
proof
  let V be non empty set, Q be EnvEpsTerm of V;
  assume A1: [eId V, Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eId V = eComp(eComp(M2,N2),L2) & Q
      = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eId V = eComp(eId V,M2) & Q = M2 ) or
    ( ex M2 being EnvEpsTerm of V st eId V = eComp(M2,eId V) & Q = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eId V = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eId V = eComp(eApp(M2,N2),L2) & Q =
      eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eId V = eComp(eEps M2,N2) & Q = eEps
      M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eId V =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eId V =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V = eEps
      M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eId V = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eId V = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eId V = eComp(eId V,M2) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eId V = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eId V = eComp(M2,eId V) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eId V = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eId V = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eId V =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eId V = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eId V = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eId V = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2,
      N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eId V = eComp(eApp(M2,N2),L2) &
      Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eId V = eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eId V = eComp(eEps M2,N2) & Q =
      eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eId V = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V
      = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eId V = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eId V
      = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eId V = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eId V = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eId V = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V
      = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eId V = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eId V
      = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eId V = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eId V =
      eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eId V = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th4:
  for V being non empty set, M being EnvEpsTerm of V, x being Element of V, Q
    being EnvEpsTerm of V
  st [eLam(x,M), Q] in SigmaRed(V) holds
  ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    SigmaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3) )
proof
  let V be non empty set, M be EnvEpsTerm of V, x be Element of V, Q be
    EnvEpsTerm of V;
  assume A1: [eLam(x,M), Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eLam(x,M) = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eLam(x,M) = eComp(eId V,M2) & Q = M2 ) or
    ( ex M2 being EnvEpsTerm of V st eLam(x,M) = eComp(M2,eId V) & Q = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eLam(x,M) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eLam(x,M) = eComp(eApp(M2,N2),L2) &
      Q = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eLam(x,M) = eComp(eEps M2,N2) & Q =
      eEps M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eLam(x,M)
      = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eLam(x,M)
      = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eLam(x,M)
      = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eLam(x,M)
      = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eLam(x,M) =
      eEps M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eLam(x,M) =
      eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eLam(x,M) = eComp(eId V,M2) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eLam(x,M) = eComp(M2,eId V) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
      eLam(x,M) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eLam(x,M) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eLam(x,M) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eLam(x,M) = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eLam(x,M) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eLam(x,M) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar
      x2, N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eLam(x,M) =
      eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eComp(eApp(M2,N2),L2) & Q =
      eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eLam(x,M) = eComp(eEps M2,N2) & Q
      = eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eLam(x,M) = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eLam(x,M) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eLam(x,M) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eLam(x,M) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eLam(x,M) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eLam(x,M) = eLam(x2,M2) & Q = eLam(x2,M3);
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eLam(x,M) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eLam(x,M) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eLam(x,M) = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eLam(x,M) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eLam(x,M) = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eLam(x,M)
      = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eLam(x,M) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th5:
  for V being non empty set, M being EnvEpsTerm of V, Q being EnvEpsTerm of V
  st [eEps M, Q] in SigmaRed(V) holds
  ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M = eEps
    M2 & Q = eEps M3 )
proof
  let V be non empty set, M be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eEps M, Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eEps M = eComp(eComp(M2,N2),L2) & Q
      = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eEps M = eComp(eId V,M2) & Q = M2 ) or
    ( ex M2 being EnvEpsTerm of V st eEps M = eComp(M2,eId V) & Q = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eEps M = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eEps M = eComp(eApp(M2,N2),L2) & Q
      = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eEps M = eComp(eEps M2,N2) & Q = eEps
      M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M =
      eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eEps M =
      eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M =
      eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eEps M =
      eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M = eEps
      M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eEps M = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eEps M = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eEps M = eComp(eId V,M2) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eEps M = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eEps M = eComp(M2,eId V) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eEps M = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eEps M = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eEps M =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eEps M = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eEps M = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eEps M = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar
      x2, N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eEps M = eComp(eApp(M2,N2),L2)
      & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eEps M = eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eEps M = eComp(eEps M2,N2) & Q =
      eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eEps M = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M
      = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eEps M = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eEps M
      = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eEps M = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eEps M = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eEps M = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M
      = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eEps M = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eEps M
      = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eEps M = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eEps M =
      eEps M2 & Q = eEps M3;
    hence thesis;
  end;
end;

theorem Th6:
  for V being non empty set, M,N being EnvEpsTerm of V, Q being EnvEpsTerm of
    V
  st [eApp(M,N), Q] in SigmaRed(V) holds
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eApp(M,N) =
    eApp(M2,N2) & Q = eApp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eApp(M,N) =
    eApp(M2,N2) & Q = eApp(M2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eApp(M,N), Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eApp(M,N) = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eApp(M,N) = eComp(eId V,M2) & Q = M2 ) or
    ( ex M2 being EnvEpsTerm of V st eApp(M,N) = eComp(M2,eId V) & Q = M2 ) or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eApp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eApp(M,N) = eComp(eApp(M2,N2),L2) &
      Q = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eApp(M,N) = eComp(eEps M2,N2) & Q =
      eEps M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eApp(M,N)
      = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eApp(M,N)
      = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eApp(M,N)
      = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eApp(M,N)
      = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eApp(M,N) =
      eEps M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eApp(M,N) =
      eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eApp(M,N) = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eApp(M,N) = eComp(eId V,M2) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eApp(M,N) = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eApp(M,N) = eComp(M2,eId V) & Q = M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eApp(M,N) = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
      eApp(M,N) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eApp(M,N) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eApp(M,N) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eApp(M,N) = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eApp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eApp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar
      x2, N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eApp(M,N) =
      eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eApp(M,N) = eComp(eApp(M2,N2),L2) & Q =
      eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eApp(M,N) = eComp(eEps M2,N2) & Q
      = eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eApp(M,N) = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eApp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eApp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    hence thesis;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eApp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eApp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eApp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eApp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eApp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eApp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eApp(M,N)
      = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eApp(M,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th7:
  for V being non empty set, M,N being EnvEpsTerm of V, x being Element of V,
    Q being EnvEpsTerm of V
  st [eExt(M,x,N), Q] in SigmaRed(V) holds
  ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
    SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
    SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, x be Element of V, Q be
    EnvEpsTerm of V;
  assume A1: [eExt(M,x,N), Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eExt(M,x,N) =
      eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(eId V,M2) & Q = M2 )
      or
    ( ex M2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(M2,eId V) & Q = M2 )
      or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N)
      = eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eExt(M,x,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) )
      or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(eApp(M2,N2),L2)
      & Q = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(eEps M2,N2) & Q =
      eEps M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eExt(M,x,N) =
      eEps M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eExt(M,x,N) =
      eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(eId V,M2) & Q =
      M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eComp(eId V,M2) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(M2,eId V) & Q =
      M2;
    then consider M2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eComp(M2,eId V) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
      eExt(M,x,N) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    then consider L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: eExt(M,x,N) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eExt(M,x,N)
      = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    then consider M2,N2 being EnvEpsTerm of V, x2 being Element of V such that
    E1: eExt(M,x,N) = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eExt(M,x,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    then consider M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V such
      that
    E1: x2 <> y2 & eExt(M,x,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q =
      eComp(eVar x2, N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eExt(M,x,N) =
      eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eComp(eApp(M2,N2),L2) & Q =
      eApp(eComp(M2,L2),eComp(N2,L2));
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eExt(M,x,N) = eComp(eEps M2,N2) &
      Q = eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    E1: eExt(M,x,N) = eComp(eEps M2,N2) & Q = eEps M2;
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eExt(M,x,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eExt(M,x,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eExt(M,x,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eExt(M,x,N) = eComp(M2,N2) & Q =
      eComp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eExt(M,x,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eExt(M,x,N) = eComp(M2,N2) & Q =
      eComp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eExt(M,x,N) = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eExt(M,x,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th8:
  for V being non empty set, M,N being EnvEpsTerm of V, Q being EnvEpsTerm of
    V
  st [eComp(M,N), Q] in SigmaRed(V) holds
  ( ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) = eComp(eComp(M2,N2),L2) &
    Q = eComp(M2,eComp(N2,L2)) ) or
  ( ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(eId V,M2) & Q = M2 ) or
  ( ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(M2,eId V) & Q = M2 ) or
  ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
    eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
    eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
  ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
    eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) ) or
  ( ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) = eComp(eApp(M2,N2),L2) &
    Q = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
  ( ex M2,N2 being EnvEpsTerm of V st eComp(M,N) = eComp(eEps M2,N2) & Q =
    eEps M2 ) or
  ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eComp(M,N) =
    eComp(M2,N2) & Q = eComp(M3,N2) ) or
  ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eComp(M,N) =
    eComp(M2,N2) & Q = eComp(M2,N3) )
proof
  let V be non empty set, M,N be EnvEpsTerm of V, Q be EnvEpsTerm of V;
  assume A1: [eComp(M,N), Q] in SigmaRed(V);
  A2:
    ( ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) = eComp(eComp(M2,N2),L2)
      & Q = eComp(M2,eComp(N2,L2)) ) or
    ( ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(eId V,M2) & Q = M2 )
      or
    ( ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(M2,eId V) & Q = M2 )
      or
    ( ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
      eComp(eExt(L2,x2,M2),N2) & Q = eExt(eComp(L2,N2),x2,eComp(M2,N2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N) =
      eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2 ) or
    ( ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2 &
      eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2) )
      or
    ( ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) = eComp(eApp(M2,N2),L2)
      & Q = eApp(eComp(M2,L2),eComp(N2,L2)) ) or
    ( ex M2,N2 being EnvEpsTerm of V st eComp(M,N) = eComp(eEps M2,N2) & Q =
      eEps M2 ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eComp(M,N)
      = eApp(M2,N2) & Q = eApp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eComp(M,N)
      = eApp(M2,N2) & Q = eApp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3] in
      SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3) ) or
    ( ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eComp(M,N)
      = eComp(M2,N2) & Q = eComp(M3,N2) ) or
    ( ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) & eComp(M,N)
      = eComp(M2,N2) & Q = eComp(M2,N3) ) or
    ( ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) & eComp(M,N) =
      eEps M2 & Q = eEps M3 ) by A1,ENVEPS_2:9;
  per cases by A2;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) =
      eComp(eComp(M2,N2),L2) & Q = eComp(M2,eComp(N2,L2));
    hence thesis;
  end;
  suppose ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(eId V,M2) & Q =
      M2;
    hence thesis;
  end;
  suppose ex M2 being EnvEpsTerm of V st eComp(M,N) = eComp(M2,eId V) & Q =
      M2;
    hence thesis;
  end;
  suppose ex L2,M2,N2 being EnvEpsTerm of V, x2 being Element of V st
      eComp(M,N) = eComp(eExt(L2,x2,M2),N2) & Q =
      eExt(eComp(L2,N2),x2,eComp(M2,N2));
    hence thesis;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2 being Element of V st eComp(M,N)
      = eComp(eVar x2, eExt(M2,x2,N2)) & Q = M2;
    hence thesis;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V, x2,y2 being Element of V st x2 <> y2
      & eComp(M,N) = eComp(eVar x2, eExt(M2,y2,N2)) & Q = eComp(eVar x2, N2);
    hence thesis;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eComp(M,N) =
      eComp(eApp(M2,N2),L2) & Q = eApp(eComp(M2,L2),eComp(N2,L2));
    hence thesis;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eComp(M,N) = eComp(eEps M2,N2) & Q
      = eEps M2;
    hence thesis;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eComp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eComp(M,N) = eApp(M2,N2) & Q = eApp(M3,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eComp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V such that
    E1: [N2,N3] in SigmaRed(V) & eComp(M,N) = eApp(M2,N2) & Q = eApp(M2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V, x2 being Element of V st [M2,M3] in
      SigmaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    then consider M2,M3 being EnvEpsTerm of V, x2 being Element of V such that
    E1: [M2,M3] in SigmaRed(V) & eComp(M,N) = eLam(x2,M2) & Q = eLam(x2,M3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V st [M2,M3]
      in SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M3,x2,N2);
    then consider M2,M3,N2 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [M2,M3] in SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M3,x2,N2);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V st [N2,N3]
      in SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q = eExt(M2,x2,N3);
    then consider M2,N2,N3 being EnvEpsTerm of V, x2 being Element of V such
      that
    E1: [N2,N3] in SigmaRed(V) & eComp(M,N) = eExt(M2,x2,N2) & Q =
      eExt(M2,x2,N3);
    thus thesis by E1,ENVEPS_1:44;
  end;
  suppose ex M2,M3,N2 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eComp(M,N) = eComp(M2,N2) & Q = eComp(M3,N2);
    hence thesis;
  end;
  suppose ex M2,N2,N3 being EnvEpsTerm of V st [N2,N3] in SigmaRed(V) &
      eComp(M,N) = eComp(M2,N2) & Q = eComp(M2,N3);
    hence thesis;
  end;
  suppose ex M2,M3 being EnvEpsTerm of V st [M2,M3] in SigmaRed(V) &
      eComp(M,N) = eEps M2 & Q = eEps M3;
    then consider M2,M3 being EnvEpsTerm of V such that
    E1: [M2,M3] in SigmaRed(V) & eComp(M,N) = eEps M2 & Q = eEps M3;
    thus thesis by E1,ENVEPS_1:44;
  end;
end;

theorem Th9:
  for V being non empty set, A,B,C being EnvEpsTerm of V
  st SigmaRed(V) reduces A,B & [B,C] in SigmaRed(V)
  holds SigmaRed(V) reduces A,C
proof
  let V be non empty set, A,B,C be EnvEpsTerm of V;
  assume A1: SigmaRed(V) reduces A,B & [B,C] in SigmaRed(V);
  then SigmaRed(V) reduces B,C by REWRITE1:15;
  hence thesis by A1,REWRITE1:16;
end;
