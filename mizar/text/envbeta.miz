begin :: Multi-step congruence for the beta/sigma reduction

theorem Th54:
  for V being non empty set, M,M1,N being EnvEpsTerm of V st BetaSigmaRed(V)
    reduces M,M1 holds
  BetaSigmaRed(V) reduces M (@) N, M1 (@) N
proof
  let V be non empty set, M,M1,N be EnvEpsTerm of V;
  assume BetaSigmaRed(V) reduces M,M1;
  then CC BetaSigmaRoot(V) reduces M,M1 by Def4;
  then CC BetaSigmaRoot(V) reduces M (@) N, M1 (@) N by ENVCC:23;
  hence thesis by Def4;
end;

theorem Th55:
  for V being non empty set, M,N,N1 being EnvEpsTerm of V st BetaSigmaRed(V)
    reduces N,N1 holds
  BetaSigmaRed(V) reduces M (@) N, M (@) N1
proof
  let V be non empty set, M,N,N1 be EnvEpsTerm of V;
  assume BetaSigmaRed(V) reduces N,N1;
  then CC BetaSigmaRoot(V) reduces N,N1 by Def4;
  then CC BetaSigmaRoot(V) reduces M (@) N, M (@) N1 by ENVCC:24;
  hence thesis by Def4;
end;

theorem Th56:
  for V being non empty set, M,M1 being EnvEpsTerm of V, x being Element of
    V st BetaSigmaRed(V) reduces M,M1 holds
  BetaSigmaRed(V) reduces eLam(x,M), eLam(x,M1)
proof
  let V be non empty set, M,M1 be EnvEpsTerm of V, x be Element of V;
  assume BetaSigmaRed(V) reduces M,M1;
  then CC BetaSigmaRoot(V) reduces M,M1 by Def4;
  then CC BetaSigmaRoot(V) reduces eLam(x,M), eLam(x,M1) by ENVCC:25;
  hence thesis by Def4;
end;

