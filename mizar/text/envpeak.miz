      F3: [eComp(eEps U2,V2),W1] in SigmaRed(V) by B1,F2;
      W2,W1 are_convergent_wrt SigmaRed(V) by F1,F3,Th2;
      hence thesis by Th1;
    end;
    suppose ex U2,U3,V2 being EnvEpsTerm of V st [U2,U3] in SigmaRed(V) &
        eComp(A,B) = eComp(U2,V2) & W2 = eComp(U3,V2);
      then consider U2,U3,V2 being EnvEpsTerm of V such that
      F1: [U2,U3] in SigmaRed(V) & eComp(A,B) = eComp(U2,V2) & W2 =
        eComp(U3,V2);
      F2: A = U2 & B = V2 by F1,ENVSYN:14;
      F3: [eComp(A,N3), eComp(U3,N3)] in SigmaRed(V)
        by F1,F2,ENVSIG:23;
      F4: SigmaRed(V) reduces W1, eComp(U3,N3)
        by D1,D2,F3,REWRITE1:15;
      [eComp(U3,B), eComp(U3,N3)] in SigmaRed(V)
        by D1,D2,ENVSIG:24;
      then SigmaRed(V) reduces W2, eComp(U3,N3)
        by F1,F2,REWRITE1:15;
      hence thesis by F4,ENVSIG:52;
    end;
    suppose ex U2,V2,V3 being EnvEpsTerm of V st [V2,V3] in SigmaRed(V) &
        eComp(A,B) = eComp(U2,V2) & W2 = eComp(U2,V3);
      then consider U2,V2,V3 being EnvEpsTerm of V such that
      F1: [V2,V3] in SigmaRed(V) & eComp(A,B) = eComp(U2,V2) & W2 =
        eComp(U2,V3);
      F2: A = U2 & B = V2 by F1,ENVSYN:14;
      F4: V3,N3 are_convergent_wrt SigmaRed(V)
        by B0,D1,D2,F1,F2;
      consider T being EnvEpsTerm of V such that
      F5: SigmaRed(V) reduces V3,T & SigmaRed(V) reduces N3,T
        by F4,ENVSIG:55;
      F6: SigmaRed(V) reduces eComp(A,N3), eComp(A,T)
        by F5,ENVSIG:40;
      SigmaRed(V) reduces eComp(A,V3), eComp(A,T)
        by F5,ENVSIG:40;
      hence thesis by D1,D2,F1,F2,F6,ENVSIG:52;
    end;
  end;
end;


begin :: Local confluence and confluence of the sigma reduction

theorem Th11:
  for V being non empty set holds SigmaRed(V) is locally-confluent
proof
  let V be non empty set;
  set G = EnvEpsGram(V);
  defpred P[set] means for U1,U2 being EnvEpsTerm of V
    st [$1,U1] in SigmaRed(V) & [$1,U2] in SigmaRed(V)
      holds U1,U2 are_convergent_wrt SigmaRed(V);
  A1: for v being Element of V holds P[eVar v]
  proof
    let v be Element of V;
    let U1,U2 be EnvEpsTerm of V;
    assume [eVar v,U1] in SigmaRed(V) & [eVar v,U2] in SigmaRed(V);
    hence thesis by ENVSIG:27;
  end;
  A2: P[eId V]
  proof
    let U1,U2 be EnvEpsTerm of V;
    assume [eId V,U1] in SigmaRed(V) & [eId V,U2] in SigmaRed(V);
    hence thesis by ENVSIG:28;
  end;
  A3: for v being Element of V, A being EnvEpsTerm of V st P[A]
    holds P[eLam(v,A)]
  proof
    let v be Element of V, A be EnvEpsTerm of V;
    assume C0: P[A];
    let U1,U2 be EnvEpsTerm of V;
    assume C1: [eLam(v,A),U1] in SigmaRed(V) &
      [eLam(v,A),U2] in SigmaRed(V);
    consider P1,Q1 being EnvEpsTerm of V, y1 being Element of V such that
    C2: [P1,Q1] in SigmaRed(V) & eLam(v,A) = eLam(y1,P1) & U1 = eLam(y1,Q1)
      by C1,ENVSIG:29;
    consider P2,Q2 being EnvEpsTerm of V, y2 being Element of V such that
    C3: [P2,Q2] in SigmaRed(V) & eLam(v,A) = eLam(y2,P2) & U2 = eLam(y2,Q2)
      by C1,ENVSIG:29;
    C4: v = y1 & A = P1 by C2,ENVSYN:11;
    C5: v = y2 & A = P2 by C3,ENVSYN:11;
    Q1,Q2 are_convergent_wrt SigmaRed(V) by C0,C2,C3,C4,C5;
    then consider T being EnvEpsTerm of V such that
    C6: SigmaRed(V) reduces Q1,T & SigmaRed(V) reduces Q2,T by ENVSIG:55;
    C7: SigmaRed(V) reduces eLam(v,Q1), eLam(v,T) by C6,ENVSIG:36;
    SigmaRed(V) reduces eLam(v,Q2), eLam(v,T) by C6,ENVSIG:36;
    hence thesis by C2,C3,C4,C5,C7,ENVSIG:52;
  end;
  A4: for A being EnvEpsTerm of V st P[A] holds P[eEps A]
  proof
    let A be EnvEpsTerm of V;
    assume C0: P[A];
    let U1,U2 be EnvEpsTerm of V;
    assume C1: [eEps A,U1] in SigmaRed(V) & [eEps A,U2] in SigmaRed(V);
    consider P1,Q1 being EnvEpsTerm of V such that
    C2: [P1,Q1] in SigmaRed(V) & eEps A = eEps P1 & U1 = eEps Q1
      by C1,ENVSIG:30;
    consider P2,Q2 being EnvEpsTerm of V such that
    C3: [P2,Q2] in SigmaRed(V) & eEps A = eEps P2 & U2 = eEps Q2
      by C1,ENVSIG:30;
    C4: A = P1 by C2,ENVSYN:12;
    C5: A = P2 by C3,ENVSYN:12;
    Q1,Q2 are_convergent_wrt SigmaRed(V) by C0,C2,C3,C4,C5;
    then consider T being EnvEpsTerm of V such that
    C6: SigmaRed(V) reduces Q1,T & SigmaRed(V) reduces Q2,T by ENVSIG:55;
    C7: SigmaRed(V) reduces eEps Q1, eEps T by C6,ENVSIG:41;
    SigmaRed(V) reduces eEps Q2, eEps T by C6,ENVSIG:41;
    hence thesis by C2,C3,C7,ENVSIG:52;
  end;
  A5: for A,B being EnvEpsTerm of V st P[A] & P[B] holds P[eApp(A,B)]
  proof
    let A,B be EnvEpsTerm of V;
    assume C0: P[A] & P[B];
    let U1,U2 be EnvEpsTerm of V;
    assume C1: [eApp(A,B),U1] in SigmaRed(V) &
      [eApp(A,B),U2] in SigmaRed(V);
    C2: ( ex P1,Q1,R1 being EnvEpsTerm of V st [P1,Q1] in SigmaRed(V) &
          eApp(A,B) = eApp(P1,R1) & U1 = eApp(Q1,R1) ) or
        ( ex P1,R1,S1 being EnvEpsTerm of V st [R1,S1] in SigmaRed(V) &
          eApp(A,B) = eApp(P1,R1) & U1 = eApp(P1,S1) ) by C1,ENVSIG:31;
    C3: ( ex P2,Q2,R2 being EnvEpsTerm of V st [P2,Q2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(Q2,R2) ) or
        ( ex P2,R2,S2 being EnvEpsTerm of V st [R2,S2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(P2,S2) ) by C1,ENVSIG:31;
    per cases by C2;
    suppose ex P1,Q1,R1 being EnvEpsTerm of V st [P1,Q1] in SigmaRed(V) &
        eApp(A,B) = eApp(P1,R1) & U1 = eApp(Q1,R1);
      then consider P1,Q1,R1 being EnvEpsTerm of V such that
      D1: [P1,Q1] in SigmaRed(V) & eApp(A,B) = eApp(P1,R1) &
        U1 = eApp(Q1,R1);
      D2: A = P1 & B = R1 by D1,ENVSYN:13;
      per cases by C3;
      suppose ex P2,Q2,R2 being EnvEpsTerm of V st [P2,Q2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(Q2,R2);
        then consider P2,Q2,R2 being EnvEpsTerm of V such that
        E1: [P2,Q2] in SigmaRed(V) & eApp(A,B) = eApp(P2,R2) &
          U2 = eApp(Q2,R2);
        E2: A = P2 & B = R2 by E1,ENVSYN:13;
        Q1,Q2 are_convergent_wrt SigmaRed(V) by C0,D1,D2,E1,E2;
        then consider T being EnvEpsTerm of V such that
        E3: SigmaRed(V) reduces Q1,T & SigmaRed(V) reduces Q2,T
          by ENVSIG:55;
        E4: SigmaRed(V) reduces eApp(Q1,B), eApp(T,B) by E3,ENVSIG:34;
        SigmaRed(V) reduces eApp(Q2,B), eApp(T,B) by E3,ENVSIG:34;
        hence thesis by D1,D2,E1,E2,E4,ENVSIG:52;
      end;
      suppose ex P2,R2,S2 being EnvEpsTerm of V st [R2,S2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(P2,S2);
        then consider P2,R2,S2 being EnvEpsTerm of V such that
        E1: [R2,S2] in SigmaRed(V) & eApp(A,B) = eApp(P2,R2) &
          U2 = eApp(P2,S2);
        E2: A = P2 & B = R2 by E1,ENVSYN:13;
        [eApp(Q1,B), eApp(Q1,S2)] in SigmaRed(V) by E1,E2,ENVSIG:19;
        then E3: SigmaRed(V) reduces U1, eApp(Q1,S2)
          by D1,D2,REWRITE1:15;
        [eApp(A,S2), eApp(Q1,S2)] in SigmaRed(V) by D1,D2,ENVSIG:18;
        then SigmaRed(V) reduces U2, eApp(Q1,S2) by E1,E2,REWRITE1:15;
        hence thesis by E3,ENVSIG:52;
      end;
    end;
    suppose ex P1,R1,S1 being EnvEpsTerm of V st [R1,S1] in SigmaRed(V) &
        eApp(A,B) = eApp(P1,R1) & U1 = eApp(P1,S1);
      then consider P1,R1,S1 being EnvEpsTerm of V such that
      D1: [R1,S1] in SigmaRed(V) & eApp(A,B) = eApp(P1,R1) &
        U1 = eApp(P1,S1);
      D2: A = P1 & B = R1 by D1,ENVSYN:13;
      per cases by C3;
      suppose ex P2,Q2,R2 being EnvEpsTerm of V st [P2,Q2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(Q2,R2);
        then consider P2,Q2,R2 being EnvEpsTerm of V such that
        E1: [P2,Q2] in SigmaRed(V) & eApp(A,B) = eApp(P2,R2) &
          U2 = eApp(Q2,R2);
        E2: A = P2 & B = R2 by E1,ENVSYN:13;
        [eApp(A,S1), eApp(Q2,S1)] in SigmaRed(V) by E1,E2,ENVSIG:18;
        then E3: SigmaRed(V) reduces U1, eApp(Q2,S1)
          by D1,D2,REWRITE1:15;
        [eApp(Q2,B), eApp(Q2,S1)] in SigmaRed(V) by D1,D2,ENVSIG:19;
        then SigmaRed(V) reduces U2, eApp(Q2,S1) by E1,E2,REWRITE1:15;
        hence thesis by E3,ENVSIG:52;
      end;
      suppose ex P2,R2,S2 being EnvEpsTerm of V st [R2,S2] in SigmaRed(V) &
          eApp(A,B) = eApp(P2,R2) & U2 = eApp(P2,S2);
        then consider P2,R2,S2 being EnvEpsTerm of V such that
        E1: [R2,S2] in SigmaRed(V) & eApp(A,B) = eApp(P2,R2) &
          U2 = eApp(P2,S2);
        E2: A = P2 & B = R2 by E1,ENVSYN:13;
        S1,S2 are_convergent_wrt SigmaRed(V) by C0,D1,D2,E1,E2;
        then consider T being EnvEpsTerm of V such that
        E3: SigmaRed(V) reduces S1,T & SigmaRed(V) reduces S2,T
          by ENVSIG:55;
        E4: SigmaRed(V) reduces eApp(A,S1), eApp(A,T) by E3,ENVSIG:35;
        SigmaRed(V) reduces eApp(A,S2), eApp(A,T) by E3,ENVSIG:35;
        hence thesis by D1,D2,E1,E2,E4,ENVSIG:52;
      end;
    end;
  end;
  A6: for A,B being EnvEpsTerm of V st P[A] & P[B] holds P[eComp(A,B)]
  proof
    let A,B be EnvEpsTerm of V;
    assume P[A] & P[B];
    hence thesis by Th10;
  end;
  A7: for A,B being EnvEpsTerm of V, v being Element of V st P[A] & P[B]
    holds P[eExt(A,v,B)]
  proof
    let A,B be EnvEpsTerm of V, v be Element of V;
    assume C0: P[A] & P[B];
    let U1,U2 be EnvEpsTerm of V;
    assume C1: [eExt(A,v,B),U1] in SigmaRed(V) &
      [eExt(A,v,B),U2] in SigmaRed(V);
    C2: ( ex P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V st
          [P1,Q1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
          U1 = eExt(Q1,y1,R1) ) or
        ( ex P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V st
          [R1,S1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
          U1 = eExt(P1,y1,S1) ) by C1,ENVSIG:33;
    C3: ( ex P2,Q2,R2 being EnvEpsTerm of V, y2 being Element of V st
          [P2,Q2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(Q2,y2,R2) ) or
        ( ex P2,R2,S2 being EnvEpsTerm of V, y2 being Element of V st
          [R2,S2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(P2,y2,S2) ) by C1,ENVSIG:33;
    per cases by C2;
    suppose ex P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V st
        [P1,Q1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
        U1 = eExt(Q1,y1,R1);
      then consider P1,Q1,R1 being EnvEpsTerm of V, y1 being Element of V
      such that
      D1: [P1,Q1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
        U1 = eExt(Q1,y1,R1);
      D2: v = y1 & A = P1 & B = R1 by D1,ENVSYN:15;
      per cases by C3;
      suppose ex P2,Q2,R2 being EnvEpsTerm of V, y2 being Element of V st
          [P2,Q2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(Q2,y2,R2);
        then consider P2,Q2,R2 being EnvEpsTerm of V,
        y2 being Element of V such that
        E1: [P2,Q2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(Q2,y2,R2);
        E2: v = y2 & A = P2 & B = R2 by E1,ENVSYN:15;
        Q1,Q2 are_convergent_wrt SigmaRed(V) by C0,D1,D2,E1,E2;
        then consider T being EnvEpsTerm of V such that
        E3: SigmaRed(V) reduces Q1,T & SigmaRed(V) reduces Q2,T
          by ENVSIG:55;
        E4: SigmaRed(V) reduces eExt(Q1,v,B), eExt(T,v,B)
          by E3,ENVSIG:37;
        SigmaRed(V) reduces eExt(Q2,v,B), eExt(T,v,B) by E3,ENVSIG:37;
        hence thesis by D1,D2,E1,E2,E4,ENVSIG:52;
      end;
      suppose ex P2,R2,S2 being EnvEpsTerm of V, y2 being Element of V st
          [R2,S2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(P2,y2,S2);
        then consider P2,R2,S2 being EnvEpsTerm of V,
        y2 being Element of V such that
        E1: [R2,S2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(P2,y2,S2);
        E2: v = y2 & A = P2 & B = R2 by E1,ENVSYN:15;
        [eExt(Q1,v,B), eExt(Q1,v,S2)] in SigmaRed(V) by E1,E2,ENVSIG:22;
        then E3: SigmaRed(V) reduces U1, eExt(Q1,v,S2)
          by D1,D2,REWRITE1:15;
        [eExt(A,v,S2), eExt(Q1,v,S2)] in SigmaRed(V) by D1,D2,ENVSIG:21;
        then SigmaRed(V) reduces U2, eExt(Q1,v,S2) by E1,E2,REWRITE1:15;
        hence thesis by E3,ENVSIG:52;
      end;
    end;
    suppose ex P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V st
        [R1,S1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
        U1 = eExt(P1,y1,S1);
      then consider P1,R1,S1 being EnvEpsTerm of V, y1 being Element of V
      such that
      D1: [R1,S1] in SigmaRed(V) & eExt(A,v,B) = eExt(P1,y1,R1) &
        U1 = eExt(P1,y1,S1);
      D2: v = y1 & A = P1 & B = R1 by D1,ENVSYN:15;
      per cases by C3;
      suppose ex P2,Q2,R2 being EnvEpsTerm of V, y2 being Element of V st
          [P2,Q2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(Q2,y2,R2);
        then consider P2,Q2,R2 being EnvEpsTerm of V,
        y2 being Element of V such that
        E1: [P2,Q2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(Q2,y2,R2);
        E2: v = y2 & A = P2 & B = R2 by E1,ENVSYN:15;
        [eExt(A,v,S1), eExt(Q2,v,S1)] in SigmaRed(V) by E1,E2,ENVSIG:21;
        then E3: SigmaRed(V) reduces U1, eExt(Q2,v,S1)
          by D1,D2,REWRITE1:15;
        [eExt(Q2,v,B), eExt(Q2,v,S1)] in SigmaRed(V) by D1,D2,ENVSIG:22;
        then SigmaRed(V) reduces U2, eExt(Q2,v,S1) by E1,E2,REWRITE1:15;
        hence thesis by E3,ENVSIG:52;
      end;
      suppose ex P2,R2,S2 being EnvEpsTerm of V, y2 being Element of V st
          [R2,S2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(P2,y2,S2);
        then consider P2,R2,S2 being EnvEpsTerm of V,
        y2 being Element of V such that
        E1: [R2,S2] in SigmaRed(V) & eExt(A,v,B) = eExt(P2,y2,R2) &
          U2 = eExt(P2,y2,S2);
        E2: v = y2 & A = P2 & B = R2 by E1,ENVSYN:15;
        S1,S2 are_convergent_wrt SigmaRed(V) by C0,D1,D2,E1,E2;
        then consider T being EnvEpsTerm of V such that
        E3: SigmaRed(V) reduces S1,T & SigmaRed(V) reduces S2,T
          by ENVSIG:55;
        E4: SigmaRed(V) reduces eExt(A,v,S1), eExt(A,v,T)
          by E3,ENVSIG:38;
        SigmaRed(V) reduces eExt(A,v,S2), eExt(A,v,T) by E3,ENVSIG:38;
        hence thesis by D1,D2,E1,E2,E4,ENVSIG:52;
      end;
    end;
  end;
  A8: for M being EnvEpsTerm of V holds P[M]
    from ENVSYN:sch 1(A1,A2,A3,A4,A5,A6,A7);
  let a,b,c be object;
  assume B1: [a,b] in SigmaRed(V) & [a,c] in SigmaRed(V);
  SigmaRed(V) c= [:TS G, TS G:];
  then [a,b] in [:TS G, TS G:] & [a,c] in [:TS G, TS G:] by B1;
  then a in TS G & b in TS G & c in TS G by ZFMISC_1:87;
  then reconsider a1 = a, b1 = b, c1 = c as EnvEpsTerm of V;
  C9: P[a1] by A8;
  C10: [a1,b1] in SigmaRed(V) & [a1,c1] in SigmaRed(V) by B1;
  b1,c1 are_convergent_wrt SigmaRed(V) by C9,C10;
  hence thesis;
end;

registration
  let V be non empty set;
  cluster SigmaRed(V) -> locally-confluent;
  coherence by Th11;
end;

theorem Th12:
  for V being non empty set holds SigmaRed(V) is confluent;
