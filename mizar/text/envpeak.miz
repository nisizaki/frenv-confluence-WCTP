    D1: x2 <> y2 & eComp(A,B) = eComp(eVar x2,eExt(M2,y2,N2)) & W1 =
      eComp(eVar x2, N2);
    D2: A = eVar x2 & B = eExt(M2,y2,N2) by D1,ENVSYN:14;
    D3: [eComp(eVar x2,eExt(M2,y2,N2)),W2] in SigmaRed(V) by B1,D2;
    thus thesis by D1,D3,Th8,D1;
  end;
  suppose ex M2,N2,L2 being EnvEpsTerm of V st eComp(A,B) =
      eComp(eApp(M2,N2),L2) & W1 = eApp(eComp(M2,L2),eComp(N2,L2));
    then consider M2,N2,L2 being EnvEpsTerm of V such that
    D1: eComp(A,B) = eComp(eApp(M2,N2),L2) & W1 =
      eApp(eComp(M2,L2),eComp(N2,L2));
    D2: A = eApp(M2,N2) & B = L2 by D1,ENVSYN:14;
    D3: [eComp(eApp(M2,N2),L2),W2] in SigmaRed(V) by B1,D2;
    thus thesis by D1,D3,Th5;
  end;
  suppose ex M2,N2 being EnvEpsTerm of V st eComp(A,B) = eComp(eEps M2,N2) &
      W1 = eEps M2;
    then consider M2,N2 being EnvEpsTerm of V such that
    D1: eComp(A,B) = eComp(eEps M2,N2) & W1 = eEps M2;
    D2: A = eEps M2 & B = N2 by D1,ENVSYN:14;
    D3: [eComp(eEps M2,N2),W2] in SigmaRed(V) by B1,D2;
