      ( ex U2 being EnvEpsTerm of V st eComp(A,B) = eComp(U2,eId V) & W2 = U2
        ) or
      ( ex K2,U2,V2 being EnvEpsTerm of V, s2 being Element of V st eComp(A,B)
        = eComp(eExt(K2,s2,U2),V2) & W2 = eExt(eComp(K2,V2),s2,eComp(U2,V2)) )
        or
      ( ex U2,V2 being EnvEpsTerm of V, s2 being Element of V st eComp(A,B) =
        eComp(eVar s2,eExt(U2,s2,V2)) & W2 = U2 ) or
      ( ex U2,V2 being EnvEpsTerm of V, s2,t2 being Element of V st s2 <> t2 &
        eComp(A,B) = eComp(eVar s2,eExt(U2,t2,V2)) & W2 = eComp(eVar s2, V2) )
        or
      ( ex U2,V2,K2 being EnvEpsTerm of V st eComp(A,B) =
        eComp(eApp(U2,V2),K2) & W2 = eApp(eComp(U2,K2),eComp(V2,K2)) ) or
      ( ex U2,V2 being EnvEpsTerm of V st eComp(A,B) = eComp(eEps U2,V2) & W2
        = eEps U2 ) or
      ( ex U2,U3,V2 being EnvEpsTerm of V st [U2,U3] in SigmaRed(V) &
        eComp(A,B) = eComp(U2,V2) & W2 = eComp(U3,V2) ) or
      ( ex U2,V2,V3 being EnvEpsTerm of V st [V2,V3] in SigmaRed(V) &
        eComp(A,B) = eComp(U2,V2) & W2 = eComp(U2,V3) )
      by B1,ENVSIG:32;
    per cases by E1;
    suppose ex U2,V2,K2 being EnvEpsTerm of V st eComp(A,B) =
        eComp(eComp(U2,V2),K2) & W2 = eComp(U2,eComp(V2,K2));
      then consider U2,V2,K2 being EnvEpsTerm of V such that
      F1: eComp(A,B) = eComp(eComp(U2,V2),K2) & W2 = eComp(U2,eComp(V2,K2));
      F2: A = eComp(U2,V2) & B = K2 by F1,ENVSYN:14;
      F3: [eComp(eComp(U2,V2),K2),W1] in SigmaRed(V) by B1,F2;
